<Page
    x:Class="InventoryPOS.Desktop.Views.CustomerFormPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid
        Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

        <ScrollViewer
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Stretch"
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Disabled">

            <StackPanel
                Padding="28"
                Spacing="22"
                HorizontalAlignment="Stretch">

                <!-- ============================================== -->
                <!-- PAGE HEADER -->
                <!-- ============================================== -->

                <Grid
                    MaxWidth="1000"
                    HorizontalAlignment="Center">

                    <StackPanel Spacing="5">

                        <TextBlock
                            Text="{Binding PageTitle}"
                            FontSize="28"
                            FontWeight="SemiBold" />

                        <TextBlock
                            Text="Manage customer contact information and credit settings."
                            FontSize="13"
                            Opacity="0.65" />

                    </StackPanel>

                </Grid>


                <!-- ============================================== -->
                <!-- ERROR -->
                <!-- ============================================== -->

                <InfoBar
                    x:Name="ErrorInfoBar"
                    MaxWidth="1000"
                    HorizontalAlignment="Stretch"
                    Severity="Error"
                    IsClosable="True"
                    IsOpen="False"
                    Message="{Binding ErrorMessage}" />


                <!-- ============================================== -->
                <!-- CUSTOMER INFORMATION -->
                <!-- ============================================== -->

                <Border
                    MaxWidth="1000"
                    HorizontalAlignment="Stretch"
                    Padding="28"
                    CornerRadius="10"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">

                    <StackPanel Spacing="24">

                        <!-- Card Header -->

                        <StackPanel Spacing="4">

                            <TextBlock
                                Text="Customer Information"
                                FontSize="19"
                                FontWeight="SemiBold" />

                            <TextBlock
                                Text="Basic identification and contact information."
                                FontSize="12"
                                Opacity="0.60" />

                        </StackPanel>


                        <!-- Main fields -->

                        <Grid
                            ColumnSpacing="24"
                            RowSpacing="20">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>


                            <!-- Customer ID -->

                            <TextBox
                                Grid.Row="0"
                                Grid.Column="0"
                                Header="Customer ID *"
                                PlaceholderText="e.g. CUS-0001"
                                Text="{Binding CustomerCode, Mode=TwoWay}"
                                HorizontalAlignment="Stretch" />


                            <!-- Customer Name -->

                            <TextBox
                                Grid.Row="0"
                                Grid.Column="1"
                                Header="Customer Name *"
                                PlaceholderText="Enter customer name"
                                Text="{Binding Name, Mode=TwoWay}"
                                HorizontalAlignment="Stretch" />


                            <!-- Phone -->

                            <TextBox
                                Grid.Row="1"
                                Grid.Column="0"
                                Header="Phone"
                                PlaceholderText="+880..."
                                Text="{Binding Phone, Mode=TwoWay}"
                                HorizontalAlignment="Stretch" />


                            <!-- Email -->

                            <TextBox
                                Grid.Row="1"
                                Grid.Column="1"
                                Header="Email"
                                PlaceholderText="customer@example.com"
                                Text="{Binding Email, Mode=TwoWay}"
                                HorizontalAlignment="Stretch" />

                        </Grid>

                    </StackPanel>

                </Border>


                <!-- ============================================== -->
                <!-- CREDIT & ACCOUNT -->
                <!-- ============================================== -->

                <Border
                    MaxWidth="1000"
                    HorizontalAlignment="Stretch"
                    Padding="28"
                    CornerRadius="10"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">

                    <StackPanel Spacing="24">

                        <StackPanel Spacing="4">

                            <TextBlock
                                Text="Credit &amp; Account"
                                FontSize="19"
                                FontWeight="SemiBold" />

                            <TextBlock
                                Text="Configure the customer's credit allowance and account status."
                                FontSize="12"
                                Opacity="0.60" />

                        </StackPanel>


                        <Grid ColumnSpacing="24">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>


                            <!-- Credit Limit -->

                            <StackPanel
                                Grid.Column="0"
                                Spacing="6">

                                <NumberBox
                                    Header="Credit Limit"
                                    Minimum="0"
                                    Value="{Binding CreditLimit, Mode=TwoWay}"
                                    SpinButtonPlacementMode="Compact"
                                    HorizontalAlignment="Stretch" />

                                <TextBlock
                                    Text="Maximum outstanding credit allowed for this customer."
                                    FontSize="11"
                                    Opacity="0.55"
                                    TextWrapping="Wrap" />

                            </StackPanel>


                            <!-- Status -->

                            <StackPanel
                                Grid.Column="1"
                                Spacing="8">

                                <TextBlock
                                    Text="Customer Status"
                                    FontSize="14" />

                                <ToggleSwitch
                                    OnContent="Active"
                                    OffContent="Inactive"
                                    IsOn="{Binding IsActive, Mode=TwoWay}" />

                                <TextBlock
                                    Text="Inactive customers will remain in history but can be excluded from new sales."
                                    FontSize="11"
                                    Opacity="0.55"
                                    TextWrapping="Wrap" />

                            </StackPanel>

                        </Grid>

                    </StackPanel>

                </Border>


                <!-- ============================================== -->
                <!-- ADDRESS -->
                <!-- ============================================== -->

                <Border
                    MaxWidth="1000"
                    HorizontalAlignment="Stretch"
                    Padding="28"
                    CornerRadius="10"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">

                    <StackPanel Spacing="20">

                        <StackPanel Spacing="4">

                            <TextBlock
                                Text="Address"
                                FontSize="19"
                                FontWeight="SemiBold" />

                            <TextBlock
                                Text="Optional billing or contact address."
                                FontSize="12"
                                Opacity="0.60" />

                        </StackPanel>

                        <TextBox
                            Header="Customer Address"
                            PlaceholderText="Enter street, area, city and other address details"
                            AcceptsReturn="True"
                            TextWrapping="Wrap"
                            MinHeight="110"
                            Text="{Binding Address, Mode=TwoWay}"
                            HorizontalAlignment="Stretch" />

                    </StackPanel>

                </Border>


                <!-- ============================================== -->
                <!-- ACTIONS -->
                <!-- ============================================== -->

                <Grid
                    MaxWidth="1000"
                    HorizontalAlignment="Stretch"
                    Margin="0,0,0,24">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel
                        Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="10">

                        <Button
                            Content="Cancel"
                            Padding="22,10"
                            MinWidth="110"
                            Click="CancelButton_Click" />

                        <Button
                            Content="{Binding SaveButtonText}"
                            Padding="22,10"
                            MinWidth="140"
                            Click="SaveButton_Click" />

                    </StackPanel>

                </Grid>

            </StackPanel>

        </ScrollViewer>


        <!-- ============================================== -->
        <!-- LOADING -->
        <!-- ============================================== -->

        <Grid
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Visibility="{Binding IsLoading}">

            <Border
                Padding="22"
                CornerRadius="10"
                BorderThickness="1"
                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">

                <StackPanel
                    Orientation="Horizontal"
                    Spacing="12">

                    <ProgressRing
                        Width="28"
                        Height="28"
                        IsActive="{Binding IsLoading}" />

                    <TextBlock
                        Text="Loading customer..."
                        VerticalAlignment="Center" />

                </StackPanel>

            </Border>

        </Grid>

    </Grid>

</Page>