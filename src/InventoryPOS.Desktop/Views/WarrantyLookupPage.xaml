<Page
    x:Class="InventoryPOS.Desktop.Views.WarrantyLookupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:InventoryPOS.Desktop.ViewModels"
    xmlns:warranty="using:InventoryPOS.Application.DTOs.Warranty">

    <ScrollViewer>
        <StackPanel Padding="28" Spacing="22"
                    MaxWidth="1400"
                    HorizontalAlignment="Stretch">

            <!-- Page heading -->
            <StackPanel Spacing="6">
                <TextBlock Text="Warranty Lookup"
                           FontSize="28"
                           FontWeight="SemiBold"/>

                <TextBlock
                    Text="Find an invoice and review the original warranty coverage for each product."
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap"/>
            </StackPanel>

            <!-- Invoice search -->

            <Border
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="20">

                <StackPanel Spacing="14">

                    <TextBlock
                        Text="Find a purchase"
                        FontSize="18"
                        FontWeight="SemiBold"/>

                    <TextBlock
                        Text="Search by invoice, customer, phone, product or SKU. Leave the search empty to browse recent invoices."
                        TextWrapping="Wrap"
                        Opacity="0.7"/>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox
                            x:Name="InvoiceBrowserSearchBox"
                            Grid.Column="0"
                            PlaceholderText="Search purchases..."
                            Text="{Binding InvoiceSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            KeyDown="InvoiceBrowserSearchBox_KeyDown"/>

                        <Button
                            Grid.Column="1"
                            Content="Search"
                            VerticalAlignment="Center"
                            Click="SearchInvoices_Click"/>
                    </Grid>

                    <InfoBar
                        IsOpen="{Binding HasError}"
                        Severity="Error"
                        Title="Invoice lookup"
                        Message="{Binding ErrorMessage}"/>

                    <ProgressRing
                        IsActive="{Binding IsLoading}"
                        Width="24"
                        Height="24"
                        HorizontalAlignment="Left"/>

                    <TextBlock
                        Text="{Binding TotalCountDisplay}"
                        Opacity="0.7"/>

                    <ListView
                        x:Name="InvoiceResultsList"
                        ItemsSource="{Binding Invoices}"
                        SelectionMode="Single"
                        SelectionChanged="InvoiceResults_SelectionChanged">

                        <ListView.ItemTemplate>
                            <DataTemplate
                                x:DataType="warranty:WarrantyInvoiceSearchDto">

                                <Grid
                                    Padding="8"
                                    ColumnSpacing="16"
                                    RowSpacing="6">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Text="{Binding InvoiceNumber}"
                                        FontWeight="SemiBold"
                                        IsTextSelectionEnabled="True"/>

                                    <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        Text="{Binding CustomerName}"
                                        TextTrimming="CharacterEllipsis"
                                        IsTextSelectionEnabled="True"/>

                                    <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="2"
                                        Text="{Binding TotalAmount}"
                                        HorizontalAlignment="Right"/>

                                    <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        Text="{Binding CustomerPhone}"
                                        Opacity="0.7"
                                        IsTextSelectionEnabled="True"/>

                                    <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Grid.ColumnSpan="2"
                                        Text="{Binding ProductSummary}"
                                        TextTrimming="CharacterEllipsis"
                                        Opacity="0.7"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <StackPanel
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="12">

                        <Button
                            Content="Previous"
                            IsEnabled="{Binding CanGoPrevious}"
                            Click="PreviousPage_Click"/>

                        <TextBlock
                            Text="{Binding PageDescription}"
                            VerticalAlignment="Center"/>

                        <Button
                            Content="Next"
                            IsEnabled="{Binding CanGoNext}"
                            Click="NextPage_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>


            <!-- Invoice information -->
            <StackPanel Spacing="16"
                        Visibility="{Binding ResultVisibility}">

                <Border
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="20">

                    <StackPanel Spacing="14">
                        <TextBlock Text="Invoice details"
                                   FontSize="18"
                                   FontWeight="SemiBold"/>

                        <Grid ColumnSpacing="24"
                              RowSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0"
                                        Grid.Column="0"
                                        Spacing="4">
                                <TextBlock Text="Invoice number"
                                           Opacity="0.65"/>
                                <TextBlock
                                    Text="{Binding ResultInvoiceNumber}"
                                    FontWeight="SemiBold"/>
                            </StackPanel>

                            <StackPanel Grid.Row="0"
                                        Grid.Column="1"
                                        Spacing="4">
                                <TextBlock Text="Sale date"
                                           Opacity="0.65"/>
                                <TextBlock Text="{Binding SaleDate}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1"
                                        Grid.Column="0"
                                        Spacing="4">
                                <TextBlock Text="Customer"
                                           Opacity="0.65"/>
                                <TextBlock Text="{Binding CustomerName}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1"
                                        Grid.Column="1"
                                        Spacing="4">
                                <TextBlock Text="Phone"
                                           Opacity="0.65"/>
                                <TextBlock Text="{Binding CustomerPhone}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Purchased products -->
                <Border
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="20">

                    <StackPanel Spacing="16">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Purchased products"
                                       FontSize="18"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding ItemCount}"
                                       Opacity="0.65"/>
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding Items}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:WarrantyLookupRowViewModel">
                                    <Border
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="0,0,0,1"
                                        Padding="0,14">

                                        <Grid ColumnSpacing="16"
                                              RowSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <StackPanel Grid.Row="0"
                                                        Grid.Column="0"
                                                        Spacing="4">
                                                <TextBlock
                                                    Text="{Binding ProductName}"
                                                    FontWeight="SemiBold"
                                                    TextWrapping="Wrap"/>
                                                <TextBlock
                                                    Text="{Binding SKU}"
                                                    Opacity="0.65"/>
                                                <TextBlock
                                                    Text="{Binding Quantity}"
                                                    Opacity="0.65"/>
                                            </StackPanel>

                                            <StackPanel Grid.Row="0"
                                                        Grid.Column="1"
                                                        Spacing="4">
                                                <TextBlock Text="Warranty"
                                                           Opacity="0.65"/>
                                                <TextBlock
                                                    Text="{Binding WarrantyPeriod}"/>
                                            </StackPanel>

                                            <StackPanel Grid.Row="0"
                                                        Grid.Column="2"
                                                        Spacing="4">
                                                <TextBlock Text="Start date"
                                                           Opacity="0.65"/>
                                                <TextBlock
                                                    Text="{Binding WarrantyStart}"/>
                                            </StackPanel>

                                            <StackPanel Grid.Row="0"
                                                        Grid.Column="3"
                                                        Spacing="4">
                                                <TextBlock Text="End date"
                                                           Opacity="0.65"/>
                                                <TextBlock
                                                    Text="{Binding WarrantyEnd}"/>
                                            </StackPanel>

                                            <Grid Grid.Row="1"
                                                Grid.ColumnSpan="4"
                                                ColumnSpacing="16">

                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0"
                                                    Spacing="4">

                                                    <TextBlock
                                                        Text="{Binding Status}"
                                                        Foreground="{Binding StatusBrush}"
                                                        FontWeight="SemiBold"/>

                                                    <TextBlock
                                                        Text="{Binding Message}"
                                                        TextWrapping="Wrap"
                                                        Opacity="0.75"/>

                                                    <TextBlock
                                                        Text="{Binding RemainingQuantityDisplay}"
                                                        FontWeight="SemiBold"
                                                        Opacity="0.8"/>
                                                </StackPanel>

                                                <Button
                                                    Grid.Column="1"
                                                    Content="Register Claim"
                                                    IsEnabled="{Binding CanRegister}"
                                                    Click="RegisterClaim_Click"
                                                    VerticalAlignment="Center"/>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
