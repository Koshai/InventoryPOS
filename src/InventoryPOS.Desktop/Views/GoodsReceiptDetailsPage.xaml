<Page
    x:Class="InventoryPOS.Desktop.Views.GoodsReceiptDetailsPage"
    x:Name="PageRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:purchasing="using:InventoryPOS.Application.DTOs.Purchasing"
    mc:Ignorable="d">

    <Grid
        Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

        <ScrollViewer
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Stretch"
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Disabled">

            <StackPanel
                Padding="24"
                Spacing="22"
                HorizontalAlignment="Stretch">

                <!-- Header -->

                <Grid ColumnSpacing="16">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel
                        Grid.Column="0"
                        Spacing="4">

                        <TextBlock
                            Text="Goods Receipt"
                            FontSize="28"
                            FontWeight="SemiBold" />

                        <TextBlock
                            Text="{Binding Receipt.ReceiptNumber}"
                            FontSize="16"
                            Opacity="0.65" />

                    </StackPanel>

                    <StackPanel
                        Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="10"
                        VerticalAlignment="Center">

                        <Button
                            Content="Back"
                            Padding="18,9"
                            Click="BackButton_Click" />

                        <Button
                            Padding="18,9"
                            Content="Return to Supplier"
                            Click="ReturnToSupplier_Click"/>
                    </StackPanel>

                </Grid>


                <!-- Error -->

                <InfoBar
                    x:Name="ErrorInfoBar"
                    Severity="Error"
                    IsClosable="True"
                    IsOpen="False"
                    Message="{Binding ErrorMessage}" />


                <!-- Summary -->

                <Grid
                    ColumnSpacing="14"
                    RowSpacing="14">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>


                    <!-- Supplier -->

                    <Border
                        Grid.Row="0"
                        Grid.Column="0"
                        Padding="18"
                        MinHeight="100"
                        CornerRadius="10"
                        BorderThickness="1"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">

                        <StackPanel
                            Spacing="6"
                            VerticalAlignment="Center">

                            <TextBlock
                                Text="Supplier"
                                FontSize="12"
                                Opacity="0.60" />

                            <TextBlock
                                Text="{Binding Receipt.SupplierName}"
                                FontSize="16"
                                FontWeight="SemiBold"
                                TextWrapping="Wrap" />

                            <TextBlock
                                Text="{Binding Receipt.SupplierCode}"
                                FontSize="12"
                                Opacity="0.65" />

                        </StackPanel>

                    </Border>


                    <!-- Location -->

                    <Border
                        Grid.Row="0"
                        Grid.Column="1"
                        Padding="18"
                        MinHeight="100"
                        CornerRadius="10"
                        BorderThickness="1"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">

                        <StackPanel
                            Spacing="6"
                            VerticalAlignment="Center">

                            <TextBlock
                                Text="Location"
                                FontSize="12"
                                Opacity="0.60" />

                            <TextBlock
                                Text="{Binding Receipt.LocationName}"
                                FontSize="16"
                                FontWeight="SemiBold"
                                TextWrapping="Wrap" />

                        </StackPanel>

                    </Border>


                    <!-- Purchase Order -->

                    <Border
                        Grid.Row="1"
                        Grid.Column="0"
                        Padding="18"
                        MinHeight="100"
                        CornerRadius="10"
                        BorderThickness="1"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">

                        <StackPanel
                            Spacing="6"
                            VerticalAlignment="Center">

                            <TextBlock
                                Text="Purchase Order"
                                FontSize="12"
                                Opacity="0.60" />

                            <TextBlock
                                Text="{Binding Receipt.PurchaseOrderNumber}"
                                FontSize="16"
                                FontWeight="SemiBold" />

                        </StackPanel>

                    </Border>


                    <!-- Receipt Date -->

                    <Border
                        Grid.Row="1"
                        Grid.Column="1"
                        Padding="18"
                        MinHeight="100"
                        CornerRadius="10"
                        BorderThickness="1"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">

                        <StackPanel
                            Spacing="6"
                            VerticalAlignment="Center">

                            <TextBlock
                                Text="Receipt Date"
                                FontSize="12"
                                Opacity="0.60" />

                            <TextBlock
                                Text="{Binding Receipt.FormattedReceiptDate}"
                                FontSize="16"
                                FontWeight="SemiBold" />

                        </StackPanel>

                    </Border>

                </Grid>


                <!-- Receipt totals -->

                <Border
                    Padding="22"
                    CornerRadius="10"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">

                    <Grid ColumnSpacing="30">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>


                        <StackPanel
                            Grid.Column="0"
                            Spacing="5">

                            <TextBlock
                                Text="Total Lines"
                                FontSize="12"
                                Opacity="0.60" />

                            <TextBlock
                                Text="{Binding Receipt.LineCount}"
                                FontSize="20"
                                FontWeight="SemiBold" />

                        </StackPanel>


                        <StackPanel
                            Grid.Column="1"
                            Spacing="5">

                            <TextBlock
                                Text="Total Quantity"
                                FontSize="12"
                                Opacity="0.60" />

                            <TextBlock
                                Text="{Binding Receipt.TotalQuantity}"
                                FontSize="20"
                                FontWeight="SemiBold" />

                        </StackPanel>


                        <StackPanel
                            Grid.Column="2"
                            Spacing="5">

                            <TextBlock
                                Text="Receipt Value"
                                FontSize="12"
                                Opacity="0.60" />

                            <TextBlock
                                Text="{Binding Receipt.FormattedTotalValue}"
                                FontSize="20"
                                FontWeight="SemiBold" />

                        </StackPanel>

                    </Grid>

                </Border>


                <!-- Received Products -->

                <Border
                    Padding="22"
                    CornerRadius="10"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">

                    <StackPanel Spacing="18">

                        <StackPanel Spacing="3">

                            <TextBlock
                                Text="Received Products"
                                FontSize="18"
                                FontWeight="SemiBold" />

                            <TextBlock
                                Text="Products, batches and expiry information recorded by this receipt"
                                FontSize="12"
                                Opacity="0.60" />

                        </StackPanel>


                        <ItemsControl
                            ItemsSource="{Binding Receipt.Lines}">

                            <ItemsControl.ItemTemplate>

                                <DataTemplate
                                    x:DataType="purchasing:GoodsReceiptLineDetailsDto">

                                    <Border
                                        Padding="16"
                                        Margin="0,0,0,12"
                                        CornerRadius="8"
                                        BorderThickness="1"
                                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}">

                                        <StackPanel Spacing="16">


                                            <!-- Product heading -->

                                            <Grid ColumnSpacing="16">

                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel
                                                    Grid.Column="0"
                                                    Spacing="4">

                                                    <TextBlock
                                                        Text="{x:Bind ProductName}"
                                                        FontSize="16"
                                                        FontWeight="SemiBold"
                                                        TextWrapping="Wrap" />

                                                    <TextBlock
                                                        Text="{x:Bind SKU}"
                                                        FontSize="12"
                                                        Opacity="0.65" />

                                                </StackPanel>

                                                <TextBlock
                                                    Grid.Column="1"
                                                    Text="{x:Bind FormattedLineTotal}"
                                                    FontSize="16"
                                                    FontWeight="SemiBold"
                                                    VerticalAlignment="Center" />

                                            </Grid>


                                            <!-- Quantity / cost / warranty -->

                                            <Grid ColumnSpacing="18">

                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>


                                                <StackPanel
                                                    Grid.Column="0"
                                                    Spacing="4">

                                                    <TextBlock
                                                        Text="Received Quantity"
                                                        FontSize="11"
                                                        Opacity="0.60" />

                                                    <TextBlock
                                                        Text="{x:Bind ReceivedQuantity}"
                                                        FontWeight="SemiBold" />

                                                </StackPanel>


                                                <StackPanel
                                                    Grid.Column="1"
                                                    Spacing="4">

                                                    <TextBlock
                                                        Text="Unit Cost"
                                                        FontSize="11"
                                                        Opacity="0.60" />

                                                    <TextBlock
                                                        Text="{x:Bind UnitCost}" />

                                                </StackPanel>


                                                <StackPanel
                                                    Grid.Column="2"
                                                    Spacing="4">

                                                    <TextBlock
                                                        Text="Warranty"
                                                        FontSize="11"
                                                        Opacity="0.60" />

                                                    <TextBlock
                                                        Text="{x:Bind WarrantyDisplay}" />

                                                </StackPanel>

                                            </Grid>


                                            <!-- Divider -->

                                            <Border
                                                Height="1"
                                                Background="{ThemeResource ControlStrokeColorDefaultBrush}" />


                                            <!-- Batch -->

                                            <Grid
                                                ColumnSpacing="18"
                                                RowSpacing="12">

                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>


                                                <!-- Batch Number -->

                                                <StackPanel
                                                    Grid.Column="0"
                                                    Spacing="4">

                                                    <TextBlock
                                                        Text="Supplier Batch #"
                                                        FontSize="11"
                                                        Opacity="0.60" />

                                                    <TextBlock
                                                        Text="{x:Bind SupplierBatchNumber}"
                                                        FontWeight="SemiBold"
                                                        TextWrapping="Wrap" />

                                                </StackPanel>


                                                <!-- Manufacture -->

                                                <StackPanel
                                                    Grid.Column="1"
                                                    Spacing="4">

                                                    <TextBlock
                                                        Text="Manufacture Date"
                                                        FontSize="11"
                                                        Opacity="0.60" />

                                                    <TextBlock
                                                        Text="{x:Bind ManufactureDateDisplay}" />

                                                </StackPanel>


                                                <!-- Expiry -->

                                                <StackPanel
                                                    Grid.Column="2"
                                                    Spacing="4">

                                                    <TextBlock
                                                        Text="Expiry Date"
                                                        FontSize="11"
                                                        Opacity="0.60" />

                                                    <TextBlock
                                                        Text="{x:Bind ExpiryDateDisplay}"
                                                        FontWeight="SemiBold" />

                                                </StackPanel>

                                            </Grid>

                                        </StackPanel>

                                    </Border>

                                </DataTemplate>

                            </ItemsControl.ItemTemplate>

                        </ItemsControl>

                    </StackPanel>

                </Border>


                <!-- Notes -->

                <Border
                    Padding="22"
                    CornerRadius="10"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">

                    <StackPanel Spacing="7">

                        <TextBlock
                            Text="Receipt Notes"
                            FontSize="18"
                            FontWeight="SemiBold" />

                        <TextBlock
                            Text="{Binding Receipt.NotesDisplay}"
                            TextWrapping="Wrap"
                            FontSize="14" />

                    </StackPanel>

                </Border>


                <Border Height="20" />

            </StackPanel>

        </ScrollViewer>


        <!-- Loading -->

        <Grid
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Visibility="{Binding IsLoading}">

            <Border
                Padding="22"
                CornerRadius="10"
                BorderThickness="1"
                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">

                <StackPanel
                    Orientation="Horizontal"
                    Spacing="12">

                    <ProgressRing
                        Width="28"
                        Height="28"
                        IsActive="{Binding IsLoading}" />

                    <TextBlock
                        Text="Loading goods receipt..."
                        VerticalAlignment="Center" />

                </StackPanel>

            </Border>

        </Grid>

    </Grid>

</Page>