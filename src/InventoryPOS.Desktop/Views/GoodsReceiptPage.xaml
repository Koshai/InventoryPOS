<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="InventoryPOS.Desktop.Views.GoodsReceiptPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid
        Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

        <ScrollViewer
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Disabled">

            <StackPanel
                Width="1050"
                Padding="28"
                Spacing="22"
                HorizontalAlignment="Stretch">

                <!-- Header -->

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Spacing="4">

                        <TextBlock
                            Text="Receive Goods"
                            FontSize="28"
                            FontWeight="SemiBold" />

                        <TextBlock
                            Text="{Binding PurchaseOrder.OrderNumber}"
                            FontSize="15"
                            Opacity="0.65" />

                    </StackPanel>

                    <Button
                        Grid.Column="1"
                        Content="Receive All Remaining"
                        Padding="18,9"
                        Click="ReceiveAllButton_Click" />

                </Grid>

                <InfoBar
                    x:Name="ErrorInfoBar"
                    Severity="Error"
                    IsClosable="True"
                    IsOpen="False"
                    Message="{Binding ErrorMessage}" />

                <!-- PO summary -->

                <Border
                    Padding="22"
                    CornerRadius="10"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">

                    <Grid ColumnSpacing="30">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel
                            Grid.Column="0"
                            Spacing="4">

                            <TextBlock
                                Text="Supplier"
                                FontSize="12"
                                Opacity="0.6" />

                            <TextBlock
                                Text="{Binding PurchaseOrder.SupplierName}"
                                FontWeight="SemiBold" />

                            <TextBlock
                                Text="{Binding PurchaseOrder.SupplierCode}"
                                FontSize="12"
                                Opacity="0.6" />

                        </StackPanel>

                        <StackPanel
                            Grid.Column="1"
                            Spacing="4">

                            <TextBlock
                                Text="Location"
                                FontSize="12"
                                Opacity="0.6" />

                            <TextBlock
                                Text="{Binding PurchaseOrder.LocationName}"
                                FontWeight="SemiBold" />

                        </StackPanel>

                        <CalendarDatePicker
                            Grid.Column="2"
                            Header="Receipt Date"
                            Date="{Binding ReceiptDate, Mode=TwoWay}"
                            HorizontalAlignment="Stretch" />

                    </Grid>

                </Border>

                <!-- Lines -->

                <Border
                    Padding="22"
                    CornerRadius="10"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">

                    <StackPanel Spacing="16">

                        <TextBlock
                            Text="Products Being Received"
                            FontSize="18"
                            FontWeight="SemiBold" />

                        <ItemsControl
                            ItemsSource="{Binding Lines}">

                            <ItemsControl.ItemTemplate>

                                <DataTemplate>

                                    <Border
                                        Padding="16"
                                        Margin="0,0,0,12"
                                        CornerRadius="8"
                                        BorderThickness="1"
                                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}">

                                        <StackPanel Spacing="14">

                                            <Grid>

                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Spacing="3">

                                                    <TextBlock
                                                        Text="{Binding ProductName}"
                                                        FontSize="16"
                                                        FontWeight="SemiBold" />

                                                    <TextBlock
                                                        Text="{Binding SKU}"
                                                        FontSize="12"
                                                        Opacity="0.65" />

                                                </StackPanel>

                                                <StackPanel
                                                    Grid.Column="1"
                                                    Orientation="Horizontal"
                                                    Spacing="18">

                                                    <StackPanel>
                                                        <TextBlock
                                                            Text="Ordered"
                                                            FontSize="11"
                                                            Opacity="0.6" />

                                                        <TextBlock
                                                            Text="{Binding OrderedQuantity}" />
                                                    </StackPanel>

                                                    <StackPanel>
                                                        <TextBlock
                                                            Text="Received"
                                                            FontSize="11"
                                                            Opacity="0.6" />

                                                        <TextBlock
                                                            Text="{Binding PreviouslyReceived}" />
                                                    </StackPanel>

                                                    <StackPanel>
                                                        <TextBlock
                                                            Text="Remaining"
                                                            FontSize="11"
                                                            Opacity="0.6" />

                                                        <TextBlock
                                                            Text="{Binding RemainingQuantity}"
                                                            FontWeight="SemiBold" />
                                                    </StackPanel>

                                                </StackPanel>

                                            </Grid>

                                            <Grid
                                                ColumnSpacing="14"
                                                RowSpacing="14">

                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="2*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <!-- Row 1 -->

                                                <NumberBox
                                                    Grid.Row="0"
                                                    Grid.Column="0"
                                                    Header="Receiving Now"
                                                    Minimum="0"
                                                    Value="{Binding ReceivingQuantity, Mode=TwoWay}"
                                                    SpinButtonPlacementMode="Compact" />

                                                <TextBox
                                                    Grid.Row="0"
                                                    Grid.Column="1"
                                                    Header="Supplier Batch #"
                                                    PlaceholderText="e.g. BATCH-2026-001"
                                                    Text="{Binding SupplierBatchNumber, Mode=TwoWay}" />

                                                <NumberBox
                                                    Grid.Row="0"
                                                    Grid.Column="2"
                                                    Header="Warranty (months)"
                                                    Minimum="0"
                                                    Value="{Binding WarrantyMonths, Mode=TwoWay}"
                                                    SpinButtonPlacementMode="Compact" />

                                                <!-- Row 2 -->

                                                <CalendarDatePicker
                                                    Grid.Row="1"
                                                    Grid.Column="0"
                                                    Grid.ColumnSpan="2"
                                                    Header="Manufacture Date"
                                                    Date="{Binding ManufactureDate, Mode=TwoWay}"
                                                    HorizontalAlignment="Stretch" />

                                                <CalendarDatePicker
                                                    Grid.Row="1"
                                                    Grid.Column="2"
                                                    Header="Expiry Date"
                                                    Date="{Binding ExpiryDate, Mode=TwoWay}"
                                                    MinDate="{Binding ManufactureDate}"
                                                    HorizontalAlignment="Stretch" />

                                            </Grid>

                                        </StackPanel>

                                    </Border>

                                </DataTemplate>

                            </ItemsControl.ItemTemplate>

                        </ItemsControl>

                    </StackPanel>

                </Border>

                <!-- Notes -->

                <Border
                    Padding="22"
                    CornerRadius="10"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">

                    <TextBox
                        Header="Receipt Notes"
                        PlaceholderText="Optional notes..."
                        AcceptsReturn="True"
                        TextWrapping="Wrap"
                        MinHeight="90"
                        Text="{Binding Notes, Mode=TwoWay}" />

                </Border>

                <!-- Footer -->

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel
                        Grid.Column="0">

                        <TextBlock
                            Text="Receiving Value"
                            FontSize="12"
                            Opacity="0.6" />

                        <TextBlock
                            Text="{Binding ReceiptTotalDisplay}"
                            FontSize="22"
                            FontWeight="SemiBold" />

                    </StackPanel>

                    <StackPanel
                        Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="10">

                        <Button
                            Content="Cancel"
                            Padding="20,10"
                            Click="CancelButton_Click" />

                        <Button
                            Content="Post Goods Receipt"
                            Padding="22,10"
                            Click="PostReceiptButton_Click" />

                    </StackPanel>

                </Grid>

            </StackPanel>

        </ScrollViewer>

        <ProgressRing
            Width="40"
            Height="40"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            IsActive="{Binding IsLoading}"
            Visibility="{Binding IsLoading}" />

    </Grid>

</Page>