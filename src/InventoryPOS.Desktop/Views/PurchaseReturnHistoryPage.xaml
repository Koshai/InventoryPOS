<Page
    x:Class="InventoryPOS.Desktop.Views.PurchaseReturnHistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:InventoryPOS.Desktop.ViewModels"
    xmlns:dto="using:InventoryPOS.Application.DTOs.Purchasing"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Padding="28">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- HEADER -->

        <Grid Grid.Row="0">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Button
        Grid.Row="0"
        Content="← Back to Purchase Orders"
        HorizontalAlignment="Left"
        Padding="12,7"
        Margin="0,0,0,14"
        Click="BackToPurchaseOrders_Click" />

            <Grid Grid.Row="1">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="4">

                    <TextBlock
                Text="Purchase Returns"
                FontSize="28"
                FontWeight="SemiBold" />

                    <TextBlock
                Text="Supplier returns and returned inventory history"
                FontSize="13"
                Opacity="0.65" />

                </StackPanel>

                <Button
            Grid.Column="1"
            Content="Refresh"
            Click="Refresh_Click"
            VerticalAlignment="Center" />

            </Grid>

        </Grid>

        <!-- SEARCH -->

        <Grid
            Grid.Row="1"
            Margin="0,22,0,0"
            ColumnSpacing="10">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBox
                x:Name="SearchBox"
                PlaceholderText="Return no., supplier or receipt..."
                Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                KeyDown="SearchBox_KeyDown" />

            <Button
                Grid.Column="1"
                Content="Search"
                Click="Search_Click" />

            <Button
                Grid.Column="2"
                Content="Clear"
                Click="Clear_Click" />
        </Grid>

        <!-- ERROR -->

        <InfoBar
            Grid.Row="2"
            Margin="0,16,0,0"
            IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
            Severity="Error"
            Title="Unable to load purchase returns"
            Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />

        <!-- CONTENT -->

        <Grid
            Grid.Row="3"
            Margin="0,20,0,0">

            <Border
                CornerRadius="8"
                BorderThickness="1"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- COLUMN HEADER -->

                    <Grid
                        Grid.Row="0"
                        Padding="16,12"
                        ColumnSpacing="12"
                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.25*" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="1.35*" />
                            <ColumnDefinition Width="1.15*" />
                            <ColumnDefinition Width="0.7*" />
                            <ColumnDefinition Width="0.8*" />
                            <ColumnDefinition Width="0.9*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Text="Return No."
                            FontWeight="SemiBold" />

                        <TextBlock
                            Grid.Column="1"
                            Text="Date"
                            FontWeight="SemiBold" />

                        <TextBlock
                            Grid.Column="2"
                            Text="Supplier"
                            FontWeight="SemiBold" />

                        <TextBlock
                            Grid.Column="3"
                            Text="Receipt"
                            FontWeight="SemiBold" />

                        <TextBlock
                            Grid.Column="4"
                            Text="Qty"
                            HorizontalAlignment="Right"
                            FontWeight="SemiBold" />

                        <TextBlock
                            Grid.Column="5"
                            Text="Status"
                            FontWeight="SemiBold" />

                        <TextBlock
                            Grid.Column="6"
                            Text="Amount"
                            HorizontalAlignment="Right"
                            FontWeight="SemiBold" />

                        <TextBlock
                            Grid.Column="7"
                            Text=""
                            Width="80" />
                    </Grid>

                    <ListView
                        Grid.Row="1"
                        ItemsSource="{x:Bind ViewModel.Returns}"
                        SelectionMode="None"
                        IsItemClickEnabled="True"
                        ItemClick="ReturnsList_ItemClick">

                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment"
                                        Value="Stretch" />
                                <Setter Property="Padding"
                                        Value="0" />
                            </Style>
                        </ListView.ItemContainerStyle>

                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="dto:PurchaseReturnHistoryDto">

                                <Grid
                                    Padding="16,13"
                                    ColumnSpacing="12">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.25*" />
                                        <ColumnDefinition Width="1*" />
                                        <ColumnDefinition Width="1.35*" />
                                        <ColumnDefinition Width="1.15*" />
                                        <ColumnDefinition Width="0.7*" />
                                        <ColumnDefinition Width="0.8*" />
                                        <ColumnDefinition Width="0.9*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock
                                        Text="{x:Bind ReturnNumber}"
                                        FontWeight="SemiBold"
                                        VerticalAlignment="Center" />

                                    <TextBlock
                                        Grid.Column="1"
                                        Text="{x:Bind FormattedReturnDate}"
                                        VerticalAlignment="Center" />

                                    <TextBlock
                                        Grid.Column="2"
                                        Text="{x:Bind SupplierName}"
                                        TextTrimming="CharacterEllipsis"
                                        VerticalAlignment="Center" />

                                    <TextBlock
                                        Grid.Column="3"
                                        Text="{x:Bind ReceiptNumber}"
                                        VerticalAlignment="Center" />

                                    <TextBlock
                                        Grid.Column="4"
                                        Text="{x:Bind FormattedQuantity}"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center" />

                                    <TextBlock
                                        Grid.Column="5"
                                        Text="{x:Bind Status}"
                                        VerticalAlignment="Center" />

                                    <TextBlock
                                        Grid.Column="6"
                                        Text="{x:Bind FormattedTotalAmount}"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center" />

                                    <TextBlock
                                        Grid.Column="7"
                                        Text="View →"
                                        Margin="18,0,4,0"
                                        VerticalAlignment="Center"
                                        FontWeight="SemiBold" />

                                </Grid>

                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                </Grid>
            </Border>

            <!-- EMPTY STATE -->

            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="6"
                Visibility="Collapsed"
                x:Name="EmptyState">

                <TextBlock
                    Text="No purchase returns found"
                    FontSize="18"
                    FontWeight="SemiBold"
                    HorizontalAlignment="Center" />

                <TextBlock
                    Text="Completed supplier returns will appear here."
                    Opacity="0.6"
                    HorizontalAlignment="Center" />
            </StackPanel>

            <ProgressRing
                IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                Width="42"
                Height="42"
                HorizontalAlignment="Center"
                VerticalAlignment="Center" />

        </Grid>
    </Grid>
</Page>