<Page
    x:Class="InventoryPOS.Desktop.Views.WarrantyClaimsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:claims="using:InventoryPOS.Application.DTOs.WarrantyClaims">

    <ScrollViewer>
        <StackPanel Padding="28"
                    Spacing="22"
                    MaxWidth="1400"
                    HorizontalAlignment="Stretch">

            <StackPanel Spacing="6">
                <TextBlock Text="Warranty Claims"
                           FontSize="28"
                           FontWeight="SemiBold"/>
                <TextBlock
                    Text="Find registered claims and review their inspection and resolution details."
                    TextWrapping="Wrap"
                    Opacity="0.7"/>
            </StackPanel>

            <Border
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="20">

                <StackPanel Spacing="14">

                    <TextBlock Text="Find a claim"
                               FontSize="18"
                               FontWeight="SemiBold"/>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox
                            x:Name="ClaimSearchBox"
                            PlaceholderText="Claim number, invoice, customer or phone..."
                            Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            KeyDown="ClaimSearchBox_KeyDown"/>

                        <Button
                            Grid.Column="1"
                            Content="Search"
                            Click="Search_Click"/>
                    </Grid>

                    <InfoBar
                        IsOpen="{Binding HasError}"
                        Severity="Error"
                        Title="Warranty claims"
                        Message="{Binding ErrorMessage}"/>

                    <ProgressRing
                        IsActive="{Binding IsLoading}"
                        Width="24"
                        Height="24"
                        HorizontalAlignment="Left"/>

                    <TextBlock
                        Text="{Binding CountDescription}"
                        Opacity="0.7"/>

                    <ListView
                        x:Name="ClaimResultsList"
                        ItemsSource="{Binding Claims}"
                        SelectionMode="Single"
                        SelectionChanged="ClaimResults_SelectionChanged">

                        <ListView.ItemTemplate>
                            <DataTemplate
                                x:DataType="claims:WarrantyClaimListItemDto">

                                <Grid Padding="8"
                                      ColumnSpacing="14"
                                      RowSpacing="6">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock
                                        Text="{Binding ClaimNumber}"
                                        FontWeight="SemiBold"
                                        IsTextSelectionEnabled="True"/>

                                    <TextBlock
                                        Grid.Column="1"
                                        Text="{Binding CustomerName}"
                                        TextTrimming="CharacterEllipsis"/>

                                    <TextBlock
                                        Grid.Column="2"
                                        Text="{Binding Status}"
                                        HorizontalAlignment="Right"/>

                                    <TextBlock
                                        Grid.Row="1"
                                        Text="{Binding InvoiceNumber}"
                                        Opacity="0.7"/>

                                    <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Text="{Binding ClaimDateDisplay}"
                                        Opacity="0.7"/>

                                    <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="2"
                                        Text="{Binding ProductCountDisplay}"
                                        HorizontalAlignment="Right"
                                        Opacity="0.7"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <StackPanel
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="12">

                        <Button
                            Content="Previous"
                            IsEnabled="{Binding CanGoPrevious}"
                            Click="PreviousPage_Click"/>

                        <TextBlock
                            Text="{Binding PageDescription}"
                            VerticalAlignment="Center"/>

                        <Button
                            Content="Next"
                            IsEnabled="{Binding CanGoNext}"
                            Click="NextPage_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Selected claim details -->
            <StackPanel
                Spacing="16"
                Visibility="{Binding DetailsVisibility}">

                <Border
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="20">

                    <StackPanel Spacing="14">

                        <Grid ColumnSpacing="12">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock
        Text="Claim details"
        FontSize="18"
        FontWeight="SemiBold"
        VerticalAlignment="Center"/>

                            <StackPanel
        Grid.Column="1"
        Orientation="Horizontal"
        Spacing="8">

                                <Button
            Content="Export PDF"
            Padding="14,8"
            Click="ExportWarrantyPdf_Click"/>

                                <Button
            Content="Print"
            Padding="14,8"
            Click="PrintWarrantyPdf_Click"/>

                            </StackPanel>

                        </Grid>

                        <Grid ColumnSpacing="24"
                              RowSpacing="16">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Spacing="4">
                                <TextBlock Text="Claim number"
                                           Opacity="0.65"/>
                                <TextBlock
                                    Text="{Binding SelectedClaimNumber}"
                                    FontWeight="SemiBold"
                                    IsTextSelectionEnabled="True"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Text="Status" Opacity="0.65"/>
                                <TextBlock
                                    Text="{Binding SelectedClaimStatus}"
                                    FontWeight="SemiBold"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Spacing="4">
                                <TextBlock Text="Original invoice"
                                           Opacity="0.65"/>
                                <TextBlock
                                    Text="{Binding SelectedInvoiceNumber}"
                                    IsTextSelectionEnabled="True"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1"
                                        Grid.Column="1"
                                        Spacing="4">
                                <TextBlock Text="Claim date"
                                           Opacity="0.65"/>
                                <TextBlock
                                    Text="{Binding SelectedClaimDate}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Spacing="4">
                                <TextBlock Text="Customer"
                                           Opacity="0.65"/>
                                <TextBlock
                                    Text="{Binding SelectedCustomerName}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2"
                                        Grid.Column="1"
                                        Spacing="4">
                                <TextBlock Text="Phone"
                                           Opacity="0.65"/>
                                <TextBlock
                                    Text="{Binding SelectedCustomerPhone}"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Customer complaint"
                                   FontWeight="SemiBold"/>

                        <TextBlock
                            Text="{Binding SelectedComplaint}"
                            TextWrapping="Wrap"/>

                        <TextBlock Text="Inspection notes"
                                   FontWeight="SemiBold"/>

                        <TextBlock
                            Text="{Binding SelectedInspectionNotes}"
                            TextWrapping="Wrap"/>

                        <TextBlock Text="Resolution notes"
                                   FontWeight="SemiBold"/>

                        <TextBlock
                            Text="{Binding SelectedResolutionNotes}"
                            TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- W6.1 - Persisted warranty lifecycle timeline -->
                <Border
    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
    BorderThickness="1"
    CornerRadius="10"
    Padding="20">

                    <StackPanel Spacing="16">

                        <!-- Header -->
                        <StackPanel Spacing="4">

                            <TextBlock
                Text="Warranty Timeline"
                FontSize="18"
                FontWeight="SemiBold"/>

                            <TextBlock
                Text="Recorded lifecycle history for this warranty claim."
                TextWrapping="Wrap"
                Opacity="0.65"/>

                        </StackPanel>

                        <!-- Existing timeline events -->
                        <ItemsControl
            ItemsSource="{Binding WarrantyTimeline}"
            Visibility="{Binding WarrantyTimelineVisibility}">

                            <ItemsControl.ItemTemplate>

                                <DataTemplate
                    x:DataType="claims:WarrantyClaimEventDto">

                                    <Grid
                        ColumnSpacing="14"
                        Padding="0,4,0,12">

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Timeline rail -->
                                        <Grid Grid.Column="0">

                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="18"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>

                                            <!-- Event marker -->
                                            <Ellipse
                                Width="12"
                                Height="12"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Fill="{ThemeResource AccentFillColorDefaultBrush}"/>

                                            <!-- Vertical continuation line -->
                                            <Border
                                Grid.Row="1"
                                Width="2"
                                MinHeight="42"
                                HorizontalAlignment="Center"
                                Background="{ThemeResource CardStrokeColorDefaultBrush}"/>

                                        </Grid>

                                        <!-- Event content -->
                                        <Border
                            Grid.Column="1"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="0,0,0,14">

                                            <StackPanel Spacing="6">

                                                <!-- Description and timestamp -->
                                                <Grid ColumnSpacing="16">

                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock
                                        Text="{Binding Description}"
                                        FontWeight="SemiBold"
                                        TextWrapping="Wrap"/>

                                                    <TextBlock
                                        Grid.Column="1"
                                        Text="{Binding CreatedAtDisplay}"
                                        Opacity="0.6"
                                        VerticalAlignment="Top"/>

                                                </Grid>

                                                <!-- Event type -->
                                                <TextBlock
                                    Text="{Binding EventType}"
                                    FontSize="12"
                                    Opacity="0.55"/>

                                                <!-- Status transition -->
                                                <TextBlock
                                    Text="{Binding StatusTransitionDisplay}"
                                    FontWeight="SemiBold"
                                    TextWrapping="Wrap"/>

                                                <!-- Event notes -->
                                                <TextBlock
                                    Text="{Binding Notes}"
                                    TextWrapping="Wrap"
                                    IsTextSelectionEnabled="True"
                                    Opacity="0.75"/>

                                            </StackPanel>

                                        </Border>

                                    </Grid>

                                </DataTemplate>

                            </ItemsControl.ItemTemplate>

                        </ItemsControl>

                        <!-- Claims created before W6.1 -->
                        <Border
            Visibility="{Binding EmptyWarrantyTimelineVisibility}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="16">

                            <StackPanel
                Orientation="Horizontal"
                Spacing="10">

                                <SymbolIcon
                    Symbol="Clock"/>

                                <StackPanel Spacing="3">

                                    <TextBlock
                        Text="No recorded timeline events"
                        FontWeight="SemiBold"/>

                                    <TextBlock
                        Text="This claim may have been created before warranty audit history was enabled."
                        TextWrapping="Wrap"
                        Opacity="0.65"/>

                                </StackPanel>

                            </StackPanel>

                        </Border>

                    </StackPanel>

                </Border>


                <!-- Inspection and decision controls -->
                <Border
    Visibility="{Binding DetailsVisibility}"
    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
    BorderThickness="1"
    CornerRadius="10"
    Padding="20">

                    <StackPanel Spacing="16">

                        <TextBlock
            Text="Inspection and decision"
            FontSize="18"
            FontWeight="SemiBold"/>

                        <TextBlock
            Text="{Binding SelectedClaimStatus}"
            FontWeight="SemiBold"/>

                        <Button
            Content="Start Inspection"
            IsEnabled="{Binding CanStartInspection}"
            Click="StartInspection_Click"
            HorizontalAlignment="Left"/>

                        <TextBox
            Header="Inspection findings"
            PlaceholderText="Record the inspection results..."
            Text="{Binding InspectionNotesInput,
                           Mode=TwoWay,
                           UpdateSourceTrigger=PropertyChanged}"
            AcceptsReturn="True"
            TextWrapping="Wrap"
            MinHeight="110"
            MaxLength="2000"
            IsEnabled="{Binding CanSaveInspection}"/>

                        <Button
            Content="Save Inspection"
            IsEnabled="{Binding CanSaveInspection}"
            Click="SaveInspection_Click"
            HorizontalAlignment="Left"/>

                        <TextBox
            Header="Decision notes"
            PlaceholderText="Optional for approval; required for rejection."
            Text="{Binding DecisionNotesInput,
                           Mode=TwoWay,
                           UpdateSourceTrigger=PropertyChanged}"
            AcceptsReturn="True"
            TextWrapping="Wrap"
            MinHeight="90"
            MaxLength="2000"
            IsEnabled="{Binding CanDecide}"/>

                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button
                Content="Approve"
                IsEnabled="{Binding CanDecide}"
                Click="ApproveClaim_Click"/>

                            <Button
                Content="Reject"
                IsEnabled="{Binding CanDecide}"
                Click="RejectClaim_Click"/>
                        </StackPanel>

                        <TextBlock
            Text="Approval or rejection requires saved inspection findings."
            TextWrapping="Wrap"
            Opacity="0.65"/>
                    </StackPanel>
                </Border>


                <!-- Post-approval processing -->
                <Border
    Visibility="{Binding DetailsVisibility}"
    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
    BorderThickness="1"
    CornerRadius="10"
    Padding="20">

                    <StackPanel Spacing="16">

                        <TextBlock
            Text="Repair and Replacement"
            FontSize="18"
            FontWeight="SemiBold"/>

                        <TextBlock
            Text="{Binding SelectedClaimStatus}"
            FontWeight="SemiBold"/>

                        <TextBlock
            Text="Choose how to process an approved warranty claim. Replacement inventory will be handled separately."
            TextWrapping="Wrap"
            Opacity="0.7"/>

                        <TextBox
            x:Name="ProcessingNotesBox"
            Header="Processing notes"
            PlaceholderText="Optional instructions for repair or replacement..."
            AcceptsReturn="True"
            TextWrapping="Wrap"
            MinHeight="90"
            MaxLength="2000"
            IsEnabled="{Binding CanStartProcessing}"/>

                        <StackPanel
            Orientation="Horizontal"
            Spacing="12">

                            <Button
                Content="Start Repair"
                IsEnabled="{Binding CanStartProcessing}"
                Click="StartRepair_Click"/>

                            <Button
                Content="Prepare Replacement"
                IsEnabled="{Binding CanStartProcessing}"
                Click="PrepareReplacement_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>



                <!-- Editable repair completion form -->
                <Border
    Visibility="{Binding RepairFormVisibility}"
    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
    BorderThickness="1"
    CornerRadius="10"
    Padding="20">

                    <StackPanel Spacing="14">
                        <TextBlock
            Text="Complete Repair"
            FontSize="18"
            FontWeight="SemiBold"/>

                        <TextBlock
            Text="Every claimed product must have technician notes before completion."
            TextWrapping="Wrap"
            Opacity="0.7"/>

                        <TextBox
            x:Name="RepairCompletionNotesBox"
            Header="Final repair notes"
            PlaceholderText="Describe the completed repairs and final checks..."
            AcceptsReturn="True"
            TextWrapping="Wrap"
            MinHeight="110"
            MaxLength="2000"
            IsEnabled="{Binding CanCompleteRepair}"/>

                        <Button
            Content="Complete Repair"
            IsEnabled="{Binding CanCompleteRepair}"
            Click="CompleteRepair_Click"
            HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>

                <!-- Read-only summary for completed repairs -->
                <Border
    Visibility="{Binding CompletedRepairVisibility}"
    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
    BorderThickness="1"
    CornerRadius="10"
    Padding="20">

                    <StackPanel Spacing="14">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <SymbolIcon Symbol="Accept"
                        Foreground="ForestGreen"/>

                            <TextBlock
                Text="Repair Completed"
                FontSize="18"
                FontWeight="SemiBold"/>
                        </StackPanel>

                        <TextBlock
            Text="Completion date"
            Opacity="0.65"/>

                        <TextBlock
            Text="{Binding RepairCompletedDate}"
            FontWeight="SemiBold"/>

                        <TextBlock
            Text="Final repair notes"
            Opacity="0.65"/>

                        <TextBlock
            Text="{Binding FinalRepairNotes}"
            TextWrapping="Wrap"
            IsTextSelectionEnabled="True"/>

                        <TextBlock
            Text="All claimed products have been marked Repaired."
            TextWrapping="Wrap"
            Opacity="0.7"/>
                    </StackPanel>
                </Border>

                <!-- Warranty replacement fulfillment -->
                <Border
                    Visibility="{Binding ReplacementFormVisibility}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="20">

                    <StackPanel Spacing="14">

                        <TextBlock
                            Text="Replacement Fulfillment"
                            FontSize="18"
                            FontWeight="SemiBold"/>

                        <TextBlock
                            Text="Issue approved replacement inventory. Stock is allocated automatically using FEFO at the claim location."
                            TextWrapping="Wrap"
                            Opacity="0.7"/>

                        <NumberBox
                            Header="Quantity to issue"
                            Value="{Binding ReplacementQuantity,
                            Mode=TwoWay}"
                            Minimum="0.001"
                            SmallChange="1"
                            SpinButtonPlacementMode="Inline"
                            IsEnabled="{Binding CanIssueReplacement}"/>

                        <TextBox
                            Header="Replacement notes"
                            PlaceholderText="Optional replacement or serial number details..."
                            Text="{Binding ReplacementNotes,
                           Mode=TwoWay,
                           UpdateSourceTrigger=PropertyChanged}"
                            AcceptsReturn="True"
                            TextWrapping="Wrap"
                            MinHeight="80"
                            MaxLength="2000"
                            IsEnabled="{Binding CanIssueReplacement}"/>

                        <TextBlock
                            Text="Choose the claimed product below to issue its replacement."
                            TextWrapping="Wrap"
                            Opacity="0.65"/>

                    </StackPanel>
                </Border>

                <!-- Read-only completed replacement history -->
                <Border
    Visibility="{Binding CompletedReplacementVisibility}"
    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
    BorderThickness="1"
    CornerRadius="10"
    Padding="20">

                    <StackPanel Spacing="14">

                        <StackPanel
            Orientation="Horizontal"
            Spacing="10">

                            <SymbolIcon
                Symbol="Accept"
                Foreground="ForestGreen"/>

                            <TextBlock
                Text="Replacement Completed"
                FontSize="18"
                FontWeight="SemiBold"/>
                        </StackPanel>

                        <TextBlock
            Text="Replacement inventory has been issued and recorded."
            TextWrapping="Wrap"
            Opacity="0.7"/>

                        <ItemsControl
            ItemsSource="{Binding ReplacementHistory}">

                            <ItemsControl.ItemTemplate>

                                <DataTemplate
                    x:DataType="claims:WarrantyReplacementHistoryDto">

                                    <Border
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="0,12">

                                        <Grid
                            ColumnSpacing="24"
                            RowSpacing="8">

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <StackPanel Spacing="3">
                                                <TextBlock
                                    Text="{Binding ProductName}"
                                    FontWeight="SemiBold"
                                    TextWrapping="Wrap"/>

                                                <TextBlock
                                    Text="{Binding SKU}"
                                    Opacity="0.65"
                                    IsTextSelectionEnabled="True"/>
                                            </StackPanel>

                                            <TextBlock
                                Grid.Column="1"
                                Text="{Binding QuantityDisplay}"
                                FontWeight="SemiBold"
                                HorizontalAlignment="Right"/>

                                            <TextBlock
                                Grid.Row="1"
                                Text="{Binding BatchDisplay}"
                                IsTextSelectionEnabled="True"/>

                                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="1"
                                Text="{Binding LocationName}"
                                HorizontalAlignment="Right"/>

                                            <TextBlock
                                Grid.Row="2"
                                Text="Issued"/>

                                            <TextBlock
                                Grid.Row="2"
                                Grid.Column="1"
                                Text="{Binding IssuedAtDisplay}"
                                HorizontalAlignment="Right"/>

                                            <TextBlock
                                Grid.Row="3"
                                Grid.ColumnSpan="2"
                                Text="{Binding Notes}"
                                TextWrapping="Wrap"
                                Opacity="0.7"/>

                                        </Grid>
                                    </Border>

                                </DataTemplate>

                            </ItemsControl.ItemTemplate>

                        </ItemsControl>

                    </StackPanel>
                </Border>


                <Border
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="20">

                    <StackPanel Spacing="14">

                        <TextBlock Text="Claimed products"
                                   FontSize="18"
                                   FontWeight="SemiBold"/>

                        <ItemsControl
                            ItemsSource="{Binding SelectedItems}">

                            <ItemsControl.ItemTemplate>
                                <DataTemplate
                                    x:DataType="claims:WarrantyClaimDetailItemDto">

                                    <Border
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="0,0,0,1"
                                        Padding="0,14">

                                        <StackPanel Spacing="7">

                                            <TextBlock
                                                Text="{Binding ProductName}"
                                                FontWeight="SemiBold"
                                                TextWrapping="Wrap"/>

                                            <TextBlock
                                                Text="{Binding SKU}"
                                                Opacity="0.7"/>

                                            <StackPanel
                                                Orientation="Horizontal"
                                                Spacing="18">

                                                <TextBlock
                                                    Text="{Binding QuantityDisplay}"/>

                                                <TextBlock
                                                    Text="{Binding ResolutionType}"/>

                                                <TextBlock
                                                    Text="{Binding WarrantyEndDisplay}"/>
                                            </StackPanel>

                                            <TextBlock
                                                Text="{Binding SerialNumber}"
                                                IsTextSelectionEnabled="True"
                                                Opacity="0.7"/>

                                            <TextBlock
                                                Text="{Binding ReportedDefect}"
                                                TextWrapping="Wrap"/>

                                            <TextBlock
                                                Text="{Binding TechnicianNotes}"
                                                TextWrapping="Wrap"
                                                Opacity="0.7"/>
                                            <Button
                                                Content="Edit Technician Notes"
                                                Tag="{Binding Id}"
                                                Click="EditTechnicianNotes_Click"
                                                HorizontalAlignment="Left"/>
                                            <Button
                                                Content="Issue Replacement"
                                                Tag="{Binding Id}"
                                                Click="IssueReplacement_Click"
                                                HorizontalAlignment="Left"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
