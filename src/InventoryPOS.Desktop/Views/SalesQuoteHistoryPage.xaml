<?xml version="1.0" encoding="utf-8"?>

<Page
    x:Class="InventoryPOS.Desktop.Views.SalesQuoteHistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:InventoryPOS.Desktop.ViewModels"
    xmlns:converters="using:InventoryPOS.Desktop.Converters">

    <Page.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Page.Resources>

    <Grid
        Padding="24"
        RowSpacing="18"
        Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ================================================= -->
        <!-- HEADER -->
        <!-- ================================================= -->

        <Grid Grid.Row="0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel
                Grid.Column="0"
                Spacing="4">

                <TextBlock
                    Text="Sales Quotations"
                    FontSize="28"
                    FontWeight="SemiBold" />

                <TextBlock
                    Text="Review customer quotations and their current status."
                    FontSize="13"
                    Opacity="0.65" />

            </StackPanel>

            <Button
                Grid.Column="1"
                Content="Refresh"
                Padding="16,8"
                VerticalAlignment="Center"
                Click="RefreshButton_Click" />

        </Grid>

        <!-- ================================================= -->
        <!-- SEARCH / ERROR -->
        <!-- ================================================= -->

        <StackPanel
            Grid.Row="1"
            Spacing="10">

            <Grid ColumnSpacing="10">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox
                    x:Name="SearchTextBox"
                    Grid.Column="0"
                    PlaceholderText="Search quote number or customer..."
                    Text="{Binding SearchText,
                                   Mode=TwoWay,
                                   UpdateSourceTrigger=PropertyChanged}"
                    KeyDown="SearchTextBox_KeyDown" />

                <Button
                    Grid.Column="1"
                    Content="Search"
                    Padding="18,8"
                    Click="SearchButton_Click" />

                <Button
                    Grid.Column="2"
                    Content="Clear"
                    Padding="18,8"
                    Click="ClearButton_Click" />

            </Grid>

            <InfoBar
                x:Name="ErrorInfoBar"
                Severity="Error"
                IsClosable="True"
                IsOpen="False"
                Message="{Binding ErrorMessage}" />

        </StackPanel>

        <!-- ================================================= -->
        <!-- QUOTES -->
        <!-- ================================================= -->

        <Border
            Grid.Row="2"
            CornerRadius="10"
            BorderThickness="1"
            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- COLUMN HEADERS -->

                <Grid
                    Grid.Row="0"
                    Padding="14,10"
                    ColumnSpacing="12"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="105" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="115" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="160" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="0"
                        Text="Quote"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Opacity="0.65" />

                    <TextBlock
                        Grid.Column="1"
                        Text="Date"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Opacity="0.65" />

                    <TextBlock
                        Grid.Column="2"
                        Text="Customer"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Opacity="0.65" />

                    <TextBlock
                        Grid.Column="3"
                        Text="Location"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Opacity="0.65" />

                    <TextBlock
                        Grid.Column="4"
                        Text="Items"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Opacity="0.65" />

                    <TextBlock
                        Grid.Column="5"
                        Text="Valid Until"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Opacity="0.65" />

                    <TextBlock
                        Grid.Column="6"
                        Text="Status"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Opacity="0.65" />

                    <TextBlock
                        Grid.Column="7"
                        Text="Total / Pricing"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Opacity="0.65"
                        HorizontalAlignment="Right" />

                </Grid>

                <!-- LIST -->

                <ListView
                    Grid.Row="1"
                    ItemsSource="{Binding Quotes}"
                    SelectedItem="{Binding SelectedQuote,
                                           Mode=TwoWay}"
                    SelectionMode="Single"
                    IsItemClickEnabled="True"
                    ItemClick="Quote_ItemClick"
                    HorizontalContentAlignment="Stretch">

                    <ListView.ItemContainerStyle>

                        <Style TargetType="ListViewItem">
                            <Setter
                                Property="HorizontalContentAlignment"
                                Value="Stretch" />
                        </Style>

                    </ListView.ItemContainerStyle>

                    <ListView.ItemTemplate>

                        <DataTemplate
                            x:DataType="vm:SalesQuoteHistoryItemViewModel">

                            <StackPanel>
                                <Grid
                                Padding="14,12"
                                ColumnSpacing="12">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="105" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="115" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="160" />
                                    </Grid.ColumnDefinitions>

                                    <!-- QUOTE -->

                                    <StackPanel
                                    Grid.Column="0"
                                    Spacing="2">

                                        <TextBlock
                                        Text="{x:Bind QuoteNumber}"
                                        FontSize="13"
                                        FontWeight="SemiBold" />

                                        <TextBlock
                                        Text="{x:Bind ConversionDisplay}"
                                        FontSize="9"
                                        Opacity="0.55" />

                                    </StackPanel>

                                    <!-- DATE -->

                                    <TextBlock
                                    Grid.Column="1"
                                    Text="{x:Bind FormattedQuoteDate}"
                                    FontSize="12"
                                    VerticalAlignment="Center" />

                                    <!-- CUSTOMER -->

                                    <TextBlock
                                    Grid.Column="2"
                                    Text="{x:Bind CustomerName}"
                                    FontSize="12"
                                    TextTrimming="CharacterEllipsis"
                                    VerticalAlignment="Center" />

                                    <!-- LOCATION -->

                                    <TextBlock
                                    Grid.Column="3"
                                    Text="{x:Bind LocationName}"
                                    FontSize="12"
                                    TextTrimming="CharacterEllipsis"
                                    VerticalAlignment="Center" />

                                    <!-- ITEMS -->

                                    <TextBlock
                                    Grid.Column="4"
                                    Text="{x:Bind ItemSummary}"
                                    FontSize="12"
                                    VerticalAlignment="Center" />

                                    <!-- VALID UNTIL -->

                                    <TextBlock
                                    Grid.Column="5"
                                    Text="{x:Bind FormattedValidUntilDate}"
                                    FontSize="12"
                                    VerticalAlignment="Center" />

                                    <!-- STATUS -->

                                    <Border
                                    Grid.Column="6"
                                    Padding="9,4"
                                    CornerRadius="12"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}">

                                        <TextBlock
                                        Text="{x:Bind StatusDisplay}"
                                        FontSize="11"
                                        FontWeight="SemiBold" />

                                    </Border>

                                    <!-- TOTAL -->

                                    <StackPanel
                                    Grid.Column="7"
                                    HorizontalAlignment="Right"
                                    Spacing="6">

                                        <TextBlock
                                        Text="{x:Bind FormattedTotal}"
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        HorizontalAlignment="Right" />

                                        <Button
                                        Content="{x:Bind PricingButtonText, Mode=OneWay}"
                                        Tag="{x:Bind}"
                                        Click="PricingButton_Click"
                                        Padding="10,4"
                                        HorizontalAlignment="Right" />
                                    </StackPanel>

                                </Grid>

                                <Border
                                    Margin="14,0,14,12"
                                    Padding="14"
                                    CornerRadius="8"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    Visibility="{x:Bind IsPricingExpanded, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel Spacing="9">
                                        <TextBlock Text="Saved pricing breakdown" FontWeight="SemiBold" FontSize="13" />
                                        <TextBlock Text="{x:Bind PricingVersionDisplay}" Opacity="0.65" FontSize="11" />
                                        <Grid ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Gross subtotal" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind FormattedSubtotal}" HorizontalAlignment="Right" />
                                        </Grid>

                                        <Grid ColumnSpacing="16" Visibility="{x:Bind HasLineDiscount, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Line discount" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind FormattedLineDiscount}" HorizontalAlignment="Right" />
                                        </Grid>

                                        <Grid ColumnSpacing="16" Visibility="{x:Bind HasOrderDiscount, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Order discount" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind FormattedOrderDiscount}" HorizontalAlignment="Right" />
                                        </Grid>

                                        <Grid ColumnSpacing="16" Visibility="{x:Bind HasOtherDiscount, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Other discount" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind FormattedOtherDiscount}" HorizontalAlignment="Right" />
                                        </Grid>

                                        <Grid ColumnSpacing="16" Visibility="{x:Bind HasTax, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="VAT / Tax" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind FormattedTax}" HorizontalAlignment="Right" />
                                        </Grid>

                                        <Grid ColumnSpacing="16" Visibility="{x:Bind HasTransport, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Transport" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind FormattedTransport}" HorizontalAlignment="Right" />
                                        </Grid>

                                        <Grid ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Grand total" FontWeight="SemiBold" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind FormattedTotal}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                        </DataTemplate>

                    </ListView.ItemTemplate>

                </ListView>

                <!-- EMPTY STATE -->

                <StackPanel
                    Grid.RowSpan="2"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="6"
                    Visibility="{Binding HasNoQuotes}">

                    <TextBlock
                        Text="No quotations found"
                        FontSize="18"
                        FontWeight="SemiBold"
                        HorizontalAlignment="Center" />

                    <TextBlock
                        Text="Create a quotation from the POS to see it here."
                        FontSize="12"
                        Opacity="0.60"
                        HorizontalAlignment="Center" />

                </StackPanel>

                <!-- LOADING -->

                <Grid
                    Grid.RowSpan="2"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    Visibility="{Binding IsLoading}">

                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="10">

                        <ProgressRing
                            Width="26"
                            Height="26"
                            IsActive="{Binding IsLoading}" />

                        <TextBlock
                            Text="Loading quotations..."
                            VerticalAlignment="Center" />

                    </StackPanel>

                </Grid>

            </Grid>

        </Border>

    </Grid>

</Page>
