<Page
    x:Class="InventoryPOS.Desktop.Views.PurchaseRequisitionHistoryPage"
    x:Name="RootPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dto="using:InventoryPOS.Application.DTOs.Purchasing"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid>

        <Grid
            Padding="28"
            MaxWidth="1400"
            HorizontalAlignment="Stretch">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->

            <Grid Grid.Row="0">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Button
                    Content="← Back to Purchase Orders"
                    HorizontalAlignment="Left"
                    Padding="12,7"
                    Margin="0,0,0,14"
                    Click="Back_Click"/>

                <Grid Grid.Row="1">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Spacing="4">

                        <TextBlock
                            Text="Purchase Requisitions"
                            FontSize="28"
                            FontWeight="SemiBold"/>

                        <TextBlock
                            Text="Prepare and manage supplier requisitions and requests for quotation."
                            FontSize="13"
                            Opacity="0.65"/>

                    </StackPanel>

                    <Button
                        Grid.Column="1"
                        Content="+ New Requisition"
                        Padding="18,10"
                        VerticalAlignment="Center"
                        Click="NewRequisition_Click"/>

                </Grid>

            </Grid>

            <!-- ERROR -->

            <InfoBar
                Grid.Row="1"
                Margin="0,18,0,0"
                IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                Severity="Error"
                Title="Unable to load requisitions"
                Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"/>

            <!-- SEARCH -->

            <Grid
                Grid.Row="2"
                Margin="0,20,0,14"
                ColumnSpacing="10">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="360"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox
                    Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    PlaceholderText="Search number, supplier or subject..."
                    KeyDown="SearchBox_KeyDown"/>

                <Button
                    Grid.Column="1"
                    Content="Search"
                    Padding="16,8"
                    Click="Search_Click"/>

                <Button
                    Grid.Column="2"
                    Content="Clear"
                    Padding="16,8"
                    Click="Clear_Click"/>

                <Button
                    Grid.Column="4"
                    Content="Refresh"
                    Padding="16,8"
                    Click="Refresh_Click"/>

            </Grid>

            <!-- TABLE -->

            <Border
                Grid.Row="3"
                CornerRadius="10"
                BorderThickness="1"
                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- TABLE HEADER -->

                    <Grid
                        Grid.Row="0"
                        Padding="16,12"
                        ColumnSpacing="12"
                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.4*"/>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="1.5*"/>
                            <ColumnDefinition Width="0.8*"/>
                            <ColumnDefinition Width="0.8*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Text="Requisition"
                            FontWeight="SemiBold"/>

                        <TextBlock
                            Grid.Column="1"
                            Text="Date"
                            FontWeight="SemiBold"/>

                        <TextBlock
                            Grid.Column="2"
                            Text="Supplier"
                            FontWeight="SemiBold"/>

                        <TextBlock
                            Grid.Column="3"
                            Text="Subject"
                            FontWeight="SemiBold"/>

                        <TextBlock
                            Grid.Column="4"
                            Text="Status"
                            FontWeight="SemiBold"/>

                        <TextBlock
                            Grid.Column="5"
                            Text="Qty"
                            HorizontalAlignment="Right"
                            FontWeight="SemiBold"/>

                        <TextBlock
                            Grid.Column="6"
                            Text="Estimated"
                            HorizontalAlignment="Right"
                            FontWeight="SemiBold"/>

                    </Grid>

                    <!-- ROWS -->

                    <ListView
                        Grid.Row="1"
                        ItemsSource="{x:Bind ViewModel.Requisitions, Mode=OneWay}"
                        IsItemClickEnabled="True"
                        ItemClick="Requisition_ItemClick"
                        SelectionMode="None">

                        <ListView.ItemContainerStyle>

                            <Style TargetType="ListViewItem">

                                <Setter
                                    Property="HorizontalContentAlignment"
                                    Value="Stretch"/>

                                <Setter
                                    Property="Padding"
                                    Value="0"/>

                            </Style>

                        </ListView.ItemContainerStyle>

                        <ListView.ItemTemplate>

                            <DataTemplate
                                x:DataType="dto:PurchaseRequisitionHistoryDto">

                                <Grid
                                    Padding="16,13"
                                    ColumnSpacing="12">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.4*"/>
                                        <ColumnDefinition Width="1.2*"/>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="1.5*"/>
                                        <ColumnDefinition Width="0.8*"/>
                                        <ColumnDefinition Width="0.8*"/>
                                        <ColumnDefinition Width="1*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock
                                        Text="{x:Bind RequisitionNumber}"
                                        FontWeight="SemiBold"
                                        VerticalAlignment="Center"/>

                                    <TextBlock
                                        Grid.Column="1"
                                        Text="{x:Bind RequisitionDateDisplay}"
                                        VerticalAlignment="Center"/>

                                    <TextBlock
                                        Grid.Column="2"
                                        Text="{x:Bind SupplierName}"
                                        TextTrimming="CharacterEllipsis"
                                        VerticalAlignment="Center"/>

                                    <TextBlock
                                        Grid.Column="3"
                                        Text="{x:Bind Subject}"
                                        TextTrimming="CharacterEllipsis"
                                        VerticalAlignment="Center"/>

                                    <TextBlock
                                        Grid.Column="4"
                                        Text="{x:Bind Status}"
                                        VerticalAlignment="Center"/>

                                    <TextBlock
                                        Grid.Column="5"
                                        Text="{x:Bind TotalRequestedQuantityDisplay}"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"/>

                                    <TextBlock
                                        Grid.Column="6"
                                        Text="{x:Bind EstimatedTotalDisplay}"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        FontWeight="SemiBold"/>

                                </Grid>

                            </DataTemplate>

                        </ListView.ItemTemplate>

                    </ListView>

                    <!-- EMPTY STATE -->

                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="8">

                        <StackPanel.Visibility>
                            <Binding
                                Path="ViewModel.HasNoResults"
                                ElementName="RootPage"/>
                        </StackPanel.Visibility>

                        <TextBlock
                            Text="No purchase requisitions found."
                            FontSize="16"
                            FontWeight="SemiBold"
                            HorizontalAlignment="Center"/>

                        <TextBlock
                            Text="Create a requisition to request goods or pricing from a supplier."
                            Opacity="0.6"/>

                    </StackPanel>

                </Grid>

            </Border>

        </Grid>

        <ProgressRing
            IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
            Width="42"
            Height="42"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"/>

    </Grid>

</Page>