<Page
    x:Class="InventoryPOS.Desktop.Views.EditProductPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

        <ScrollViewer
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Disabled">

            <Grid
                Padding="28"
                ColumnSpacing="36">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- ========================================= -->
                <!-- LEFT COLUMN - PRODUCT IMAGE -->
                <!-- ========================================= -->

                <StackPanel
                    Grid.Column="0"
                    VerticalAlignment="Top"
                    Spacing="12">

                    <TextBlock
                        Text="Product Image"
                        FontSize="16"
                        FontWeight="SemiBold" />

                    <Border
                        Width="200"
                        Height="200"
                        HorizontalAlignment="Left"
                        CornerRadius="10"
                        BorderThickness="1"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">

                        <Image
                            x:Name="ProductImagePreview"
                            Stretch="Uniform" />

                    </Border>

                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="8">

                        <Button
                            Content="Replace Image"
                            Click="ReplaceImageButton_Click" />

                        <Button
                            x:Name="RemoveImageButton"
                            Content="Remove"
                            Visibility="Collapsed"
                            Click="RemoveImageButton_Click" />

                    </StackPanel>

                    <TextBlock
                        Text="Use a clear product image for easier identification in inventory and POS."
                        Width="200"
                        FontSize="11"
                        Opacity="0.55"
                        TextWrapping="Wrap" />

                </StackPanel>

                <!-- ========================================= -->
                <!-- RIGHT COLUMN - PRODUCT FORM -->
                <!-- ========================================= -->

                <StackPanel
                    Grid.Column="1"
                    MaxWidth="900"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Top"
                    Spacing="20">

                    <!-- ===================================== -->
                    <!-- HEADER -->
                    <!-- ===================================== -->

                    <StackPanel Spacing="4">

                        <TextBlock
                            Text="Edit Product"
                            FontSize="28"
                            FontWeight="SemiBold" />

                        <TextBlock
                            Text="Update product information, pricing and inventory settings."
                            FontSize="13"
                            Opacity="0.65" />

                    </StackPanel>

                    <!-- ===================================== -->
                    <!-- ERROR -->
                    <!-- ===================================== -->

                    <InfoBar
                        x:Name="ErrorInfoBar"
                        Severity="Error"
                        IsOpen="False"
                        IsClosable="True"
                        Message="{Binding ErrorMessage}" />

                    <!-- ===================================== -->
                    <!-- PRODUCT INFORMATION CARD -->
                    <!-- ===================================== -->

                    <Border
                        Padding="20"
                        CornerRadius="10"
                        BorderThickness="1"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">

                        <StackPanel Spacing="18">

                            <!-- Section Header -->

                            <StackPanel Spacing="4">

                                <TextBlock
                                    Text="Product Information"
                                    FontSize="18"
                                    FontWeight="SemiBold" />

                                <TextBlock
                                    Text="General information used to identify and organize the product."
                                    FontSize="12"
                                    Opacity="0.60"
                                    TextWrapping="Wrap" />

                            </StackPanel>

                            <!-- Product Name -->

                            <StackPanel Spacing="6">

                                <TextBlock
                                    Text="Product name"
                                    FontWeight="SemiBold" />

                                <TextBox
                                    PlaceholderText="Enter product name"
                                    Text="{Binding Name,
                                                   Mode=TwoWay,
                                                   UpdateSourceTrigger=PropertyChanged}" />

                            </StackPanel>

                            <!-- Bangla Name -->

                            <StackPanel Spacing="6">

                                <TextBlock
                                    Text="Product name (বাংলা)"
                                    FontWeight="SemiBold" />

                                <TextBox
                                    PlaceholderText="বাংলা নাম"
                                    Text="{Binding NameBn,
                                                   Mode=TwoWay,
                                                   UpdateSourceTrigger=PropertyChanged}" />

                            </StackPanel>

                            <!-- Description -->

                            <StackPanel Spacing="6">

                                <TextBlock
                                    Text="Description"
                                    FontWeight="SemiBold" />

                                <TextBox
                                    Height="100"
                                    AcceptsReturn="True"
                                    TextWrapping="Wrap"
                                    VerticalContentAlignment="Top"
                                    PlaceholderText="Optional product description"
                                    Text="{Binding Description,
                                                   Mode=TwoWay,
                                                   UpdateSourceTrigger=PropertyChanged}" />

                            </StackPanel>

                            <!-- Category / Brand / Unit -->

                            <Grid ColumnSpacing="16">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Category -->

                                <StackPanel
                                    Grid.Column="0"
                                    Spacing="6">

                                    <TextBlock
                                        Text="Category"
                                        FontWeight="SemiBold" />

                                    <ComboBox
                                        ItemsSource="{Binding Categories}"
                                        SelectedItem="{Binding SelectedCategory,
                                                               Mode=TwoWay}"
                                        DisplayMemberPath="Name"
                                        HorizontalAlignment="Stretch" />

                                </StackPanel>

                                <!-- Brand -->

                                <StackPanel
                                    Grid.Column="1"
                                    Spacing="6">

                                    <TextBlock
                                        Text="Brand"
                                        FontWeight="SemiBold" />

                                    <ComboBox
                                        ItemsSource="{Binding Brands}"
                                        SelectedItem="{Binding SelectedBrand,
                                                               Mode=TwoWay}"
                                        DisplayMemberPath="Name"
                                        PlaceholderText="Optional"
                                        HorizontalAlignment="Stretch" />

                                </StackPanel>

                                <!-- Unit -->

                                <StackPanel
                                    Grid.Column="2"
                                    Spacing="6">

                                    <TextBlock
                                        Text="Unit"
                                        FontWeight="SemiBold" />

                                    <ComboBox
                                        ItemsSource="{Binding Units}"
                                        SelectedItem="{Binding SelectedUnit,
                                                               Mode=TwoWay}"
                                        DisplayMemberPath="Name"
                                        HorizontalAlignment="Stretch" />

                                </StackPanel>

                            </Grid>

                            <!-- Product Status -->

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel
                                    Grid.Column="0"
                                    Spacing="3">

                                    <TextBlock
                                        Text="Product Status"
                                        FontWeight="SemiBold" />

                                    <TextBlock
                                        Text="Inactive products will not be available for normal operations."
                                        FontSize="11"
                                        Opacity="0.60"
                                        TextWrapping="Wrap" />

                                </StackPanel>

                                <ToggleSwitch
                                    Grid.Column="1"
                                    IsOn="{Binding IsActive,
                                                   Mode=TwoWay}"
                                    OnContent="Active"
                                    OffContent="Inactive"
                                    VerticalAlignment="Center" />

                            </Grid>

                        </StackPanel>

                    </Border>

                    <!-- ===================================== -->
                    <!-- PRICING & INVENTORY CARD -->
                    <!-- ===================================== -->

                    <Border
                        Padding="20"
                        CornerRadius="10"
                        BorderThickness="1"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">

                        <StackPanel Spacing="20">

                            <!-- Section Header -->

                            <StackPanel Spacing="4">

                                <TextBlock
                                    Text="Pricing &amp; Inventory"
                                    FontSize="18"
                                    FontWeight="SemiBold" />

                                <TextBlock
                                    Text="Manage the primary SKU, selling price, cost and reorder threshold."
                                    FontSize="12"
                                    Opacity="0.60"
                                    TextWrapping="Wrap" />

                            </StackPanel>

                            <!-- SKU / Reorder -->

                            <Grid ColumnSpacing="18">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- SKU -->

                                <StackPanel
                                    Grid.Column="0"
                                    Spacing="6">

                                    <TextBlock
                                        Text="SKU"
                                        FontWeight="SemiBold" />

                                    <TextBox
                                        PlaceholderText="e.g. RICE-001"
                                        Text="{Binding SKU,
                                                       Mode=TwoWay,
                                                       UpdateSourceTrigger=PropertyChanged}" />

                                </StackPanel>

                                <!-- Reorder Level -->

                                <StackPanel
                                    Grid.Column="1"
                                    Spacing="6">

                                    <TextBlock
                                        Text="Reorder Level"
                                        FontWeight="SemiBold" />

                                    <NumberBox
                                        Minimum="0"
                                        SmallChange="1"
                                        SpinButtonPlacementMode="Compact"
                                        Value="{Binding ReorderLevel,
                                                        Mode=TwoWay}" />

                                </StackPanel>

                            </Grid>

                            <!-- Cost / Selling Price -->

                            <Grid ColumnSpacing="18">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Cost Price -->

                                <StackPanel
                                    Grid.Column="0"
                                    Spacing="6">

                                    <TextBlock
                                        Text="Cost Price (৳)"
                                        FontWeight="SemiBold" />

                                    <NumberBox
                                        Minimum="0"
                                        SmallChange="1"
                                        SpinButtonPlacementMode="Compact"
                                        Value="{Binding CostPrice,
                                                        Mode=TwoWay}" />

                                    <TextBlock
                                        Text="Current acquisition or purchase cost."
                                        FontSize="11"
                                        Opacity="0.55"
                                        TextWrapping="Wrap" />

                                </StackPanel>

                                <!-- Selling Price -->

                                <StackPanel
                                    Grid.Column="1"
                                    Spacing="6">

                                    <TextBlock
                                        Text="Selling Price (৳)"
                                        FontWeight="SemiBold" />

                                    <NumberBox
                                        Minimum="0.01"
                                        SmallChange="1"
                                        SpinButtonPlacementMode="Compact"
                                        Value="{Binding SellingPrice,
                                                        Mode=TwoWay}" />

                                    <TextBlock
                                        Text="Default unit price used by the POS."
                                        FontSize="11"
                                        Opacity="0.55"
                                        TextWrapping="Wrap" />

                                </StackPanel>

                            </Grid>

                            <!-- Customer Warranty -->

                            <Border
                                Padding="16"
                                CornerRadius="8"
                                BorderThickness="1"
                                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}">

                                <Grid ColumnSpacing="24">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="220" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel
                                        Grid.Column="0"
                                        Spacing="4">

                                        <TextBlock
                                            Text="Customer Warranty"
                                            FontWeight="SemiBold" />

                                        <TextBlock
                                            Text="Default warranty given to the customer when this SKU is sold. Enter 0 for no warranty."
                                            FontSize="11"
                                            Opacity="0.60"
                                            TextWrapping="Wrap" />

                                    </StackPanel>

                                    <StackPanel
                                        Grid.Column="1"
                                        Spacing="6">

                                        <TextBlock
                                            Text="Warranty (Months)"
                                            FontWeight="SemiBold" />

                                        <NumberBox
                                            Minimum="0"
                                            SmallChange="1"
                                            SpinButtonPlacementMode="Compact"
                                            Value="{Binding DefaultWarrantyMonths,
                                                            Mode=TwoWay}" />

                                    </StackPanel>

                                </Grid>

                            </Border>

                            <!-- Variant Status -->

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel
                                    Grid.Column="0"
                                    Spacing="3">

                                    <TextBlock
                                        Text="Selling Status"
                                        FontWeight="SemiBold" />

                                    <TextBlock
                                        Text="Controls whether this SKU is currently available for selling."
                                        FontSize="11"
                                        Opacity="0.60"
                                        TextWrapping="Wrap" />

                                </StackPanel>

                                <ToggleSwitch
                                    Grid.Column="1"
                                    IsOn="{Binding VariantIsActive,
                                                   Mode=TwoWay}"
                                    OnContent="Active"
                                    OffContent="Inactive"
                                    VerticalAlignment="Center" />

                            </Grid>

                        </StackPanel>

                    </Border>

                    <!-- ===================================== -->
                    <!-- ACTIONS -->
                    <!-- ===================================== -->

                    <Grid Margin="0,4,0,28">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Column="0"
                            Text="Changes apply to this product and its primary SKU."
                            FontSize="11"
                            Opacity="0.55"
                            VerticalAlignment="Center" />

                        <StackPanel
                            Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="10">

                            <Button
                                Content="Cancel"
                                Click="CancelButton_Click" />

                            <Button
                                Content="Save Changes"
                                Click="SaveButton_Click" />

                        </StackPanel>

                    </Grid>

                </StackPanel>

            </Grid>

        </ScrollViewer>

        <!-- ========================================= -->
        <!-- LOADING -->
        <!-- ========================================= -->

        <Grid
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Visibility="{Binding IsLoading}">

            <Border
                Padding="18"
                CornerRadius="10"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">

                <StackPanel
                    Orientation="Horizontal"
                    Spacing="12">

                    <ProgressRing
                        Width="32"
                        Height="32"
                        IsActive="{Binding IsLoading}" />

                    <TextBlock
                        Text="Loading product..."
                        VerticalAlignment="Center" />

                </StackPanel>

            </Border>

        </Grid>

    </Grid>

</Page>