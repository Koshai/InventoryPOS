<Page
    x:Class="InventoryPOS.Desktop.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid>
            <StackPanel Spacing="4">
                <TextBlock Text="Dashboard" FontSize="28" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding LastUpdatedText}" Opacity="0.65"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" VerticalAlignment="Center">
                <ComboBox
                    Header="Period"
                    Width="160"
                    ItemsSource="{Binding PeriodPresets}"
                    SelectedItem="{Binding SelectedPreset, Mode=TwoWay}"/>
                <ComboBox
                    Header="Location"
                    Width="220"
                    ItemsSource="{Binding Locations}"
                    SelectedItem="{Binding SelectedLocation, Mode=TwoWay}"
                    DisplayMemberPath="Name"/>
                <Button Content="Refresh" Click="Refresh_Click" VerticalAlignment="Bottom"/>
            </StackPanel>
        </Grid>

        <InfoBar
            Grid.Row="1"
            IsOpen="{Binding HasError}"
            Severity="Error"
            Title="Dashboard could not load"
            Message="{Binding ErrorMessage}"/>

        <GridView
            Grid.Row="2"
            SelectionMode="None"
            IsItemClickEnabled="False">
            <GridView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsWrapGrid MaximumRowsOrColumns="4" Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </GridView.ItemsPanel>

            <Border Padding="16" Width="220" Margin="0,0,12,12" CornerRadius="8"
                    BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="4">
                    <TextBlock Text="Gross sales" Opacity="0.65"/>
                    <TextBlock Text="{Binding GrossSalesText}" FontSize="22" FontWeight="SemiBold"/>
                </StackPanel>
            </Border>
            <Border Padding="16" Width="220" Margin="0,0,12,12" CornerRadius="8"
                    BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="4">
                    <TextBlock Text="Net sales" Opacity="0.65"/>
                    <TextBlock Text="{Binding NetSalesText}" FontSize="22" FontWeight="SemiBold"/>
                </StackPanel>
            </Border>
            <Border Padding="16" Width="220" Margin="0,0,12,12" CornerRadius="8"
                    BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="4">
                    <TextBlock Text="Discounts" Opacity="0.65"/>
                    <TextBlock Text="{Binding DiscountsText}" FontSize="22" FontWeight="SemiBold"/>
                </StackPanel>
            </Border>
            <Border Padding="16" Width="220" Margin="0,0,12,12" CornerRadius="8"
                    BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="4">
                    <TextBlock Text="Returns / refunds" Opacity="0.65"/>
                    <TextBlock Text="{Binding ReturnsText}" FontSize="22" FontWeight="SemiBold"/>
                </StackPanel>
            </Border>
            <Border Padding="16" Width="220" Margin="0,0,12,12" CornerRadius="8"
                    BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="4">
                    <TextBlock Text="Payments collected" Opacity="0.65"/>
                    <TextBlock Text="{Binding PaymentsText}" FontSize="22" FontWeight="SemiBold"/>
                </StackPanel>
            </Border>
            <Border Padding="16" Width="220" Margin="0,0,12,12" CornerRadius="8"
                    BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="4">
                    <TextBlock Text="Outstanding receivables" Opacity="0.65"/>
                    <TextBlock Text="{Binding OutstandingText}" FontSize="22" FontWeight="SemiBold"/>
                </StackPanel>
            </Border>
            <Border Padding="16" Width="220" Margin="0,0,12,12" CornerRadius="8"
                    BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="4">
                    <TextBlock Text="Transactions" Opacity="0.65"/>
                    <TextBlock Text="{Binding TransactionsText}" FontSize="22" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding AverageSaleText}" Opacity="0.65" FontSize="12"/>
                </StackPanel>
            </Border>
            <Border Padding="16" Width="220" Margin="0,0,12,12" CornerRadius="8"
                    BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="4">
                    <TextBlock Text="Gross profit" Opacity="0.65"/>
                    <TextBlock Text="{Binding ProfitText}" FontSize="14" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
            <Border Padding="16" Width="220" Margin="0,0,12,12" CornerRadius="8"
                    BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="4">
                    <TextBlock Text="Low-stock SKUs" Opacity="0.65"/>
                    <TextBlock Text="{Binding LowStockText}" FontSize="22" FontWeight="SemiBold"/>
                </StackPanel>
            </Border>
            <Border Padding="16" Width="220" Margin="0,0,12,12" CornerRadius="8"
                    BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="4">
                    <TextBlock Text="Near-expiry batches" Opacity="0.65"/>
                    <TextBlock Text="{Binding NearExpiryText}" FontSize="22" FontWeight="SemiBold"/>
                </StackPanel>
            </Border>
            <Border Padding="16" Width="220" Margin="0,0,12,12" CornerRadius="8"
                    BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="4">
                    <TextBlock Text="Pending purchasing" Opacity="0.65"/>
                    <TextBlock Text="{Binding PendingPurchasingText}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
            <Border Padding="16" Width="220" Margin="0,0,12,12" CornerRadius="8"
                    BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="4">
                    <TextBlock Text="Warranty needing action" Opacity="0.65"/>
                    <TextBlock Text="{Binding WarrantyActionText}" FontSize="22" FontWeight="SemiBold"/>
                </StackPanel>
            </Border>
        </GridView>

        <Grid Grid.Row="3" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Padding="16" CornerRadius="8" BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel>
                    <TextBlock Text="Daily sales (table)" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <ListView ItemsSource="{Binding DailySales}" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="80"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding BusinessDay}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding NetSales}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding TransactionCount}"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Padding="16" CornerRadius="8" BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel>
                    <TextBlock Text="Top products by revenue" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <ListView ItemsSource="{Binding TopProducts}" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="90"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Sku}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding ProductName}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="2" Text="{Binding QuantitySold}"/>
                                    <TextBlock Grid.Column="3" Text="{Binding Revenue}"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>
        </Grid>

        <ProgressRing
            Grid.RowSpan="4"
            Width="48"
            Height="48"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            IsActive="{Binding IsLoading}"/>
    </Grid>
</Page>
