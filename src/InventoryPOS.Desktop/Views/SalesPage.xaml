<?xml version="1.0" encoding="utf-8"?>

<Page
    x:Class="InventoryPOS.Desktop.Views.SalesPage"
    x:Name="PageRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sales="using:InventoryPOS.Application.DTOs.Sales"
    xmlns:vm="using:InventoryPOS.Desktop.ViewModels">

    <Grid
        Padding="24"
        RowSpacing="16"
        Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ================================================= -->
        <!-- PAGE HEADER -->
        <!-- ================================================= -->

        <Grid Grid.Row="0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Spacing="4">

                <TextBlock
                    Text="Sales"
                    FontSize="28"
                    FontWeight="SemiBold" />

                <TextBlock
                    Text="Review completed, partial and credit sales."
                    FontSize="13"
                    Opacity="0.65" />

            </StackPanel>

            <StackPanel
    Grid.Column="1"
    Orientation="Horizontal"
    Spacing="10"
    VerticalAlignment="Center">

                <Button
        Content="Refresh"
        Padding="16,9"
        Click="RefreshButton_Click" />

                <Button
        Content="Returns"
        Padding="16,9"
        Click="ReturnsButton_Click" />

            </StackPanel>

        </Grid>

        <!-- ================================================= -->
        <!-- ERROR -->
        <!-- ================================================= -->

        <InfoBar
            x:Name="ErrorInfoBar"
            Grid.Row="1"
            Severity="Error"
            IsClosable="True"
            IsOpen="{Binding HasError}"
            Message="{Binding ErrorMessage}" />

        <!-- ================================================= -->
        <!-- FILTERS -->
        <!-- ================================================= -->

        <Border
            Grid.Row="2"
            Padding="14"
            CornerRadius="10"
            BorderThickness="1"
            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">

            <Grid
                ColumnSpacing="10">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="190" />
                    <ColumnDefinition Width="165" />
                    <ColumnDefinition Width="165" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- SEARCH -->

                <TextBox
                    Grid.Column="0"
                    Header="Search"
                    PlaceholderText="Invoice, customer or customer code..."
                    Text="{Binding SearchText,
                                   Mode=TwoWay,
                                   UpdateSourceTrigger=PropertyChanged}"
                    TextChanged="SearchTextBox_TextChanged"
                    KeyDown="SearchTextBox_KeyDown" />

                <!-- STATUS -->

                <ComboBox
                    Grid.Column="1"
                    Header="Status"
                    ItemsSource="{Binding StatusOptions}"
                    SelectedItem="{Binding SelectedStatusOption,
                                           Mode=TwoWay}"
                    DisplayMemberPath="DisplayName"
                    HorizontalAlignment="Stretch" 
                    SelectionChanged="StatusComboBox_SelectionChanged"/>

                <!-- FROM -->

                <CalendarDatePicker
                    x:Name="FromDatePicker"
                    Grid.Column="2"
                    Header="From"
                    PlaceholderText="Select date"
                    DateFormat="{}{day.integer(2)}/{month.integer(2)}/{year.full}"
                    Date="{Binding FromDate, Mode=TwoWay}"
                    DateChanged="FilterDateChanged"
                    HorizontalAlignment="Stretch" />

                <!-- TO -->

                <CalendarDatePicker
                    x:Name="ToDatePicker"
                    Grid.Column="3"
                    Header="To"
                    PlaceholderText="Select date"
                    DateFormat="{}{day.integer(2)}/{month.integer(2)}/{year.full}"
                    Date="{Binding ToDate, Mode=TwoWay}"
                    DateChanged="FilterDateChanged"
                    HorizontalAlignment="Stretch" />

                <!-- SEARCH BUTTON -->

                <Button
                    Grid.Column="4"
                    Content="Search"
                    Padding="18,8"
                    VerticalAlignment="Bottom"
                    Click="SearchButton_Click" />

                <!-- CLEAR -->

                <Button
                    Grid.Column="5"
                    Content="Clear"
                    Padding="16,8"
                    VerticalAlignment="Bottom"
                    Click="ClearButton_Click" />

            </Grid>

        </Border>

        <!-- ================================================= -->
        <!-- SALES TABLE -->
        <!-- ================================================= -->

        <Border
            Grid.Row="3"
            CornerRadius="10"
            BorderThickness="1"
            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- TABLE HEADER -->

                <Grid
                    Grid.Row="0"
                    Padding="16,10"
                    ColumnSpacing="12"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.25*" />
                        <ColumnDefinition Width="1.25*" />
                        <ColumnDefinition Width="1.5*" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="1.15*" />
                        <ColumnDefinition Width="100" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="0"
                        Text="Invoice"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Opacity="0.70" />

                    <TextBlock
                        Grid.Column="1"
                        Text="Date / Time"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Opacity="0.70" />

                    <TextBlock
                        Grid.Column="2"
                        Text="Customer"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Opacity="0.70" />

                    <TextBlock
                        Grid.Column="3"
                        Text="Total"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Opacity="0.70" />

                    <TextBlock
                        Grid.Column="4"
                        Text="Paid"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Opacity="0.70" />

                    <TextBlock
                        Grid.Column="5"
                        Text="Due"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Opacity="0.70" />

                    <TextBlock
                        Grid.Column="6"
                        Text="Status"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Opacity="0.70" />

                    <TextBlock
                        Grid.Column="7"
                        Text="Action"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Opacity="0.70"
                        HorizontalAlignment="Center" />

                </Grid>

                <!-- TABLE BODY -->

                <ListView
                    Grid.Row="1"
                    ItemsSource="{Binding Sales}"
                    SelectionMode="None"
                    HorizontalContentAlignment="Stretch">

                    <ListView.ItemContainerStyle>

                        <Style TargetType="ListViewItem">
                            <Setter
                                Property="HorizontalContentAlignment"
                                Value="Stretch" />

                            <Setter
                                Property="Padding"
                                Value="0" />
                        </Style>

                    </ListView.ItemContainerStyle>

                    <ListView.ItemTemplate>

                        <DataTemplate
                            x:DataType="sales:SalesHistoryDto">

                            <Grid
                                Padding="16,11"
                                ColumnSpacing="12">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.25*" />
                                    <ColumnDefinition Width="1.25*" />
                                    <ColumnDefinition Width="1.5*" />
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="1.15*" />
                                    <ColumnDefinition Width="100" />
                                </Grid.ColumnDefinitions>

                                <!-- INVOICE -->

                                <TextBlock
                                    Grid.Column="0"
                                    Text="{x:Bind InvoiceNumber}"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    VerticalAlignment="Center"
                                    TextTrimming="CharacterEllipsis" />

                                <!-- DATE -->

                                <StackPanel
                                    Grid.Column="1"
                                    Spacing="1"
                                    VerticalAlignment="Center">

                                    <TextBlock
                                        Text="{x:Bind FormattedDate}"
                                        FontSize="12" />

                                    <TextBlock
                                        Text="{x:Bind FormattedTime}"
                                        FontSize="10"
                                        Opacity="0.55" />

                                </StackPanel>

                                <!-- CUSTOMER -->

                                <TextBlock
                                    Grid.Column="2"
                                    Text="{x:Bind CustomerName}"
                                    FontSize="12"
                                    VerticalAlignment="Center"
                                    TextTrimming="CharacterEllipsis" />

                                <!-- TOTAL -->

                                <TextBlock
                                    Grid.Column="3"
                                    Text="{x:Bind FormattedTotal}"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    VerticalAlignment="Center" />

                                <!-- PAID -->

                                <TextBlock
                                    Grid.Column="4"
                                    Text="{x:Bind FormattedPaid}"
                                    FontSize="12"
                                    VerticalAlignment="Center" />

                                <!-- DUE -->

                                <TextBlock
                                    Grid.Column="5"
                                    Text="{x:Bind FormattedDue}"
                                    FontSize="12"
                                    VerticalAlignment="Center" />

                                <!-- STATUS -->

                                <Border
                                    Grid.Column="6"
                                    Padding="8,4"
                                    CornerRadius="10"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center">

                                    <TextBlock
                                        Text="{x:Bind StatusDisplay}"
                                        FontSize="10"
                                        FontWeight="SemiBold" />

                                </Border>

                                <!-- VIEW -->

                                <Button
                                    Grid.Column="7"
                                    Content="View"
                                    Tag="{x:Bind}"
                                    Padding="12,5"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Click="ViewSaleButton_Click" />

                            </Grid>

                        </DataTemplate>

                    </ListView.ItemTemplate>

                </ListView>

                <!-- LOADING OVERLAY -->

                <Grid
                    Grid.RowSpan="2"
                    Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
                    Visibility="{Binding IsLoading}">

                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="10">

                        <ProgressRing
                            Width="32"
                            Height="32"
                            IsActive="{Binding IsLoading}" />

                        <TextBlock
                            Text="Loading sales..."
                            FontSize="12"
                            Opacity="0.70" />

                    </StackPanel>

                </Grid>

            </Grid>

        </Border>

        <!-- ================================================= -->
        <!-- PAGINATION -->
        <!-- ================================================= -->

        <Grid
            Grid.Row="4"
            Padding="4,0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                Grid.Column="0"
                Text="{Binding ResultDisplay}"
                FontSize="11"
                Opacity="0.65"
                VerticalAlignment="Center" />

            <StackPanel
                Grid.Column="1"
                Orientation="Horizontal"
                Spacing="8">

                <Button
                    Content="Previous"
                    Padding="14,6"
                    IsEnabled="{Binding CanGoPrevious}"
                    Click="PreviousButton_Click" />

                <Border
                    Padding="12,6"
                    CornerRadius="6"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}">

                    <TextBlock
                        Text="{Binding PageDisplay}"
                        FontSize="11"
                        VerticalAlignment="Center" />

                </Border>

                <Button
                    Content="Next"
                    Padding="14,6"
                    IsEnabled="{Binding CanGoNext}"
                    Click="NextButton_Click" />

            </StackPanel>

        </Grid>

    </Grid>

</Page>