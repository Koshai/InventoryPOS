<?xml version="1.0" encoding="utf-8"?>

<Page
    x:Class="InventoryPOS.Desktop.Views.SalesReturnPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid
        Padding="24"
        RowSpacing="16"
        Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- HEADER -->

        <Grid Grid.Row="0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel
                Grid.Column="0"
                Orientation="Horizontal"
                Spacing="12">

                <Button
                    Content="←"
                    Width="40"
                    Height="36"
                    Padding="0"
                    FontSize="18"
                    Click="BackButton_Click" />

                <StackPanel Spacing="2">

                    <TextBlock
                        Text="Sales Return"
                        FontSize="26"
                        FontWeight="SemiBold" />

                    <TextBlock
                        Text="Return items and process the customer refund."
                        FontSize="12"
                        Opacity="0.60" />

                </StackPanel>

            </StackPanel>

        </Grid>

        <!-- ERROR -->

        <InfoBar
            Grid.Row="1"
            Severity="Error"
            IsClosable="True"
            IsOpen="{Binding HasError}"
            Message="{Binding ErrorMessage}" />

        <!-- CONTENT -->

        <ScrollViewer
            Grid.Row="2"
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Disabled">

            <StackPanel
                MaxWidth="1150"
                HorizontalAlignment="Center"
                Spacing="18">

                <!-- SALE SUMMARY -->

                <Border
                    Padding="18"
                    CornerRadius="10"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">

                    <Grid ColumnSpacing="24">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.5*" />
                            <ColumnDefinition Width="1.5*" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock
                                Text="INVOICE"
                                FontSize="10"
                                Opacity="0.55" />

                            <TextBlock
                                Text="{Binding InvoiceNumber}"
                                FontSize="16"
                                FontWeight="SemiBold" />
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock
                                Text="CUSTOMER"
                                FontSize="10"
                                Opacity="0.55" />

                            <TextBlock
                                Text="{Binding CustomerName}"
                                FontSize="14"
                                FontWeight="SemiBold" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock
                                Text="SALE TOTAL"
                                FontSize="10"
                                Opacity="0.55" />

                            <TextBlock
                                Text="{Binding FormattedSaleTotal}"
                                FontWeight="SemiBold" />
                        </StackPanel>

                        <StackPanel Grid.Column="3">
                            <TextBlock
                                Text="PAID"
                                FontSize="10"
                                Opacity="0.55" />

                            <TextBlock
                                Text="{Binding FormattedPaidAmount}"
                                FontWeight="SemiBold" />
                        </StackPanel>

                        <StackPanel Grid.Column="4">
                            <TextBlock
                                Text="DUE"
                                FontSize="10"
                                Opacity="0.55" />

                            <TextBlock
                                Text="{Binding FormattedDueAmount}"
                                FontWeight="SemiBold" />
                        </StackPanel>

                    </Grid>

                </Border>

                <!-- ITEMS -->

                <Border
    CornerRadius="10"
    BorderThickness="1"
    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">

                    <StackPanel>

                        <!-- SECTION TITLE -->

                        <Grid
            Padding="16,14">

                            <TextBlock
                Text="Return Items"
                FontSize="16"
                FontWeight="SemiBold" />

                        </Grid>

                        <!-- TABLE HEADER -->

                        <Grid
            Padding="16,10"
            ColumnSpacing="12"
            Background="{ThemeResource SubtleFillColorSecondaryBrush}">

                            <Grid.ColumnDefinitions>

                                <!-- Flexible -->
                                <ColumnDefinition Width="*" />

                                <!-- Fixed columns keep header/rows aligned -->
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="80" />

                            </Grid.ColumnDefinitions>

                            <TextBlock
                Grid.Column="0"
                Text="Product"
                FontSize="11"
                FontWeight="SemiBold"
                VerticalAlignment="Center" />

                            <TextBlock
                Grid.Column="1"
                Text="SKU"
                FontSize="11"
                FontWeight="SemiBold"
                VerticalAlignment="Center" />

                            <TextBlock
                Grid.Column="2"
                Text="Sold"
                FontSize="11"
                FontWeight="SemiBold"
                HorizontalAlignment="Right"
                VerticalAlignment="Center" />

                            <TextBlock
                Grid.Column="3"
                Text="Returned"
                FontSize="11"
                FontWeight="SemiBold"
                HorizontalAlignment="Right"
                VerticalAlignment="Center" />

                            <TextBlock
                Grid.Column="4"
                Text="Available"
                FontSize="11"
                FontWeight="SemiBold"
                HorizontalAlignment="Right"
                VerticalAlignment="Center" />

                            <TextBlock
                Grid.Column="5"
                Text="Return Qty"
                FontSize="11"
                FontWeight="SemiBold"
                HorizontalAlignment="Center"
                VerticalAlignment="Center" />

                            <TextBlock
                Grid.Column="6"
                Text="Restock"
                FontSize="11"
                FontWeight="SemiBold"
                HorizontalAlignment="Center"
                VerticalAlignment="Center" />

                        </Grid>

                        <!-- TABLE ROWS -->

                        <ItemsControl
            ItemsSource="{Binding Lines}"
            HorizontalAlignment="Stretch">

                            <ItemsControl.ItemTemplate>

                                <DataTemplate>

                                    <Border
                        BorderThickness="0,1,0,0"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}">

                                        <Grid
                            MinHeight="56"
                            Padding="16,8"
                            ColumnSpacing="12">

                                            <Grid.ColumnDefinitions>

                                                <ColumnDefinition Width="*" />

                                                <ColumnDefinition Width="130" />

                                                <ColumnDefinition Width="80" />

                                                <ColumnDefinition Width="90" />

                                                <ColumnDefinition Width="90" />

                                                <ColumnDefinition Width="120" />

                                                <ColumnDefinition Width="80" />

                                            </Grid.ColumnDefinitions>

                                            <!-- PRODUCT -->

                                            <TextBlock
                                Grid.Column="0"
                                Text="{Binding ProductName}"
                                FontSize="12"
                                FontWeight="SemiBold"
                                VerticalAlignment="Center"
                                TextTrimming="CharacterEllipsis" />

                                            <!-- SKU -->

                                            <TextBlock
                                Grid.Column="1"
                                Text="{Binding SKU}"
                                FontSize="11"
                                VerticalAlignment="Center"
                                TextTrimming="CharacterEllipsis" />

                                            <!-- SOLD -->

                                            <TextBlock
                                Grid.Column="2"
                                Text="{Binding SoldQuantity}"
                                FontSize="11"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center" />

                                            <!-- ALREADY RETURNED -->

                                            <TextBlock
                                Grid.Column="3"
                                Text="{Binding ReturnedQuantity}"
                                FontSize="11"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center" />

                                            <!-- AVAILABLE TO RETURN -->

                                            <TextBlock
                                Grid.Column="4"
                                Text="{Binding ReturnableQuantity}"
                                FontSize="11"
                                FontWeight="SemiBold"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center" />

                                            <!-- RETURN QUANTITY -->

                                            <NumberBox
                                Grid.Column="5"
                                Width="100"
                                Value="{Binding ReturnQuantity, Mode=TwoWay}"
                                Minimum="0"
                                Maximum="{Binding MaximumReturnQuantity}"
                                SmallChange="1"
                                SpinButtonPlacementMode="Compact"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />

                                            <!-- RESTOCK -->

                                            <CheckBox
    Grid.Column="6"
    IsChecked="{Binding IsRestockable, Mode=TwoWay}"
    Content="Yes"
    MinWidth="60"
    HorizontalAlignment="Center"
    VerticalAlignment="Center" />

                                        </Grid>

                                    </Border>

                                </DataTemplate>

                            </ItemsControl.ItemTemplate>

                        </ItemsControl>

                    </StackPanel>

                </Border>

                <!-- RETURN DETAILS -->

                <Grid ColumnSpacing="18">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="420" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Grid.Column="0"
                        Padding="18"
                        CornerRadius="10"
                        BorderThickness="1"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">

                        <StackPanel Spacing="12">

                            <TextBlock
                                Text="Return Details"
                                FontSize="16"
                                FontWeight="SemiBold" />

                            <TextBox
                                Header="Reason"
                                Text="{Binding Reason, Mode=TwoWay}"
                                PlaceholderText="Reason for the return" />

                            <TextBox
                                Header="Notes"
                                Text="{Binding Notes, Mode=TwoWay}"
                                PlaceholderText="Optional internal notes"
                                AcceptsReturn="True"
                                TextWrapping="Wrap"
                                MinHeight="80" />

                        </StackPanel>

                    </Border>

                    <!-- FINANCIAL SUMMARY -->

                    <Border
                        Grid.Column="1"
                        Padding="18"
                        CornerRadius="10"
                        BorderThickness="1"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">

                        <StackPanel Spacing="12">

                            <TextBlock
                                Text="Return Summary"
                                FontSize="16"
                                FontWeight="SemiBold" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    Text="Return amount"
                                    Opacity="0.65" />

                                <TextBlock
                                    Grid.Column="1"
                                    Text="{Binding FormattedEstimatedReturnAmount}"
                                    FontWeight="SemiBold" />
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    Text="Applied to balance"
                                    Opacity="0.65" />

                                <TextBlock
                                    Grid.Column="1"
                                    Text="{Binding FormattedEstimatedCreditAdjustment}"
                                    FontWeight="SemiBold" />
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    Text="Refundable"
                                    Opacity="0.65" />

                                <TextBlock
                                    Grid.Column="1"
                                    Text="{Binding FormattedEstimatedRefundableAmount}"
                                    FontSize="16"
                                    FontWeight="SemiBold" />
                            </Grid>

                            <Border
                                Height="1"
                                Margin="0,3"
                                Background="{ThemeResource ControlStrokeColorDefaultBrush}" />

                            <ComboBox
                                Header="Refund method"
                                ItemsSource="{Binding RefundPaymentMethods}"
                                SelectedItem="{Binding RefundPaymentMethod, Mode=TwoWay}"
                                IsEnabled="{Binding HasRefund}"
                                HorizontalAlignment="Stretch" />

                            <TextBox
                                Header="Refund reference"
                                Text="{Binding RefundReferenceNumber, Mode=TwoWay}"
                                IsEnabled="{Binding HasRefund}"
                                PlaceholderText="Transaction/reference number" />

                            <TextBox
                                Header="Refund notes"
                                Text="{Binding RefundNotes, Mode=TwoWay}"
                                IsEnabled="{Binding HasRefund}"
                                PlaceholderText="Optional" />

                        </StackPanel>

                    </Border>

                </Grid>

            </StackPanel>

        </ScrollViewer>

        <!-- FOOTER -->

        <Border
            Grid.Row="3"
            Padding="0,14,0,0"
            BorderThickness="0,1,0,0"
            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.Column="0"
                    Text="Inventory and financial changes are committed together."
                    Opacity="0.55"
                    VerticalAlignment="Center" />

                <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="8">

                    <Button
                        Content="Cancel"
                        Padding="18,9"
                        Click="BackButton_Click" />

                    <Button
                        x:Name="CompleteReturnButton"
                        Content="Complete Return"
                        Padding="18,9"
                        Style="{StaticResource AccentButtonStyle}"
                        IsEnabled="{Binding CanSubmit}"
                        Click="CompleteReturnButton_Click" />

                </StackPanel>

            </Grid>

        </Border>

        <!-- LOADING -->

        <Grid
            Grid.RowSpan="4"
            Visibility="{Binding IsLoading}">

            <Border
                Padding="22"
                CornerRadius="10"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">

                <StackPanel
                    Orientation="Horizontal"
                    Spacing="12">

                    <ProgressRing
                        Width="28"
                        Height="28"
                        IsActive="{Binding IsLoading}" />

                    <TextBlock
                        Text="Loading return information..."
                        VerticalAlignment="Center" />

                </StackPanel>

            </Border>

        </Grid>

    </Grid>

</Page>