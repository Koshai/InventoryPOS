<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="InventoryPOS.Desktop.Views.StockAdjustmentPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

        <ScrollViewer
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Disabled">

            <StackPanel
                Padding="28"
                Width="760"
                HorizontalAlignment="Left"
                Spacing="24">

                <!-- HEADER -->

                <StackPanel Spacing="6">

                    <TextBlock
                        Text="Adjust Stock"
                        FontSize="28"
                        FontWeight="SemiBold" />

                    <TextBlock
                        Text="Correct inventory using a physical stock count."
                        Opacity="0.65" />

                </StackPanel>

                <!-- ERROR -->

                <InfoBar
                    x:Name="ErrorInfoBar"
                    Severity="Error"
                    IsClosable="True"
                    IsOpen="False"
                    Message="{Binding ErrorMessage}" />

                <!-- SUCCESS -->

                <InfoBar
                    x:Name="SuccessInfoBar"
                    Severity="Success"
                    IsClosable="True"
                    IsOpen="False"
                    Message="{Binding SuccessMessage}" />

                <!-- PRODUCT + LOCATION -->

                <Border
                    Padding="20"
                    CornerRadius="10"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">

                    <StackPanel Spacing="18">

                        <TextBlock
                            Text="Stock Selection"
                            FontSize="18"
                            FontWeight="SemiBold" />

                        <Grid ColumnSpacing="18">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>

                            <!-- PRODUCT -->

                            <StackPanel
                                Grid.Column="0"
                                Spacing="6">

                                <TextBlock
                                    Text="Product"
                                    FontWeight="SemiBold" />

                                <ComboBox
                                    ItemsSource="{Binding Products}"
                                    SelectedItem="{Binding SelectedProduct,
                                                           Mode=TwoWay}"
                                    DisplayMemberPath="DisplayName"
                                    PlaceholderText="Select product"
                                    HorizontalAlignment="Stretch" />

                            </StackPanel>

                            <!-- LOCATION -->

                            <StackPanel
                                Grid.Column="1"
                                Spacing="6">

                                <TextBlock
                                    Text="Location"
                                    FontWeight="SemiBold" />

                                <ComboBox
                                    ItemsSource="{Binding Locations}"
                                    SelectedItem="{Binding SelectedLocation,
                                                           Mode=TwoWay}"
                                    DisplayMemberPath="DisplayName"
                                    PlaceholderText="Select location"
                                    HorizontalAlignment="Stretch" />

                            </StackPanel>

                        </Grid>

                    </StackPanel>

                </Border>

                <!-- QUANTITY -->

                <Border
                    Padding="20"
                    CornerRadius="10"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">

                    <StackPanel Spacing="18">

                        <TextBlock
                            Text="Physical Count"
                            FontSize="18"
                            FontWeight="SemiBold" />

                        <Grid ColumnSpacing="20">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- SYSTEM -->

                            <StackPanel
                                Grid.Column="0"
                                Spacing="6">

                                <TextBlock
                                    Text="System Quantity"
                                    Opacity="0.65" />

                                <TextBlock
                                    Text="{Binding SystemQuantityDisplay}"
                                    FontSize="24"
                                    FontWeight="SemiBold" />

                            </StackPanel>

                            <!-- COUNTED -->

                            <StackPanel
                                Grid.Column="1"
                                Spacing="6">

                                <TextBlock
                                    Text="Counted Quantity"
                                    FontWeight="SemiBold" />

                                <NumberBox
                                    Minimum="0"
                                    SpinButtonPlacementMode="Compact"
                                    Value="{Binding CountedQuantity,
                                                    Mode=TwoWay}" />

                            </StackPanel>

                            <!-- DIFFERENCE -->

                            <StackPanel
                                Grid.Column="2"
                                Spacing="6">

                                <TextBlock
                                    Text="Difference"
                                    Opacity="0.65" />

                                <TextBlock
                                    Text="{Binding DifferenceDisplay}"
                                    FontSize="24"
                                    FontWeight="SemiBold" />

                            </StackPanel>

                        </Grid>

                    </StackPanel>

                </Border>

                <!-- REASON -->

                <Border
                    Padding="20"
                    CornerRadius="10"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">

                    <StackPanel Spacing="16">

                        <TextBlock
                            Text="Adjustment Details"
                            FontSize="18"
                            FontWeight="SemiBold" />

                        <StackPanel Spacing="6">

                            <TextBlock
                                Text="Reason"
                                FontWeight="SemiBold" />

                            <ComboBox
                                x:Name="ReasonComboBox"
                                SelectedValue="{Binding Reason,
                                                        Mode=TwoWay}"
                                SelectedValuePath="Content"
                                PlaceholderText="Select reason">

                                <ComboBoxItem
                                    Content="Physical count correction" />

                                <ComboBoxItem
                                    Content="Damaged stock" />

                                <ComboBoxItem
                                    Content="Expired stock" />

                                <ComboBoxItem
                                    Content="Lost or missing stock" />

                                <ComboBoxItem
                                    Content="Data entry correction" />

                                <ComboBoxItem
                                    Content="Other" />

                            </ComboBox>

                        </StackPanel>

                        <StackPanel Spacing="6">

                            <TextBlock
                                Text="Notes"
                                FontWeight="SemiBold" />

                            <TextBox
                                Height="90"
                                AcceptsReturn="True"
                                TextWrapping="Wrap"
                                VerticalContentAlignment="Top"
                                PlaceholderText="Optional details about this adjustment"
                                Text="{Binding Notes,
                                               Mode=TwoWay,
                                               UpdateSourceTrigger=PropertyChanged}" />

                        </StackPanel>

                    </StackPanel>

                </Border>

                <!-- ACTIONS -->

                <StackPanel
                    Orientation="Horizontal"
                    Spacing="10"
                    Margin="0,0,0,24">

                    <Button
                        Content="Save Adjustment"
                        Click="SaveButton_Click" />

                    <Button
                        Content="Cancel"
                        Click="CancelButton_Click" />

                </StackPanel>

            </StackPanel>

        </ScrollViewer>

        <ProgressRing
            Width="40"
            Height="40"
            IsActive="{Binding IsLoading}"
            Visibility="{Binding IsLoading}"
            HorizontalAlignment="Center"
            VerticalAlignment="Center" />

    </Grid>

</Page>