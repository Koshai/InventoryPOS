<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="InventoryPOS.Desktop.Views.StockAdjustmentDetailsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid
        Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

        <ScrollViewer
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Disabled">

            <StackPanel
                Padding="28"
                Spacing="20">

                <!-- HEADER -->

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel
                        Grid.Column="0"
                        Spacing="4">

                        <TextBlock
                            Text="Stock Adjustment"
                            FontSize="28"
                            FontWeight="SemiBold" />

                        <TextBlock
                            Text="Review the original physical-count correction."
                            Opacity="0.65" />

                    </StackPanel>

                    <Button
                        Grid.Column="1"
                        Content="Back"
                        Padding="16,9"
                        VerticalAlignment="Center"
                        Click="BackButton_Click" />

                </Grid>

                <!-- ERROR -->

                <InfoBar
                    x:Name="ErrorInfoBar"
                    Severity="Error"
                    IsClosable="True"
                    IsOpen="False"
                    Message="{Binding ErrorMessage}" />

                <!-- DOCUMENT DETAILS -->

                <Border
                    Padding="20"
                    CornerRadius="10"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">

                    <StackPanel Spacing="18">

                        <TextBlock
                            Text="Adjustment Information"
                            FontSize="18"
                            FontWeight="SemiBold" />

                        <Grid
                            ColumnSpacing="28"
                            RowSpacing="18">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- DATE -->

                            <StackPanel
                                Grid.Row="0"
                                Grid.Column="0"
                                Spacing="4">

                                <TextBlock
                                    Text="Date"
                                    Opacity="0.6" />

                                <TextBlock
                                    Text="{Binding Adjustment.FormattedDate}"
                                    FontWeight="SemiBold" />

                            </StackPanel>

                            <!-- STATUS -->

                            <StackPanel
                                Grid.Row="0"
                                Grid.Column="1"
                                Spacing="4">

                                <TextBlock
                                    Text="Status"
                                    Opacity="0.6" />

                                <TextBlock
                                    Text="{Binding Adjustment.Status}"
                                    FontWeight="SemiBold" />

                            </StackPanel>

                            <!-- LOCATION -->

                            <StackPanel
                                Grid.Row="0"
                                Grid.Column="2"
                                Spacing="4">

                                <TextBlock
                                    Text="Location"
                                    Opacity="0.6" />

                                <TextBlock
                                    Text="{Binding Adjustment.LocationName}"
                                    FontWeight="SemiBold" />

                            </StackPanel>

                            <!-- REASON -->

                            <StackPanel
                                Grid.Row="1"
                                Grid.Column="0"
                                Grid.ColumnSpan="2"
                                Spacing="4">

                                <TextBlock
                                    Text="Reason"
                                    Opacity="0.6" />

                                <TextBlock
                                    Text="{Binding Adjustment.Reason}"
                                    FontWeight="SemiBold"
                                    TextWrapping="Wrap" />

                            </StackPanel>

                            <!-- ADJUSTMENT ID -->

                            <StackPanel
                                Grid.Row="1"
                                Grid.Column="2"
                                Spacing="4">

                                <TextBlock
                                    Text="Adjustment ID"
                                    Opacity="0.6" />

                                <TextBlock
                                    Text="{Binding Adjustment.Id}"
                                    FontSize="12"
                                    TextWrapping="Wrap" />

                            </StackPanel>

                        </Grid>

                        <StackPanel Spacing="4">

                            <TextBlock
                                Text="Notes"
                                Opacity="0.6" />

                            <TextBlock
                                Text="{Binding Adjustment.Notes}"
                                TextWrapping="Wrap" />

                        </StackPanel>

                    </StackPanel>

                </Border>

                <!-- LINES -->

                <Border
                    CornerRadius="10"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">

                    <Grid>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock
                            Grid.Row="0"
                            Text="Adjustment Lines"
                            FontSize="18"
                            FontWeight="SemiBold"
                            Margin="20,20,20,14" />

                        <!-- HEADERS -->

                        <Grid
                            Grid.Row="1"
                            Padding="20,12"
                            ColumnSpacing="16">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                Grid.Column="0"
                                Text="Product"
                                FontWeight="SemiBold" />

                            <TextBlock
                                Grid.Column="1"
                                Text="SKU"
                                FontWeight="SemiBold" />

                            <TextBlock
                                Grid.Column="2"
                                Text="System"
                                FontWeight="SemiBold" />

                            <TextBlock
                                Grid.Column="3"
                                Text="Counted"
                                FontWeight="SemiBold" />

                            <TextBlock
                                Grid.Column="4"
                                Text="Difference"
                                FontWeight="SemiBold" />

                            <TextBlock
                                Grid.Column="5"
                                Text="Unit"
                                FontWeight="SemiBold" />

                        </Grid>

                        <!-- ROWS -->

                        <ListView
                            Grid.Row="2"
                            ItemsSource="{Binding Adjustment.Lines}"
                            SelectionMode="None"
                            HorizontalContentAlignment="Stretch">

                            <ListView.ItemTemplate>

                                <DataTemplate>

                                    <Grid
                                        Padding="20,12"
                                        ColumnSpacing="16">

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="1.2*" />
                                            <ColumnDefinition Width="1*" />
                                            <ColumnDefinition Width="1*" />
                                            <ColumnDefinition Width="1*" />
                                            <ColumnDefinition Width="1*" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock
                                            Grid.Column="0"
                                            Text="{Binding ProductName}"
                                            FontWeight="SemiBold"
                                            TextTrimming="CharacterEllipsis" />

                                        <TextBlock
                                            Grid.Column="1"
                                            Text="{Binding SKU}" />

                                        <TextBlock
                                            Grid.Column="2"
                                            Text="{Binding SystemQuantityDisplay}" />

                                        <TextBlock
                                            Grid.Column="3"
                                            Text="{Binding CountedQuantityDisplay}" />

                                        <TextBlock
                                            Grid.Column="4"
                                            Text="{Binding DifferenceDisplay}"
                                            FontWeight="SemiBold" />

                                        <TextBlock
                                            Grid.Column="5"
                                            Text="{Binding UnitSymbol}" />

                                    </Grid>

                                </DataTemplate>

                            </ListView.ItemTemplate>

                        </ListView>

                    </Grid>

                </Border>

            </StackPanel>

        </ScrollViewer>

        <ProgressRing
            Width="40"
            Height="40"
            IsActive="{Binding IsLoading}"
            Visibility="{Binding IsLoading}"
            HorizontalAlignment="Center"
            VerticalAlignment="Center" />

    </Grid>

</Page>