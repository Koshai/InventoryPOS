<Page
    x:Class="InventoryPOS.Desktop.Views.LicenseActivationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel
            MaxWidth="720"
            HorizontalAlignment="Left"
            Margin="28"
            Spacing="16">

            <TextBlock
                Text="Licensing"
                FontSize="26"
                FontWeight="SemiBold"/>

            <TextBlock
                TextWrapping="Wrap"
                Text="Send your email address and Installation ID to your vendor. They will email you a .iposlic license file to import below."/>

            <TextBlock
                Text="Installation ID"
                FontWeight="SemiBold"/>

            <TextBox
                x:Name="InstallationIdBox"
                IsReadOnly="True"
                FontSize="16"
                PlaceholderText="Loading installation ID..."/>

            <Button
                Content="Copy Installation ID"
                Click="CopyInstallationId_Click"/>

            <TextBlock
                Text="License status"
                FontWeight="SemiBold"/>

            <InfoBar
                x:Name="LicenseInfoBar"
                IsOpen="True"
                Severity="Informational"
                Title="Checking license..."/>

            <TextBlock
                x:Name="LicenseDetailsText"
                TextWrapping="Wrap"/>

            <Button
                x:Name="ActivateButton"
                Content="Import license file (.iposlic)"
                Style="{StaticResource AccentButtonStyle}"
                Click="ActivateButton_Click"/>

        </StackPanel>
    </ScrollViewer>
</Page>
