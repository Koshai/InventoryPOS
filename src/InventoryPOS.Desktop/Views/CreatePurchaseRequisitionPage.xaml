<Page
    x:Class="InventoryPOS.Desktop.Views.CreatePurchaseRequisitionPage"
    x:Name="RootPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:InventoryPOS.Desktop.ViewModels"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid>

        <ScrollViewer>
            <Grid
                Padding="28"
                MaxWidth="1400"
                HorizontalAlignment="Stretch">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- HEADER -->

                <Grid Grid.Row="0">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Button
                        Content="← Back to Purchase Orders"
                        HorizontalAlignment="Left"
                        Padding="12,7"
                        Margin="0,0,0,14"
                        Click="Back_Click"/>

                    <StackPanel
                        Grid.Row="1"
                        Spacing="4">

                        <TextBlock
                            Text="New Purchase Requisition"
                            FontSize="28"
                            FontWeight="SemiBold"/>

                        <TextBlock
                            Text="Prepare a requisition / request for quotation for a supplier."
                            FontSize="13"
                            Opacity="0.65"/>

                    </StackPanel>

                </Grid>

                <!-- ERROR -->

                <InfoBar
                    Grid.Row="1"
                    Margin="0,18,0,0"
                    IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                    Severity="Error"
                    Title="Unable to save requisition"
                    Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"/>

                <!-- GENERAL -->

                <Border
                    Grid.Row="2"
                    Margin="0,20,0,0"
                    Padding="20"
                    CornerRadius="10"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">

                    <StackPanel Spacing="18">

                        <TextBlock
                            Text="Requisition Information"
                            FontSize="18"
                            FontWeight="SemiBold"/>

                        <Grid
                            ColumnSpacing="18"
                            RowSpacing="16">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- SUPPLIER -->

                            <StackPanel Spacing="6">

                                <TextBlock Text="Supplier *"/>

                                <ComboBox
                                    ItemsSource="{x:Bind ViewModel.Suppliers}"
                                    SelectedItem="{x:Bind ViewModel.SelectedSupplier, Mode=TwoWay}"
                                    DisplayMemberPath="Name"
                                    HorizontalAlignment="Stretch"
                                    PlaceholderText="Select supplier"/>

                            </StackPanel>

                            <!-- LOCATION -->

                            <StackPanel
                                Grid.Column="1"
                                Spacing="6">

                                <TextBlock Text="Location *"/>

                                <ComboBox
                                    ItemsSource="{x:Bind ViewModel.Locations}"
                                    SelectedItem="{x:Bind ViewModel.SelectedLocation, Mode=TwoWay}"
                                    DisplayMemberPath="Name"
                                    HorizontalAlignment="Stretch"
                                    PlaceholderText="Select location"/>

                            </StackPanel>

                            <!-- DATE -->

                            <StackPanel
                                Grid.Row="1"
                                Spacing="6">

                                <TextBlock Text="Requisition Date"/>

                                <DatePicker
                                    Date="{x:Bind ViewModel.RequisitionDate, Mode=TwoWay}"
                                    HorizontalAlignment="Stretch"/>

                            </StackPanel>

                            <Grid
                                Grid.Row="1"
                                Grid.Column="1"
                                ColumnSpacing="12">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Spacing="6">

                                    <TextBlock Text="Required By"/>

                                    <CalendarDatePicker
                                        Date="{x:Bind ViewModel.RequiredByDate, Mode=TwoWay}"
                                        PlaceholderText="Optional"
                                        HorizontalAlignment="Stretch"/>

                                </StackPanel>

                                <StackPanel
                                    Grid.Column="1"
                                    Spacing="6">

                                    <TextBlock Text="Valid Until"/>

                                    <CalendarDatePicker
                                        Date="{x:Bind ViewModel.ValidUntilDate, Mode=TwoWay}"
                                        PlaceholderText="Optional"
                                        HorizontalAlignment="Stretch"/>

                                </StackPanel>

                            </Grid>

                            <!-- SUBJECT -->

                            <StackPanel
                                Grid.Row="2"
                                Grid.ColumnSpan="2"
                                Spacing="6">

                                <TextBlock Text="Subject"/>

                                <TextBox
                                    Text="{x:Bind ViewModel.Subject, Mode=TwoWay}"
                                    PlaceholderText="Example: September inventory replenishment"/>

                            </StackPanel>

                            <!-- NOTES -->

                            <StackPanel
                                Grid.Row="3"
                                Grid.ColumnSpan="2"
                                Spacing="6">

                                <TextBlock Text="Notes"/>

                                <TextBox
                                    Text="{x:Bind ViewModel.Notes, Mode=TwoWay}"
                                    AcceptsReturn="True"
                                    TextWrapping="Wrap"
                                    MinHeight="70"
                                    PlaceholderText="Optional notes for the supplier"/>

                            </StackPanel>

                        </Grid>

                    </StackPanel>
                </Border>

                <!-- ITEMS -->

                <Border
                    Grid.Row="3"
                    Margin="0,16,0,0"
                    Padding="20"
                    CornerRadius="10"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">

                    <StackPanel Spacing="16">

                        <Grid>

                            <TextBlock
                                Text="Requested Items"
                                FontSize="18"
                                FontWeight="SemiBold"
                                VerticalAlignment="Center"/>

                            <Button
                                Content="+ Add Item"
                                HorizontalAlignment="Right"
                                Click="AddLine_Click"/>

                        </Grid>

                        <ItemsControl
                            ItemsSource="{x:Bind ViewModel.Lines, Mode=OneWay}">

                            <ItemsControl.ItemTemplate>

                                <DataTemplate
                                    x:DataType="vm:PurchaseRequisitionLineEditViewModel">

                                    <Border
                                        Margin="0,0,0,10"
                                        Padding="14"
                                        CornerRadius="8"
                                        BorderThickness="1"
                                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}">

                                        <StackPanel Spacing="12">

                                            <Grid ColumnSpacing="12">

                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="2.5*"/>
                                                    <ColumnDefinition Width="0.8*"/>
                                                    <ColumnDefinition Width="1.1*"/>
                                                    <ColumnDefinition Width="1*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Spacing="5">

                                                    <TextBlock
                                                        Text="Product *"
                                                        FontSize="12"
                                                        Opacity="0.65"/>

                                                    <ComboBox
                                                        ItemsSource="{Binding ViewModel.Products, ElementName=RootPage}"
                                                        SelectedItem="{x:Bind SelectedProduct, Mode=TwoWay}"
                                                        DisplayMemberPath="DisplayName"
                                                        HorizontalAlignment="Stretch"
                                                        PlaceholderText="Select product"/>

                                                </StackPanel>

                                                <StackPanel
                                                    Grid.Column="1"
                                                    Spacing="5">

                                                    <TextBlock
                                                        Text="Qty *"
                                                        FontSize="12"
                                                        Opacity="0.65"/>

                                                    <NumberBox
                                                        Value="{x:Bind Quantity, Mode=TwoWay}"
                                                        Minimum="0.001"
                                                        SmallChange="1"
                                                        SpinButtonPlacementMode="Compact"/>

                                                </StackPanel>

                                                <StackPanel
                                                    Grid.Column="2"
                                                    Spacing="5">

                                                    <CheckBox
                                                        Content="Estimated cost"
                                                        IsChecked="{x:Bind HasEstimatedCost, Mode=TwoWay}"/>

                                                    <NumberBox
                                                        Value="{x:Bind EstimatedUnitCost, Mode=TwoWay}"
                                                        Minimum="0"
                                                        SmallChange="1"
                                                        SpinButtonPlacementMode="Compact"/>

                                                </StackPanel>

                                                <StackPanel
                                                    Grid.Column="3"
                                                    Spacing="5">

                                                    <TextBlock
                                                        Text="Estimated Total"
                                                        FontSize="12"
                                                        Opacity="0.65"/>

                                                    <TextBlock
                                                        Text="{x:Bind EstimatedLineTotalDisplay, Mode=OneWay}"
                                                        FontWeight="SemiBold"
                                                        VerticalAlignment="Center"
                                                        Margin="0,9,0,0"/>

                                                </StackPanel>

                                                <Button
                                                    Grid.Column="4"
                                                    Content="Remove"
                                                    VerticalAlignment="Bottom"
                                                    Click="RemoveLine_Click"
                                                    Tag="{x:Bind}"/>

                                            </Grid>

                                            <Grid ColumnSpacing="12">

                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBox
                                                    Text="{x:Bind Description, Mode=TwoWay}"
                                                    PlaceholderText="Description / specification"/>

                                                <TextBox
                                                    Grid.Column="1"
                                                    Text="{x:Bind Notes, Mode=TwoWay}"
                                                    PlaceholderText="Line notes"/>

                                            </Grid>

                                        </StackPanel>
                                    </Border>

                                </DataTemplate>

                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                    </StackPanel>
                </Border>

                <!-- FOOTER -->

                <Border
                    Grid.Row="4"
                    Margin="0,16,0,30"
                    Padding="20"
                    CornerRadius="10"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">

                    <StackPanel Spacing="18">

                        <StackPanel Spacing="6">

                            <TextBlock Text="Terms / Request to Supplier"/>

                            <TextBox
                                Text="{x:Bind ViewModel.Terms, Mode=TwoWay}"
                                AcceptsReturn="True"
                                TextWrapping="Wrap"
                                MinHeight="70"/>

                        </StackPanel>

                        <Grid>

                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="8"
                                VerticalAlignment="Center">

                                <TextBlock
                                    Text="Estimated Total:"
                                    FontSize="16"
                                    Opacity="0.7"/>

                                <TextBlock
                                    Text="{x:Bind ViewModel.EstimatedTotalDisplay, Mode=OneWay}"
                                    FontSize="20"
                                    FontWeight="SemiBold"/>

                            </StackPanel>

                            <StackPanel
                                HorizontalAlignment="Right"
                                Orientation="Horizontal"
                                Spacing="10">

                                <Button
                                    Content="Cancel"
                                    Padding="18,10"
                                    Click="Back_Click"/>

                                <Button
                                    Content="Save Requisition"
                                    Padding="18,10"
                                    Click="Save_Click"/>

                            </StackPanel>

                        </Grid>

                    </StackPanel>
                </Border>

            </Grid>
        </ScrollViewer>

        <ProgressRing
            IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
            Width="42"
            Height="42"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"/>

    </Grid>
</Page>