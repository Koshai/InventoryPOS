<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="InventoryPOS.Desktop.Views.InventoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="28"
          RowSpacing="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Header title -->
            <StackPanel
                Grid.Column="0"
                Spacing="4"
                VerticalAlignment="Center">

                <TextBlock
                    Text="Inventory"
                    FontSize="28"
                    FontWeight="SemiBold" />

                <TextBlock
                    Text="View stock levels by product and location."
                    Opacity="0.65" />

            </StackPanel>

            <!-- Header actions -->
            <StackPanel
                Grid.Column="1"
                Orientation="Horizontal"
                Spacing="10"
                VerticalAlignment="Center">

                <Button
                    Content="+ Set Opening Stock"
                    Padding="18,10"
                    Click="SetOpeningStockButton_Click" />

                <Button
                    Content="Adjust Stock"
                    Padding="18,10"
                    Click="AdjustStockButton_Click" />

                <Button
                    Content="Inventory Ledger"
                    Padding="18,10"
                    Click="InventoryLedgerButton_Click" />

            </StackPanel>
        </Grid>

        <!-- Search -->
        <TextBox
            Grid.Row="1"
            Width="320"
            HorizontalAlignment="Left"
            PlaceholderText="Search inventory..."
            Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

        <!-- Inventory table -->
        <ListView
            Grid.Row="2"
            ItemsSource="{Binding FilteredItems}"
            SelectionMode="None"
            HorizontalContentAlignment="Stretch">

            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment"
                            Value="Stretch" />
                    <Setter Property="Padding"
                            Value="0" />
                    <Setter Property="Margin"
                            Value="0" />
                </Style>
            </ListView.ItemContainerStyle>

            <ListView.Header>

                <Grid
                    Padding="12,10"
                    ColumnSpacing="16">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.2*" />
                        <ColumnDefinition Width="1.2*" />
                        <ColumnDefinition Width="1.6*" />
                        <ColumnDefinition Width="0.7*" />
                        <ColumnDefinition Width="0.9*" />
                        <ColumnDefinition Width="0.9*" />
                        <ColumnDefinition Width="1.0*" />
                        <ColumnDefinition Width="0.9*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Product"
                               FontWeight="SemiBold" />

                    <TextBlock Grid.Column="1"
                               Text="SKU"
                               FontWeight="SemiBold" />

                    <TextBlock Grid.Column="2"
                               Text="Location"
                               FontWeight="SemiBold" />

                    <TextBlock Grid.Column="3"
                               Text="Unit"
                               FontWeight="SemiBold" />

                    <TextBlock Grid.Column="4"
                               Text="On Hand"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Right" />

                    <TextBlock Grid.Column="5"
                               Text="Reserved"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Right" />

                    <TextBlock Grid.Column="6"
                               Text="Available"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Right" />

                    <TextBlock Grid.Column="7"
                               Text="Low Stock"
                               FontWeight="SemiBold" />

                </Grid>

            </ListView.Header>

            <ListView.ItemTemplate>

                <DataTemplate>

                    <Grid
                        Padding="12,10"
                        ColumnSpacing="16">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2.2*" />
                            <ColumnDefinition Width="1.2*" />
                            <ColumnDefinition Width="1.6*" />
                            <ColumnDefinition Width="0.7*" />
                            <ColumnDefinition Width="0.9*" />
                            <ColumnDefinition Width="0.9*" />
                            <ColumnDefinition Width="1.0*" />
                            <ColumnDefinition Width="0.9*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Text="{Binding ProductName}"
                            FontWeight="SemiBold"
                            VerticalAlignment="Center"
                            TextTrimming="CharacterEllipsis" />

                        <TextBlock
                            Grid.Column="1"
                            Text="{Binding SKU}"
                            VerticalAlignment="Center"
                            TextTrimming="CharacterEllipsis" />

                        <TextBlock
                            Grid.Column="2"
                            Text="{Binding LocationName}"
                            VerticalAlignment="Center"
                            TextTrimming="CharacterEllipsis" />

                        <TextBlock
                            Grid.Column="3"
                            Text="{Binding UnitSymbol}"
                            VerticalAlignment="Center" />

                        <TextBlock
                            Grid.Column="4"
                            Text="{Binding QuantityOnHand}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center" />

                        <TextBlock
                            Grid.Column="5"
                            Text="{Binding QuantityReserved}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center" />

                        <TextBlock
                            Grid.Column="6"
                            Text="{Binding QuantityAvailable}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            FontWeight="SemiBold" />

                        <TextBlock
                            Grid.Column="7"
                            Text="{Binding IsLowStock}"
                            VerticalAlignment="Center" />

                    </Grid>

                </DataTemplate>

            </ListView.ItemTemplate>

        </ListView>

        <ProgressRing
            Grid.Row="2"
            IsActive="{Binding IsLoading}"
            Width="32"
            Height="32"
            HorizontalAlignment="Center"
            VerticalAlignment="Center" />

    </Grid>

</Page>
