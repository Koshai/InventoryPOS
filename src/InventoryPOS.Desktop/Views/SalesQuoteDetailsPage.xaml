<?xml version="1.0" encoding="utf-8"?>

<Page
    x:Class="InventoryPOS.Desktop.Views.SalesQuoteDetailsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sales="using:InventoryPOS.Application.DTOs.Sales">

    <Grid
        Padding="24"
        Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

        <!-- ================================================= -->
        <!-- CONTENT -->
        <!-- ================================================= -->

        <ScrollViewer
            VerticalScrollMode="Enabled"
            VerticalScrollBarVisibility="Auto">

            <StackPanel
                Spacing="18"
                MaxWidth="1200"
                HorizontalAlignment="Stretch">

                <!-- ========================================= -->
                <!-- HEADER -->
                <!-- ========================================= -->

                <Grid ColumnSpacing="16">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel
                        Grid.Column="0"
                        Spacing="4">

                        <TextBlock
                            Text="Quotation"
                            FontSize="28"
                            FontWeight="SemiBold" />

                        <TextBlock
                            Text="{Binding QuoteNumber}"
                            FontSize="14"
                            Opacity="0.65" />

                    </StackPanel>

                    <StackPanel
                        Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Center">

                        <Button
                            Content="Export PDF"
                            Padding="14,8"
                            Click="ExportPdfButton_Click" />

                        <Button
                            Content="Print"
                            Padding="14,8"
                            Click="PrintButton_Click" />

                        <Border
                            Padding="14,7"
                            CornerRadius="16"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}">

                            <TextBlock
                                Text="{Binding StatusDisplay}"
                                FontSize="12"
                                FontWeight="SemiBold" />

                        </Border>

                    </StackPanel>

                </Grid>

                <Border
                    Padding="12"
                    CornerRadius="10"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Spacing="2">

                            <TextBlock
                                Text="Quotation Workflow"
                                FontSize="13"
                                FontWeight="SemiBold" />

                            <TextBlock
                                Text="Update the quotation as it moves through the sales process."
                                FontSize="11"
                                Opacity="0.60" />

                        </StackPanel>

                        <StackPanel
                            Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="8">

                            <Button
                                Content="Issue Quote"
                                Padding="14,8"
                                Visibility="{Binding CanIssue}"
                                Click="IssueButton_Click" />

                            <Button
                                Content="Accept Quote"
                                Padding="14,8"
                                Visibility="{Binding CanAccept}"
                                Click="AcceptButton_Click" />

                            <Button
                                Content="Mark Expired"
                                Padding="14,8"
                                Visibility="{Binding CanExpire}"
                                Click="ExpireButton_Click" />

                            <Button
                                Content="Cancel Quote"
                                Padding="14,8"
                                Visibility="{Binding CanCancel}"
                                Click="CancelButton_Click" />


                            <Button
                                Content="Load into POS"
                                Padding="16,8"
                                Visibility="{Binding CanLoadIntoPos}"
                                Click="LoadIntoPosButton_Click" />


                        </StackPanel>

                    </Grid>

                </Border>

                <!-- ========================================= -->
                <!-- SUMMARY -->
                <!-- ========================================= -->

                <Border
                    Padding="18"
                    CornerRadius="10"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">

                    <Grid ColumnSpacing="28">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- CUSTOMER -->

                        <StackPanel
                            Grid.Column="0"
                            Spacing="6">

                            <TextBlock
                                Text="Customer"
                                FontSize="11"
                                FontWeight="SemiBold"
                                Opacity="0.60" />

                            <TextBlock
                                Text="{Binding CustomerName}"
                                FontSize="17"
                                FontWeight="SemiBold"
                                TextWrapping="Wrap" />

                            <TextBlock
                                Text="{Binding CustomerPhone}"
                                FontSize="12"
                                Opacity="0.70" />

                            <TextBlock
                                Text="{Binding CustomerEmail}"
                                FontSize="12"
                                Opacity="0.70"
                                TextWrapping="Wrap" />

                        </StackPanel>

                        <!-- QUOTE -->

                        <StackPanel
                            Grid.Column="1"
                            Spacing="6">

                            <TextBlock
                                Text="Quotation Details"
                                FontSize="11"
                                FontWeight="SemiBold"
                                Opacity="0.60" />

                            <TextBlock
                                Text="{Binding FormattedQuoteDate}"
                                FontSize="15"
                                FontWeight="SemiBold" />

                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="5">

                                <TextBlock
                                    Text="Valid until:"
                                    FontSize="12"
                                    Opacity="0.60" />

                                <TextBlock
                                    Text="{Binding FormattedValidUntilDate}"
                                    FontSize="12" />

                            </StackPanel>

                        </StackPanel>

                        <!-- LOCATION -->

                        <StackPanel
                            Grid.Column="2"
                            Spacing="6">

                            <TextBlock
                                Text="Location"
                                FontSize="11"
                                FontWeight="SemiBold"
                                Opacity="0.60" />

                            <TextBlock
                                Text="{Binding LocationName}"
                                FontSize="15"
                                FontWeight="SemiBold" />

                            <TextBlock
                                Text="{Binding LinkedSaleDisplay}"
                                FontSize="11"
                                Opacity="0.65"
                                TextWrapping="Wrap" />

                        </StackPanel>

                    </Grid>

                </Border>

                <!-- ========================================= -->
                <!-- ITEMS -->
                <!-- ========================================= -->

                <Border
                    CornerRadius="10"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">

                    <Grid>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- TABLE HEADER -->

                        <Grid
                            Grid.Row="0"
                            Padding="16,10"
                            ColumnSpacing="12"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="110" />
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                Grid.Column="0"
                                Text="Product"
                                FontSize="11"
                                FontWeight="SemiBold"
                                Opacity="0.65" />

                            <TextBlock
                                Grid.Column="1"
                                Text="Quantity"
                                FontSize="11"
                                FontWeight="SemiBold"
                                Opacity="0.65" />

                            <TextBlock
                                Grid.Column="2"
                                Text="Unit Price"
                                FontSize="11"
                                FontWeight="SemiBold"
                                Opacity="0.65"
                                HorizontalAlignment="Right" />

                            <TextBlock
                                Grid.Column="3"
                                Text="Warranty"
                                FontSize="11"
                                FontWeight="SemiBold"
                                Opacity="0.65" />

                            <TextBlock
                                Grid.Column="4"
                                Text="Total"
                                FontSize="11"
                                FontWeight="SemiBold"
                                Opacity="0.65"
                                HorizontalAlignment="Right" />

                        </Grid>

                        <!-- LINES -->

                        <ItemsControl
                            Grid.Row="1"
                            ItemsSource="{Binding Quote.Lines}">

                            <ItemsControl.ItemTemplate>

                                <DataTemplate
                                    x:DataType="sales:SalesQuoteDetailsLineDto">

                                    <Border
                                        Padding="16,12"
                                        BorderThickness="0,1,0,0"
                                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}">

                                        <Grid ColumnSpacing="12">

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="120" />
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="120" />
                                                <ColumnDefinition Width="110" />
                                            </Grid.ColumnDefinitions>

                                            <!-- PRODUCT -->

                                            <StackPanel
                                                Grid.Column="0"
                                                Spacing="3">

                                                <TextBlock
                                                    Text="{x:Bind ProductName}"
                                                    FontSize="13"
                                                    FontWeight="SemiBold"
                                                    TextTrimming="CharacterEllipsis" />

                                                <StackPanel
                                                    Orientation="Horizontal"
                                                    Spacing="6">

                                                    <TextBlock
                                                        Text="{x:Bind SKU}"
                                                        FontSize="10"
                                                        Opacity="0.55" />

                                                    <TextBlock
                                                        Text="{x:Bind Description}"
                                                        FontSize="10"
                                                        Opacity="0.55"
                                                        TextTrimming="CharacterEllipsis" />

                                                </StackPanel>

                                            </StackPanel>

                                            <!-- QUANTITY -->

                                            <TextBlock
                                                Grid.Column="1"
                                                FontSize="12"
                                                VerticalAlignment="Center">

                                                <Run Text="{x:Bind Quantity}" />
                                                <Run Text=" " />
                                                <Run Text="{x:Bind UnitSymbol}" />

                                            </TextBlock>

                                            <!-- UNIT PRICE -->

                                            <TextBlock
                                                Grid.Column="2"
                                                Text="{x:Bind UnitPrice}"
                                                FontSize="12"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center" />

                                            <!-- WARRANTY -->

                                            <TextBlock
                                                Grid.Column="3"
                                                FontSize="12"
                                                VerticalAlignment="Center">

                                                <Run Text="{x:Bind WarrantyMonths}" />
                                                <Run Text=" months" />

                                            </TextBlock>

                                            <!-- TOTAL -->

                                            <TextBlock
                                                Grid.Column="4"
                                                Text="{x:Bind LineTotal}"
                                                FontSize="13"
                                                FontWeight="SemiBold"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center" />

                                        </Grid>

                                    </Border>

                                </DataTemplate>

                            </ItemsControl.ItemTemplate>

                        </ItemsControl>

                    </Grid>

                </Border>

                <!-- ========================================= -->
                <!-- BOTTOM AREA -->
                <!-- ========================================= -->

                <Grid ColumnSpacing="18">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="340" />
                    </Grid.ColumnDefinitions>

                    <!-- NOTES / TERMS -->

                    <StackPanel
                        Grid.Column="0"
                        Spacing="12">

                        <Border
                            Padding="16"
                            CornerRadius="10"
                            BorderThickness="1"
                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">

                            <StackPanel Spacing="6">

                                <TextBlock
                                    Text="Notes"
                                    FontSize="12"
                                    FontWeight="SemiBold" />

                                <TextBlock
                                    Text="{Binding NotesDisplay}"
                                    FontSize="12"
                                    TextWrapping="Wrap"
                                    Opacity="0.75" />

                            </StackPanel>

                        </Border>

                        <Border
                            Padding="16"
                            CornerRadius="10"
                            BorderThickness="1"
                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">

                            <StackPanel Spacing="6">

                                <TextBlock
                                    Text="Terms"
                                    FontSize="12"
                                    FontWeight="SemiBold" />

                                <TextBlock
                                    Text="{Binding TermsDisplay}"
                                    FontSize="12"
                                    TextWrapping="Wrap"
                                    Opacity="0.75" />

                            </StackPanel>

                        </Border>

                    </StackPanel>

                    <!-- TOTALS -->

                    <Border
                        Grid.Column="1"
                        Padding="18"
                        CornerRadius="10"
                        BorderThickness="1"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        VerticalAlignment="Top">

                        <StackPanel Spacing="12">

                            <TextBlock
                                Text="Quotation Summary"
                                FontSize="16"
                                FontWeight="SemiBold" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    Text="Subtotal"
                                    Opacity="0.65" />

                                <TextBlock
                                    Grid.Column="1"
                                    Text="{Binding FormattedSubtotal}" />
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    Text="Discount"
                                    Opacity="0.65" />

                                <TextBlock
                                    Grid.Column="1"
                                    Text="{Binding FormattedDiscount}" />
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    Text="Tax"
                                    Opacity="0.65" />

                                <TextBlock
                                    Grid.Column="1"
                                    Text="{Binding FormattedTax}" />
                            </Grid>

                            <Border
                                Height="1"
                                Background="{ThemeResource ControlStrokeColorDefaultBrush}" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    Text="Total"
                                    FontSize="15"
                                    FontWeight="SemiBold" />

                                <TextBlock
                                    Grid.Column="1"
                                    Text="{Binding FormattedTotal}"
                                    FontSize="18"
                                    FontWeight="SemiBold" />
                            </Grid>

                        </StackPanel>

                    </Border>

                </Grid>

            </StackPanel>

        </ScrollViewer>

        <!-- ================================================= -->
        <!-- ERROR -->
        <!-- ================================================= -->

        <InfoBar
            x:Name="ErrorInfoBar"
            Severity="Error"
            IsClosable="True"
            IsOpen="False"
            Message="{Binding ErrorMessage}"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Top"
            Margin="0,70,0,0" />

        <!-- ================================================= -->
        <!-- LOADING -->
        <!-- ================================================= -->

        <Grid
            Visibility="{Binding IsLoading}"
            Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="12">

                <ProgressRing
                    Width="28"
                    Height="28"
                    IsActive="{Binding IsLoading}" />

                <TextBlock
                    Text="Loading quotation..."
                    VerticalAlignment="Center" />

            </StackPanel>

        </Grid>

    </Grid>

</Page>