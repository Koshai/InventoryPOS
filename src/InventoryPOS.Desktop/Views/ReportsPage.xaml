<Page
    x:Class="InventoryPOS.Desktop.Views.ReportsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Padding="24">
        <StackPanel Spacing="16" MaxWidth="1000" HorizontalAlignment="Left">
            <TextBlock Text="Reports" FontSize="28" FontWeight="SemiBold"/>
            <TextBlock
                Text="Operational totals derived from posted sales, payments, returns and stock. Profit reports stay unavailable until COGS is recorded on sale lines."
                TextWrapping="Wrap"
                Opacity="0.7"/>

            <InfoBar IsOpen="{Binding HasError}" Severity="Error" Title="Report error" Message="{Binding ErrorMessage}"/>
            <InfoBar IsOpen="{Binding HasSuccess}" Severity="Success" Title="Ready" Message="{Binding SuccessMessage}"/>

            <StackPanel Orientation="Horizontal" Spacing="12">
                <ComboBox Header="Period" Width="160"
                          ItemsSource="{Binding PeriodPresets}"
                          SelectedItem="{Binding SelectedPreset, Mode=TwoWay}"/>
                <ComboBox Header="Location" Width="240"
                          ItemsSource="{Binding Locations}"
                          SelectedItem="{Binding SelectedLocation, Mode=TwoWay}"
                          DisplayMemberPath="Name"/>
            </StackPanel>

            <Border Padding="16" CornerRadius="8" BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="10">
                    <TextBlock Text="Sales summary" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding SalesSummaryText}" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Content="Run sales summary" Click="RunSales_Click"/>
                        <Button Content="Export CSV" Click="ExportSalesCsv_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Padding="16" CornerRadius="8" BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="10">
                    <TextBlock Text="Inventory on hand" FontSize="18" FontWeight="SemiBold"/>
                    <Button Content="Run inventory on hand" Click="RunInventory_Click" HorizontalAlignment="Left"/>
                    <ListView ItemsSource="{Binding InventoryLines}" Height="320" SelectionMode="None">
                        <ListView.Header>
                            <Grid Padding="0,0,0,6" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="90"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="SKU" FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="1" Text="Product" FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="2" Text="Location" FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="3" Text="On hand" FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="4" Text="Available" FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="5" Text="Value" FontWeight="SemiBold"/>
                            </Grid>
                        </ListView.Header>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="90"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Sku}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding ProductName}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="2" Text="{Binding LocationName}"/>
                                    <TextBlock Grid.Column="3" Text="{Binding QuantityOnHand}"/>
                                    <TextBlock Grid.Column="4" Text="{Binding QuantityAvailable}"/>
                                    <TextBlock Grid.Column="5" Text="{Binding LineValueAtCost}"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>

            <ProgressRing IsActive="{Binding IsLoading}" Width="40" Height="40" HorizontalAlignment="Left"/>
        </StackPanel>
    </ScrollViewer>
</Page>
