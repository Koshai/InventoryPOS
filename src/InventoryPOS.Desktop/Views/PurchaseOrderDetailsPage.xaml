<Page
    x:Class="InventoryPOS.Desktop.Views.PurchaseOrderDetailsPage"
    x:Name="PageRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:purchasing="using:InventoryPOS.Application.DTOs.Purchasing"
    mc:Ignorable="d">

    <Grid
        Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

        <!-- ========================================================= -->
        <!-- MAIN CONTENT -->
        <!-- ========================================================= -->

        <ScrollViewer
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Stretch"
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Disabled">

            <StackPanel
                Padding="24"
                Spacing="22"
                HorizontalAlignment="Stretch">

                <!-- ================================================= -->
                <!-- HEADER -->
                <!-- ================================================= -->

                <Grid
                    ColumnSpacing="16">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel
                        Grid.Column="0"
                        Spacing="4"
                        VerticalAlignment="Center">

                        <TextBlock
                            Text="Purchase Order"
                            FontSize="28"
                            FontWeight="SemiBold" />

                        <TextBlock
                            Text="{Binding PurchaseOrder.OrderNumber}"
                            FontSize="16"
                            Opacity="0.65" />

                    </StackPanel>

                    <StackPanel
                        Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="10"
                        VerticalAlignment="Center">

                        <Button
                            Content="Back"
                            Padding="18,9"
                            Click="BackButton_Click" />

                        <Button
                            Content="Receive Goods"
                            Padding="20,9"
                            IsEnabled="{Binding CanReceiveGoods}"
                            Click="ReceiveGoodsButton_Click" />

                    </StackPanel>

                </Grid>


                <!-- ================================================= -->
                <!-- ERROR -->
                <!-- ================================================= -->

                <InfoBar
                    x:Name="ErrorInfoBar"
                    Severity="Error"
                    IsClosable="True"
                    IsOpen="False"
                    Message="{Binding ErrorMessage}" />


                <!-- ================================================= -->
                <!-- SUMMARY CARDS -->
                <!-- ================================================= -->

                <Grid
                    ColumnSpacing="14"
                    RowSpacing="14">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>


                    <!-- Status -->

                    <Border
                        Grid.Row="0"
                        Grid.Column="0"
                        Padding="18"
                        MinHeight="100"
                        CornerRadius="10"
                        BorderThickness="1"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">

                        <StackPanel
                            Spacing="6"
                            VerticalAlignment="Center">

                            <TextBlock
                                Text="Status"
                                FontSize="12"
                                Opacity="0.60" />

                            <TextBlock
                                Text="{Binding StatusDisplay}"
                                FontSize="18"
                                FontWeight="SemiBold"
                                TextWrapping="Wrap" />

                        </StackPanel>

                    </Border>


                    <!-- Supplier -->

                    <Border
                        Grid.Row="0"
                        Grid.Column="1"
                        Padding="18"
                        MinHeight="100"
                        CornerRadius="10"
                        BorderThickness="1"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">

                        <StackPanel
                            Spacing="6"
                            VerticalAlignment="Center">

                            <TextBlock
                                Text="Supplier"
                                FontSize="12"
                                Opacity="0.60" />

                            <TextBlock
                                Text="{Binding PurchaseOrder.SupplierName}"
                                FontSize="16"
                                FontWeight="SemiBold"
                                TextWrapping="Wrap" />

                            <TextBlock
                                Text="{Binding PurchaseOrder.SupplierCode}"
                                FontSize="12"
                                Opacity="0.65" />

                        </StackPanel>

                    </Border>


                    <!-- Location -->

                    <Border
                        Grid.Row="1"
                        Grid.Column="0"
                        Padding="18"
                        MinHeight="100"
                        CornerRadius="10"
                        BorderThickness="1"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">

                        <StackPanel
                            Spacing="6"
                            VerticalAlignment="Center">

                            <TextBlock
                                Text="Location"
                                FontSize="12"
                                Opacity="0.60" />

                            <TextBlock
                                Text="{Binding PurchaseOrder.LocationName}"
                                FontSize="16"
                                FontWeight="SemiBold"
                                TextWrapping="Wrap" />

                        </StackPanel>

                    </Border>


                    <!-- Order Total -->

                    <Border
                        Grid.Row="1"
                        Grid.Column="1"
                        Padding="18"
                        MinHeight="100"
                        CornerRadius="10"
                        BorderThickness="1"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">

                        <StackPanel
                            Spacing="6"
                            VerticalAlignment="Center">

                            <TextBlock
                                Text="Order Total"
                                FontSize="12"
                                Opacity="0.60" />

                            <TextBlock
                                Text="{Binding PurchaseOrder.FormattedTotal}"
                                FontSize="20"
                                FontWeight="SemiBold"
                                TextWrapping="Wrap" />

                        </StackPanel>

                    </Border>

                </Grid>


                <!-- ================================================= -->
                <!-- ORDER INFORMATION -->
                <!-- ================================================= -->

                <Border
                    Padding="22"
                    CornerRadius="10"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">

                    <StackPanel Spacing="18">

                        <StackPanel Spacing="3">

                            <TextBlock
                                Text="Order Information"
                                FontSize="18"
                                FontWeight="SemiBold" />

                            <TextBlock
                                Text="Purchase order dates and additional information"
                                FontSize="12"
                                Opacity="0.60" />

                        </StackPanel>


                        <Grid
                            ColumnSpacing="30"
                            RowSpacing="18">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>


                            <!-- Order Date -->

                            <StackPanel
                                Grid.Row="0"
                                Grid.Column="0"
                                Spacing="4">

                                <TextBlock
                                    Text="Order Date"
                                    FontSize="12"
                                    Opacity="0.60" />

                                <TextBlock
                                    Text="{Binding PurchaseOrder.FormattedOrderDate}"
                                    FontSize="15"
                                    FontWeight="SemiBold" />

                            </StackPanel>


                            <!-- Expected Date -->

                            <StackPanel
                                Grid.Row="0"
                                Grid.Column="1"
                                Spacing="4">

                                <TextBlock
                                    Text="Expected Date"
                                    FontSize="12"
                                    Opacity="0.60" />

                                <TextBlock
                                    Text="{Binding PurchaseOrder.FormattedExpectedDate}"
                                    FontSize="15"
                                    FontWeight="SemiBold" />

                            </StackPanel>


                            <!-- Notes -->

                            <StackPanel
                                Grid.Row="1"
                                Grid.Column="0"
                                Grid.ColumnSpan="2"
                                Spacing="4">

                                <TextBlock
                                    Text="Notes"
                                    FontSize="12"
                                    Opacity="0.60" />

                                <TextBlock
                                    Text="{Binding PurchaseOrder.NotesDisplay}"
                                    TextWrapping="Wrap"
                                    FontSize="15" />

                            </StackPanel>

                        </Grid>

                    </StackPanel>

                </Border>


                <!-- ================================================= -->
                <!-- ORDER ITEMS -->
                <!-- ================================================= -->

                <Border
                    Padding="22"
                    CornerRadius="10"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">

                    <StackPanel Spacing="18">


                        <!-- Section Header -->

                        <StackPanel Spacing="3">

                            <TextBlock
                                Text="Order Items"
                                FontSize="18"
                                FontWeight="SemiBold" />

                            <TextBlock
                                Text="Products included in this purchase order"
                                FontSize="12"
                                Opacity="0.60" />

                        </StackPanel>


                        <!-- Product Cards -->

                        <ItemsControl
                            ItemsSource="{Binding PurchaseOrder.Lines}">

                            <ItemsControl.ItemTemplate>

                                <DataTemplate
                                    x:DataType="purchasing:PurchaseOrderLineDto">

                                    <Border
                                        Padding="16"
                                        Margin="0,0,0,10"
                                        CornerRadius="8"
                                        BorderThickness="1"
                                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}">

                                        <Grid
                                            ColumnSpacing="18"
                                            RowSpacing="14">

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>


                                            <!-- Product Identity -->

                                            <StackPanel
                                                Grid.Row="0"
                                                Grid.Column="0"
                                                Grid.RowSpan="2"
                                                Spacing="5"
                                                VerticalAlignment="Center">

                                                <TextBlock
                                                    Text="{x:Bind ProductName}"
                                                    FontSize="16"
                                                    FontWeight="SemiBold"
                                                    TextWrapping="Wrap" />

                                                <StackPanel
                                                    Orientation="Horizontal"
                                                    Spacing="7">

                                                    <TextBlock
                                                        Text="{x:Bind SKU}"
                                                        FontSize="12"
                                                        Opacity="0.65" />

                                                    <TextBlock
                                                        Text="•"
                                                        FontSize="12"
                                                        Opacity="0.40" />

                                                    <TextBlock
                                                        Text="{x:Bind UnitSymbol}"
                                                        FontSize="12"
                                                        Opacity="0.65" />

                                                </StackPanel>

                                            </StackPanel>


                                            <!-- Ordered -->

                                            <StackPanel
                                                Grid.Row="0"
                                                Grid.Column="1"
                                                Spacing="4">

                                                <TextBlock
                                                    Text="Ordered"
                                                    FontSize="11"
                                                    Opacity="0.60" />

                                                <TextBlock
                                                    Text="{x:Bind OrderedQuantity}"
                                                    FontSize="14"
                                                    FontWeight="SemiBold" />

                                            </StackPanel>


                                            <!-- Received -->

                                            <StackPanel
                                                Grid.Row="0"
                                                Grid.Column="2"
                                                Spacing="4">

                                                <TextBlock
                                                    Text="Received"
                                                    FontSize="11"
                                                    Opacity="0.60" />

                                                <TextBlock
                                                    Text="{x:Bind ReceivedQuantity}"
                                                    FontSize="14"
                                                    FontWeight="SemiBold" />

                                            </StackPanel>


                                            <!-- Remaining -->

                                            <StackPanel
                                                Grid.Row="0"
                                                Grid.Column="3"
                                                Spacing="4">

                                                <TextBlock
                                                    Text="Remaining"
                                                    FontSize="11"
                                                    Opacity="0.60" />

                                                <TextBlock
                                                    Text="{x:Bind RemainingQuantity}"
                                                    FontSize="14"
                                                    FontWeight="SemiBold" />

                                            </StackPanel>


                                            <!-- Unit Cost -->

                                            <StackPanel
                                                Grid.Row="1"
                                                Grid.Column="1"
                                                Spacing="4">

                                                <TextBlock
                                                    Text="Unit Cost"
                                                    FontSize="11"
                                                    Opacity="0.60" />

                                                <TextBlock
                                                    Text="{x:Bind UnitCost}"
                                                    FontSize="14" />

                                            </StackPanel>


                                            <!-- Warranty -->

                                            <StackPanel
                                                Grid.Row="1"
                                                Grid.Column="2"
                                                Spacing="4">

                                                <TextBlock
                                                    Text="Warranty"
                                                    FontSize="11"
                                                    Opacity="0.60" />

                                                <TextBlock
                                                    Text="{x:Bind WarrantyDisplay}"
                                                    FontSize="14" />

                                            </StackPanel>


                                            <!-- Line Total -->

                                            <StackPanel
                                                Grid.Row="1"
                                                Grid.Column="3"
                                                Spacing="4">

                                                <TextBlock
                                                    Text="Line Total"
                                                    FontSize="11"
                                                    Opacity="0.60" />

                                                <TextBlock
                                                    Text="{x:Bind FormattedLineTotal}"
                                                    FontSize="14"
                                                    FontWeight="SemiBold" />

                                            </StackPanel>

                                        </Grid>

                                    </Border>

                                </DataTemplate>

                            </ItemsControl.ItemTemplate>

                        </ItemsControl>


                        <!-- Order Total Divider -->

                        <Border
                            Height="1"
                            Background="{ThemeResource ControlStrokeColorDefaultBrush}" />


                        <!-- Order Total -->

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel
                                Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="14"
                                VerticalAlignment="Center">

                                <TextBlock
                                    Text="Order Total"
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    VerticalAlignment="Center" />

                                <TextBlock
                                    Text="{Binding PurchaseOrder.FormattedTotal}"
                                    FontSize="20"
                                    FontWeight="SemiBold"
                                    VerticalAlignment="Center" />

                            </StackPanel>

                        </Grid>

                    </StackPanel>

                </Border>


                <!-- ================================================= -->
                <!-- GOODS RECEIPTS -->
                <!-- ================================================= -->

                <Border
                    Padding="22"
                    CornerRadius="10"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">

                    <StackPanel Spacing="16">


                        <!-- Header -->

                        <StackPanel Spacing="3">

                            <TextBlock
                                Text="Goods Receipts"
                                FontSize="18"
                                FontWeight="SemiBold" />

                            <TextBlock
                                Text="Receiving history for this purchase order"
                                FontSize="12"
                                Opacity="0.60" />

                        </StackPanel>


                        <!-- Receipt Table Header -->

                        <Grid
                            ColumnSpacing="12"
                            Padding="12,0">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="1.5*" />
                                <ColumnDefinition Width="0.8*" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="1.3*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                Grid.Column="0"
                                Text="Receipt #"
                                FontWeight="SemiBold"
                                FontSize="12" />

                            <TextBlock
                                Grid.Column="1"
                                Text="Date"
                                FontWeight="SemiBold"
                                FontSize="12" />

                            <TextBlock
                                Grid.Column="2"
                                Text="Lines"
                                FontWeight="SemiBold"
                                FontSize="12" />

                            <TextBlock
                                Grid.Column="3"
                                Text="Quantity"
                                FontWeight="SemiBold"
                                FontSize="12" />

                            <TextBlock
                                Grid.Column="4"
                                Text="Value"
                                FontWeight="SemiBold"
                                FontSize="12" />

                        </Grid>


                        <!-- Divider -->

                        <Border
                            Height="1"
                            Background="{ThemeResource ControlStrokeColorDefaultBrush}" />


                        <!-- Receipt Rows -->

                        <ListView
                            ItemsSource="{Binding Receipts}"
                            SelectionMode="None"
                            IsItemClickEnabled="True"
                            ItemClick="Receipt_ItemClick"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch">

                            <ListView.ItemContainerStyle>

                                <Style TargetType="ListViewItem">

                                    <Setter
                                        Property="HorizontalContentAlignment"
                                        Value="Stretch" />

                                    <Setter
                                        Property="Padding"
                                        Value="0" />

                                    <Setter
                                        Property="Margin"
                                        Value="0" />

                                </Style>

                            </ListView.ItemContainerStyle>


                            <ListView.ItemTemplate>

                                <DataTemplate
                                    x:DataType="purchasing:GoodsReceiptListItemDto">

                                    <Grid
                                        ColumnSpacing="12"
                                        Padding="12,12">

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="1.5*" />
                                            <ColumnDefinition Width="0.8*" />
                                            <ColumnDefinition Width="1*" />
                                            <ColumnDefinition Width="1.3*" />
                                        </Grid.ColumnDefinitions>


                                        <!-- Receipt Number -->

                                        <TextBlock
                                            Grid.Column="0"
                                            Text="{x:Bind ReceiptNumber}"
                                            FontWeight="SemiBold"
                                            VerticalAlignment="Center"
                                            TextTrimming="CharacterEllipsis" />


                                        <!-- Date -->

                                        <TextBlock
                                            Grid.Column="1"
                                            Text="{x:Bind FormattedReceiptDate}"
                                            VerticalAlignment="Center" />


                                        <!-- Lines -->

                                        <TextBlock
                                            Grid.Column="2"
                                            Text="{x:Bind LineCount}"
                                            VerticalAlignment="Center" />


                                        <!-- Quantity -->

                                        <TextBlock
                                            Grid.Column="3"
                                            Text="{x:Bind TotalQuantity}"
                                            VerticalAlignment="Center" />


                                        <!-- Value -->

                                        <TextBlock
                                            Grid.Column="4"
                                            Text="{x:Bind FormattedTotalValue}"
                                            FontWeight="SemiBold"
                                            VerticalAlignment="Center" />

                                    </Grid>

                                </DataTemplate>

                            </ListView.ItemTemplate>

                        </ListView>

                    </StackPanel>

                </Border>


                <!-- ================================================= -->
                <!-- BOTTOM SPACING -->
                <!-- ================================================= -->

                <Border Height="20" />

            </StackPanel>

        </ScrollViewer>


        <!-- ========================================================= -->
        <!-- LOADING OVERLAY -->
        <!-- ========================================================= -->

        <Grid
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Visibility="{Binding IsLoading}">

            <Border
                Padding="22"
                CornerRadius="10"
                BorderThickness="1"
                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">

                <StackPanel
                    Orientation="Horizontal"
                    Spacing="12">

                    <ProgressRing
                        Width="28"
                        Height="28"
                        IsActive="{Binding IsLoading}" />

                    <TextBlock
                        Text="Loading purchase order..."
                        VerticalAlignment="Center" />

                </StackPanel>

            </Border>

        </Grid>

    </Grid>

</Page>