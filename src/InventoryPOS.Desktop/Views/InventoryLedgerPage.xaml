<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="InventoryPOS.Desktop.Views.InventoryLedgerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid
        Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- HEADER -->

        <Grid
            Grid.Row="0"
            Margin="28,28,28,16">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel
                Grid.Column="0"
                Spacing="4">

                <TextBlock
                    Text="Inventory Ledger"
                    FontSize="28"
                    FontWeight="SemiBold" />

                <TextBlock
                    Text="Review every inventory movement and stock change."
                    Opacity="0.65" />

            </StackPanel>

            <Button
                Grid.Column="1"
                Content="Back to Inventory"
                Padding="16,9"
                VerticalAlignment="Center"
                Click="BackButton_Click" />

        </Grid>

        <!-- SEARCH -->

        <Grid
            Grid.Row="1"
            Margin="28,0,28,16">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBox
                Grid.Column="0"
                PlaceholderText="Search product, SKU, movement or notes..."
                Text="{Binding SearchText,
                               Mode=TwoWay,
                               UpdateSourceTrigger=PropertyChanged}" />

        </Grid>

        <!-- TABLE -->

        <Border
            Grid.Row="2"
            Margin="28,0,28,28"
            BorderThickness="1"
            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
            CornerRadius="10"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- COLUMN HEADERS -->

                <Grid
                    Grid.Row="0"
                    Padding="16,12"
                    ColumnSpacing="12">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.35*" />
                        <ColumnDefinition Width="1.5*" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="1.2*" />
                        <ColumnDefinition Width="1.3*" />
                        <ColumnDefinition Width="0.8*" />
                        <ColumnDefinition Width="1.2*" />
                        <ColumnDefinition Width="1.5*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="0"
                        Text="Date"
                        FontWeight="SemiBold" />

                    <TextBlock
                        Grid.Column="1"
                        Text="Product"
                        FontWeight="SemiBold" />

                    <TextBlock
                        Grid.Column="2"
                        Text="SKU"
                        FontWeight="SemiBold" />

                    <TextBlock
                        Grid.Column="3"
                        Text="Location"
                        FontWeight="SemiBold" />

                    <TextBlock
                        Grid.Column="4"
                        Text="Movement"
                        FontWeight="SemiBold" />

                    <TextBlock
                        Grid.Column="5"
                        Text="Qty"
                        FontWeight="SemiBold" />

                    <TextBlock
                        Grid.Column="6"
                        Text="Reference"
                        FontWeight="SemiBold" />

                    <TextBlock
                        Grid.Column="7"
                        Text="Notes"
                        FontWeight="SemiBold" />

                </Grid>

                <!-- MOVEMENTS -->

                <ListView
                    x:Name="LedgerListView"
                    Grid.Row="1"
                    ItemsSource="{Binding FilteredItems}"
                    HorizontalContentAlignment="Stretch"
                    SelectionMode="Single"
                    IsItemClickEnabled="True"
                    ItemClick="LedgerListView_ItemClick">

                    <ListView.ItemTemplate>

                        <DataTemplate>

                            <Grid
                                Padding="16,12"
                                ColumnSpacing="12">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.35*" />
                                    <ColumnDefinition Width="1.5*" />
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="1.2*" />
                                    <ColumnDefinition Width="1.3*" />
                                    <ColumnDefinition Width="0.8*" />
                                    <ColumnDefinition Width="1.2*" />
                                    <ColumnDefinition Width="1.5*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    Grid.Column="0"
                                    Text="{Binding FormattedDate}"
                                    TextWrapping="Wrap" />

                                <StackPanel
                                    Grid.Column="1"
                                    Spacing="2">

                                    <TextBlock
                                        Text="{Binding ProductName}"
                                        FontWeight="SemiBold"
                                        TextTrimming="CharacterEllipsis" />

                                    <TextBlock
                                        Text="{Binding UnitSymbol}"
                                        FontSize="12"
                                        Opacity="0.6" />

                                </StackPanel>

                                <TextBlock
                                    Grid.Column="2"
                                    Text="{Binding SKU}"
                                    VerticalAlignment="Center" />

                                <TextBlock
                                    Grid.Column="3"
                                    Text="{Binding LocationName}"
                                    VerticalAlignment="Center"
                                    TextTrimming="CharacterEllipsis" />

                                <TextBlock
                                    Grid.Column="4"
                                    Text="{Binding MovementType}"
                                    VerticalAlignment="Center"
                                    TextWrapping="Wrap" />

                                <TextBlock
                                    Grid.Column="5"
                                    Text="{Binding FormattedQuantity}"
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold" />

                                <TextBlock
                                    Grid.Column="6"
                                    Text="{Binding ReferenceDisplay}"
                                    VerticalAlignment="Center"
                                    TextWrapping="Wrap" />

                                <TextBlock
                                    Grid.Column="7"
                                    Text="{Binding Notes}"
                                    VerticalAlignment="Center"
                                    TextWrapping="Wrap"
                                    MaxLines="2"
                                    TextTrimming="CharacterEllipsis" />

                            </Grid>

                        </DataTemplate>

                    </ListView.ItemTemplate>

                </ListView>

            </Grid>

        </Border>

        <ProgressRing
            Grid.RowSpan="3"
            Width="40"
            Height="40"
            IsActive="{Binding IsLoading}"
            Visibility="{Binding IsLoading}"
            HorizontalAlignment="Center"
            VerticalAlignment="Center" />

    </Grid>

</Page>