<Page
    x:Class="InventoryPOS.Desktop.Views.ProductDetailsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

        <ScrollViewer
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Disabled">

            <StackPanel
                Padding="28"
                Spacing="28">

                <!-- ========================================= -->
                <!-- BACK BUTTON -->
                <!-- ========================================= -->

                <Button
                    Content="← Products"
                    HorizontalAlignment="Left"
                    Click="BackButton_Click" />

                <!-- ========================================= -->
                <!-- PRODUCT HEADER -->
                <!-- ========================================= -->

                <Grid ColumnSpacing="28">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- TITLE -->

                    <StackPanel
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Spacing="6">

                        <TextBlock
                            Text="{Binding Product.Name}"
                            FontSize="30"
                            FontWeight="SemiBold"
                            TextWrapping="Wrap" />

                        <TextBlock
                            Text="{Binding Product.NameBn}"
                            FontSize="18"
                            Opacity="0.65"
                            TextWrapping="Wrap" />

                    </StackPanel>

                    <!-- PRODUCT IMAGE -->

                    <Border
                        Grid.Column="1"
                        Width="220"
                        Height="220"
                        HorizontalAlignment="Center"
                        CornerRadius="10"
                        BorderThickness="1"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">

                        <Image
                            x:Name="ProductImage"
                            Stretch="Uniform" />

                    </Border>

                    <!-- EDIT BUTTON -->

                    <Button
                        Grid.Column="2"
                        Content="Edit Product"
                        VerticalAlignment="Center"
                        Margin="8,0,0,0"
                        Click="EditProductButton_Click" />

                </Grid>

                <!-- ========================================= -->
                <!-- GENERAL INFORMATION -->
                <!-- ========================================= -->

                <StackPanel Spacing="14">

                    <TextBlock
                        Text="General Information"
                        FontSize="20"
                        FontWeight="SemiBold" />

                    <Border
                        Padding="20"
                        CornerRadius="10"
                        BorderThickness="1"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">

                        <StackPanel Spacing="20">

                            <!-- CATEGORY / BRAND / UNIT -->

                            <Grid ColumnSpacing="40">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- CATEGORY -->

                                <StackPanel
                                    Grid.Column="0"
                                    Spacing="4">

                                    <TextBlock
                                        Text="Category"
                                        Opacity="0.65" />

                                    <TextBlock
                                        Text="{Binding Product.CategoryName}"
                                        FontWeight="SemiBold" />

                                </StackPanel>

                                <!-- BRAND -->

                                <StackPanel
                                    Grid.Column="1"
                                    Spacing="4">

                                    <TextBlock
                                        Text="Brand"
                                        Opacity="0.65" />

                                    <TextBlock
                                        Text="{Binding Product.BrandName}"
                                        FontWeight="SemiBold" />

                                </StackPanel>

                                <!-- UNIT -->

                                <StackPanel
                                    Grid.Column="2"
                                    Spacing="4">

                                    <TextBlock
                                        Text="Unit"
                                        Opacity="0.65" />

                                    <TextBlock
                                        Text="{Binding Product.UnitName}"
                                        FontWeight="SemiBold" />

                                </StackPanel>

                            </Grid>

                            <!-- DESCRIPTION -->

                            <StackPanel Spacing="4">

                                <TextBlock
                                    Text="Description"
                                    Opacity="0.65" />

                                <TextBlock
                                    Text="{Binding Product.Description}"
                                    TextWrapping="Wrap" />

                            </StackPanel>

                        </StackPanel>

                    </Border>

                </StackPanel>

                <!-- ========================================= -->
                <!-- VARIANTS -->
                <!-- ========================================= -->

                <StackPanel Spacing="12">

                    <TextBlock
                        Text="Variants"
                        FontSize="20"
                        FontWeight="SemiBold" />

                    <!-- HEADER -->

                    <Border
                        Padding="12,10">

                        <Grid ColumnSpacing="20">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.4*" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="0.8*" />
                                <ColumnDefinition Width="110" />
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                Grid.Column="0"
                                Text="SKU"
                                FontWeight="SemiBold" />

                            <TextBlock
                                Grid.Column="1"
                                Text="Cost"
                                FontWeight="SemiBold"
                                HorizontalAlignment="Right" />

                            <TextBlock
                                Grid.Column="2"
                                Text="Selling Price"
                                FontWeight="SemiBold"
                                HorizontalAlignment="Right" />

                            <TextBlock
                                Grid.Column="3"
                                Text="Reorder Level"
                                FontWeight="SemiBold"
                                HorizontalAlignment="Right" />

                            <TextBlock
                                Grid.Column="4"
                                Text="Status"
                                FontWeight="SemiBold"
                                HorizontalAlignment="Center" />

                            <TextBlock
                                Grid.Column="5"
                                Text="Barcodes"
                                FontWeight="SemiBold"
                                HorizontalAlignment="Center" />

                        </Grid>

                    </Border>

                    <!-- ROWS -->

                    <ListView
                        ItemsSource="{Binding Product.Variants}"
                        SelectionMode="None"
                        HorizontalContentAlignment="Stretch">

                        <ListView.ItemContainerStyle>

                            <Style TargetType="ListViewItem">

                                <Setter
                                    Property="HorizontalContentAlignment"
                                    Value="Stretch" />

                                <Setter
                                    Property="Padding"
                                    Value="0" />

                                <Setter
                                    Property="Margin"
                                    Value="0" />

                            </Style>

                        </ListView.ItemContainerStyle>

                        <ListView.ItemTemplate>

                            <DataTemplate>

                                <Border
                                    Padding="12"
                                    Margin="0,0,0,4"
                                    CornerRadius="6"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">

                                    <Grid ColumnSpacing="20">

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.4*" />
                                            <ColumnDefinition Width="1*" />
                                            <ColumnDefinition Width="1*" />
                                            <ColumnDefinition Width="1*" />
                                            <ColumnDefinition Width="0.8*" />
                                            <ColumnDefinition Width="110" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock
                                            Grid.Column="0"
                                            Text="{Binding SKU}"
                                            VerticalAlignment="Center" />

                                        <TextBlock
                                            Grid.Column="1"
                                            Text="{Binding CostPrice}"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center" />

                                        <TextBlock
                                            Grid.Column="2"
                                            Text="{Binding SellingPrice}"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center" />

                                        <TextBlock
                                            Grid.Column="3"
                                            Text="{Binding ReorderLevel}"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center" />

                                        <TextBlock
                                            Grid.Column="4"
                                            Text="{Binding IsActive}"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center" />

                                        <Button
                                            Grid.Column="5"
                                            Content="Manage"
                                            Tag="{Binding}"
                                            Padding="12,5"
                                            HorizontalAlignment="Center"
                                            Click="ManageBarcodesButton_Click" />

                                    </Grid>

                                </Border>

                            </DataTemplate>

                        </ListView.ItemTemplate>

                    </ListView>

                </StackPanel>

                <!-- ERROR -->

                <InfoBar
                    Severity="Error"
                    IsOpen="False"
                    Message="{Binding ErrorMessage}" />

            </StackPanel>

        </ScrollViewer>

        <ContentDialog
    x:Name="BarcodeDialog"
    Title="Product Barcodes"
    PrimaryButtonText="Add Barcode"
    CloseButtonText="Close"
    DefaultButton="Primary"
    PrimaryButtonClick="BarcodeDialog_PrimaryButtonClick">

            <StackPanel
        Width="520"
        Spacing="16">

                <StackPanel Spacing="3">

                    <TextBlock
                Text="Variant"
                FontSize="12"
                Opacity="0.65" />

                    <TextBlock
                Text="{Binding SelectedVariantSku}"
                FontSize="16"
                FontWeight="SemiBold" />

                </StackPanel>

                <Grid ColumnSpacing="10">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="150" />
                    </Grid.ColumnDefinitions>

                    <TextBox
                x:Name="BarcodeValueTextBox"
                Grid.Column="0"
                Header="Barcode"
                PlaceholderText="Scan or enter barcode" />

                    <ComboBox
                x:Name="BarcodeTypeComboBox"
                Grid.Column="1"
                Header="Type"
                SelectedIndex="0">

                        <ComboBoxItem Content="EAN-13" Tag="Ean13" />
                        <ComboBoxItem Content="UPC-A" Tag="UpcA" />
                        <ComboBoxItem Content="Code 128" Tag="Code128" />
                        <ComboBoxItem Content="Other" Tag="Other" />

                    </ComboBox>

                </Grid>

                <CheckBox
            x:Name="PrimaryBarcodeCheckBox"
            Content="Primary barcode" />

                <InfoBar
            x:Name="BarcodeErrorInfoBar"
            Severity="Error"
            IsOpen="False"
            IsClosable="True" />

                <!-- ========================================= -->
                <!-- LABEL PRINT OPTIONS -->
                <!-- ========================================= -->

                <Border
    Padding="12"
    CornerRadius="8"
    BorderThickness="1"
    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
    Background="{ThemeResource SubtleFillColorSecondaryBrush}">

                    <StackPanel Spacing="10">

                        <TextBlock
            Text="Label Print Options"
            FontWeight="SemiBold" />

                        <Grid ColumnSpacing="16">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <NumberBox
                x:Name="LabelCopiesNumberBox"
                Grid.Column="0"
                Header="Copies"
                Minimum="1"
                Maximum="500"
                Value="1"
                SmallChange="1"
                SpinButtonPlacementMode="Compact" />

                            <StackPanel
                Grid.Column="1"
                VerticalAlignment="Bottom"
                Spacing="4">

                                <CheckBox
                    x:Name="LabelShowPriceCheckBox"
                    Content="Show selling price"
                    IsChecked="True" />

                                <CheckBox
                    x:Name="LabelShowSkuCheckBox"
                    Content="Show SKU"
                    IsChecked="True" />

                            </StackPanel>

                        </Grid>

                        <TextBlock
            Text="These options apply when you click Print Label below."
            FontSize="11"
            Opacity="0.65"
            TextWrapping="Wrap" />

                    </StackPanel>

                </Border>

                <TextBlock
            Text="Assigned barcodes"
            Margin="0,6,0,0"
            FontWeight="SemiBold" />

                <ListView
    ItemsSource="{Binding Barcodes}"
    MaxHeight="240"
    SelectionMode="None"
    HorizontalContentAlignment="Stretch">

                    <ListView.ItemContainerStyle>

                        <Style TargetType="ListViewItem">

                            <Setter
                Property="HorizontalContentAlignment"
                Value="Stretch" />

                        </Style>

                    </ListView.ItemContainerStyle>

                    <ListView.ItemTemplate>

                        <DataTemplate>

                            <Grid
                Padding="4,8"
                ColumnSpacing="12">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- BARCODE -->

                                <TextBlock
                    Grid.Column="0"
                    Text="{Binding Value}"
                    VerticalAlignment="Center"
                    FontFamily="Consolas"
                    TextTrimming="CharacterEllipsis" />

                                <!-- TYPE -->

                                <TextBlock
                    Grid.Column="1"
                    Text="{Binding Type}"
                    VerticalAlignment="Center" />

                                <!-- PRIMARY -->

                                <TextBlock
                    Grid.Column="2"
                    Text="{Binding IsPrimary}"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center" />

                                <!-- PRINT LABEL -->

                                <Button
                    Grid.Column="3"
                    Content="Print Label"
                    Tag="{Binding}"
                    Padding="10,5"
                    VerticalAlignment="Center"
                    ToolTipService.ToolTip="Generate printable barcode label"
                    Click="PrintBarcodeLabelButton_Click" />

                                <!-- REMOVE -->

                                <Button
                    Grid.Column="4"
                    Content="Remove"
                    Tag="{Binding}"
                    Padding="10,5"
                    VerticalAlignment="Center"
                    Click="RemoveBarcodeButton_Click" />

                            </Grid>

                        </DataTemplate>

                    </ListView.ItemTemplate>

                </ListView>

            </StackPanel>

        </ContentDialog>

        <ProgressRing
            Width="40"
            Height="40"
            IsActive="{Binding IsLoading}"
            Visibility="{Binding IsLoading}"
            HorizontalAlignment="Center"
            VerticalAlignment="Center" />

    </Grid>

</Page>