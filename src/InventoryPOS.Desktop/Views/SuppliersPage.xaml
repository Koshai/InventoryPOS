<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="InventoryPOS.Desktop.Views.SuppliersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid
        Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            Grid.Row="0"
            Margin="28,28,28,16">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel
                Grid.Column="0"
                Spacing="4">

                <TextBlock
                    Text="Suppliers"
                    FontSize="28"
                    FontWeight="SemiBold" />

                <TextBlock
                    Text="Manage supplier profiles and purchasing contacts."
                    Opacity="0.65" />

            </StackPanel>

            <Button
                Grid.Column="1"
                Content="+ Add Supplier"
                Padding="18,10"
                Click="AddSupplierButton_Click" />

        </Grid>

        <TextBox
            Grid.Row="1"
            Width="360"
            Margin="28,0,28,16"
            HorizontalAlignment="Left"
            PlaceholderText="Search supplier, code, contact or phone..."
            Text="{Binding SearchText,
                           Mode=TwoWay,
                           UpdateSourceTrigger=PropertyChanged}" />

        <Border
            Grid.Row="2"
            Margin="28,0,28,28"
            BorderThickness="1"
            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
            CornerRadius="10"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid
                    Grid.Row="0"
                    Padding="16,12"
                    ColumnSpacing="12">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="1.5*" />
                        <ColumnDefinition Width="1.3*" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Code" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1" Text="Supplier" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="2" Text="Contact" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="3" Text="Phone" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="4" Text="Email" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="5" Text="Status" FontWeight="SemiBold" />

                </Grid>

                <ListView
                    x:Name="SuppliersListView"
                    Grid.Row="1"
                    ItemsSource="{Binding FilteredSuppliers}"
                    HorizontalContentAlignment="Stretch"
                    SelectionMode="Single"
                    IsItemClickEnabled="True"
                    ItemClick="SuppliersListView_ItemClick">

                    <ListView.ItemTemplate>
                        <DataTemplate>

                            <Grid
                                Padding="16,12"
                                ColumnSpacing="12">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="1.5*" />
                                    <ColumnDefinition Width="1.3*" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="1*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    Grid.Column="0"
                                    Text="{Binding SupplierCode}" />

                                <TextBlock
                                    Grid.Column="1"
                                    Text="{Binding Name}"
                                    FontWeight="SemiBold"
                                    TextTrimming="CharacterEllipsis" />

                                <TextBlock
                                    Grid.Column="2"
                                    Text="{Binding ContactPerson}"
                                    TextTrimming="CharacterEllipsis" />

                                <TextBlock
                                    Grid.Column="3"
                                    Text="{Binding Phone}" />

                                <TextBlock
                                    Grid.Column="4"
                                    Text="{Binding Email}"
                                    TextTrimming="CharacterEllipsis" />

                                <TextBlock
                                    Grid.Column="5"
                                    Text="{Binding StatusText}" />

                            </Grid>

                        </DataTemplate>
                    </ListView.ItemTemplate>

                </ListView>

            </Grid>

        </Border>

        <ProgressRing
            Grid.RowSpan="3"
            Width="40"
            Height="40"
            IsActive="{Binding IsLoading}"
            Visibility="{Binding IsLoading}"
            HorizontalAlignment="Center"
            VerticalAlignment="Center" />

    </Grid>

</Page>