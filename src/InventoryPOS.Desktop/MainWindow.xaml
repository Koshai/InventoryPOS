<Window
    x:Class="InventoryPOS.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <NavigationView
        x:Name="MainNavigation"
        PaneDisplayMode="Left"
        IsBackButtonVisible="Collapsed"
        SelectionChanged="MainNavigation_SelectionChanged">

        <NavigationView.MenuItems>

            <NavigationViewItem
                Content="Dashboard"
                Tag="dashboard">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Home" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>

            <NavigationViewItem
                Content="POS"
                Tag="pos">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Shop" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>

            <NavigationViewItem
                Content="Sales"
                Tag="Sales">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Document" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>

            <NavigationViewItem
                Content="Quotations"
                Tag="Quotations">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Document" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>

            <NavigationViewItem
                Content="Warranty Lookup"
                Tag="Warranties">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Find" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>

            <NavigationViewItem
                Content="Warranty Claims"
                Tag="WarrantyClaims">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Document" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>

            <NavigationViewItem
                Content="Products"
                Tag="products">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="AllApps" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>

            <NavigationViewItem
                Content="Inventory"
                Tag="inventory">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Library" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>

            <NavigationViewItem
                Content="Purchases"
                Tag="purchases">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Shop" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>

            <NavigationViewItem
                Content="Suppliers"
                Tag="suppliers">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Contact" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>

            <NavigationViewItem
                Content="Customers"
                Tag="customers">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="People" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>

            <NavigationViewItem
                Content="Reports"
                Tag="reports">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Document" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>

            <NavigationViewItem
                Content="Licensing"
                Tag="licensing">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Permissions"/>
                </NavigationViewItem.Icon>
            </NavigationViewItem>

        </NavigationView.MenuItems>

        <!-- CONTENT AREA -->
        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- GLOBAL SCANNER -->
            <Grid
                Grid.Row="0"
                Margin="20,8,20,8">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox
                    x:Name="GlobalScanBox"
                    Grid.Column="1"
                    Width="280"
                    Margin="0,0,8,0"
                    VerticalAlignment="Center"
                    PlaceholderText="Scan document QR or barcode..."
                    KeyDown="GlobalScanBox_KeyDown" />

                <Button
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Content="Open"
                    Click="OpenScan_Click" />

            </Grid>

            <!-- PAGE NAVIGATION -->
            <Frame
                x:Name="ContentFrame"
                Grid.Row="1" />

        </Grid>

    </NavigationView>

</Window>