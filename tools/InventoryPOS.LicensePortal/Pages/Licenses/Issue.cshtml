@page
@model InventoryPOS.LicensePortal.Pages.Licenses.IssueModel
@{
    ViewData["Title"] = "Issue license";
}

<h1>Issue / renew license</h1>
<p class="text-muted">Creates a schema-2 RSA-signed <code>.iposlic</code> bound to email + Installation ID (same format as License Manager).</p>

@if (!Model.HasKeys)
{
    <div class="alert alert-warning">Signing keys are missing. Mount keys before issuing.</div>
}

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

<form method="post" class="col-lg-7">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Input.Email" class="form-label"></label>
        <input asp-for="Input.Email" class="form-control" />
        <span asp-validation-for="Input.Email" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Input.DisplayName" class="form-label"></label>
        <input asp-for="Input.DisplayName" class="form-control" />
        <span asp-validation-for="Input.DisplayName" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Input.InstallationId" class="form-label"></label>
        <input asp-for="Input.InstallationId" class="form-control" />
        <span asp-validation-for="Input.InstallationId" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Input.Days" class="form-label"></label>
        <input asp-for="Input.Days" class="form-control" type="number" min="1" max="3650" />
        <span asp-validation-for="Input.Days" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Input.Notes" class="form-label"></label>
        <textarea asp-for="Input.Notes" class="form-control" rows="2"></textarea>
    </div>
    <button type="submit" class="btn btn-primary" disabled="@(!Model.HasKeys)">Issue and download</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
