<Window x:Class="InventoryPOS.LicenseManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="InventoryPOS License Manager"
        Height="720"
        Width="1100"
        MinHeight="560"
        MinWidth="900"
        WindowStartupLocation="CenterScreen">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <DockPanel Grid.Row="0" Margin="0,0,0,12">
      <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
        <Button x:Name="GenerateKeysButton" Content="Generate signing keys" Margin="0,0,8,0" Padding="12,6" Click="GenerateKeys_Click"/>
        <Button x:Name="VerifyButton" Content="Verify license file..." Padding="12,6" Click="Verify_Click"/>
      </StackPanel>
      <StackPanel>
        <TextBlock Text="License Manager" FontSize="24" FontWeight="SemiBold"/>
        <TextBlock x:Name="KeysStatusText" TextWrapping="Wrap" Opacity="0.75" Margin="0,4,0,0"/>
      </StackPanel>
    </DockPanel>

    <Border Grid.Row="1" Padding="12" Margin="0,0,0,12" BorderBrush="#DDD" BorderThickness="1" CornerRadius="6" Background="#FAFAFA">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="2*"/>
          <ColumnDefinition Width="2*"/>
          <ColumnDefinition Width="2.5*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Customer email" FontWeight="SemiBold" Margin="0,0,8,4"/>
        <TextBlock Grid.Row="0" Grid.Column="1" Text="Display name" FontWeight="SemiBold" Margin="0,0,8,4"/>
        <TextBlock Grid.Row="0" Grid.Column="2" Text="Installation ID" FontWeight="SemiBold" Margin="0,0,8,4"/>
        <TextBlock Grid.Row="0" Grid.Column="3" Text="Days" FontWeight="SemiBold" Margin="0,0,8,4"/>

        <TextBox x:Name="EmailBox" Grid.Row="1" Grid.Column="0" Margin="0,0,8,0" Padding="6"/>
        <TextBox x:Name="NameBox" Grid.Row="1" Grid.Column="1" Margin="0,0,8,0" Padding="6"/>
        <TextBox x:Name="InstallationIdBox" Grid.Row="1" Grid.Column="2" Margin="0,0,8,0" Padding="6"/>
        <TextBox x:Name="DaysBox" Grid.Row="1" Grid.Column="3" Width="70" Margin="0,0,8,0" Padding="6" Text="90"/>
        <Button Grid.Row="1" Grid.Column="4" Content="Issue / Renew license" Padding="14,6" Click="Issue_Click"/>
      </Grid>
    </Border>

    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1.2*"/>
        <ColumnDefinition Width="16"/>
        <ColumnDefinition Width="1.8*"/>
      </Grid.ColumnDefinitions>

      <DockPanel Grid.Column="0">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
          <TextBlock Text="Customers" FontWeight="SemiBold" Margin="0,0,0,6"/>
          <DockPanel>
            <Button DockPanel.Dock="Right" Content="Search" Width="80" Margin="8,0,0,0" Click="Search_Click"/>
            <TextBox x:Name="SearchBox" Padding="6"/>
          </DockPanel>
        </StackPanel>
        <ListBox x:Name="CustomerList"
                 DisplayMemberPath="Email"
                 SelectionChanged="CustomerList_SelectionChanged"/>
      </DockPanel>

      <Grid Grid.Column="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="*"/>
          <RowDefinition Height="12"/>
          <RowDefinition Height="0.9*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0">
          <TextBlock DockPanel.Dock="Top" Text="Machines for selected customer" FontWeight="SemiBold" Margin="0,0,0,6"/>
          <DataGrid x:Name="MachineGrid"
                    AutoGenerateColumns="False"
                    IsReadOnly="True"
                    SelectionMode="Single"
                    CanUserAddRows="False"
                    SelectionChanged="MachineGrid_SelectionChanged">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Installation ID" Binding="{Binding InstallationId}" Width="*"/>
              <DataGridTextColumn Header="Edition" Binding="{Binding Edition}" Width="80"/>
              <DataGridTextColumn Header="Expires (UTC)" Binding="{Binding ExpiresAtUtc, StringFormat={}{0:yyyy-MM-dd}}" Width="110"/>
              <DataGridTextColumn Header="License file" Binding="{Binding LastIssuedFilePath}" Width="2*"/>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>

        <DockPanel Grid.Row="2">
          <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
              <Button Content="Open folder" Margin="0,0,8,0" Padding="10,4" Click="OpenFolder_Click"/>
              <Button Content="Copy path" Padding="10,4" Click="CopyPath_Click"/>
            </StackPanel>
            <TextBlock Text="Issue history" FontWeight="SemiBold" VerticalAlignment="Center"/>
          </DockPanel>
          <DataGrid x:Name="HistoryGrid"
                    AutoGenerateColumns="False"
                    IsReadOnly="True"
                    CanUserAddRows="False">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Issued (UTC)" Binding="{Binding IssuedAtUtc, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="140"/>
              <DataGridTextColumn Header="Expires (UTC)" Binding="{Binding ExpiresAtUtc, StringFormat={}{0:yyyy-MM-dd}}" Width="110"/>
              <DataGridTextColumn Header="File" Binding="{Binding FilePath}" Width="*"/>
              <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="140"/>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </Grid>
    </Grid>

    <TextBlock x:Name="StatusText" Grid.Row="3" Margin="0,12,0,0" TextWrapping="Wrap"/>
  </Grid>
</Window>
