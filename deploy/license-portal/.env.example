# Copy to .env and fill in before docker compose up.
# Never commit .env or private-key.pem.

# --- With a real domain (HTTPS via Let's Encrypt) ---
# PORTAL_DOMAIN=licenses.example.com
# PUBLIC_BASE_URL=https://licenses.example.com
# Keep the default Caddyfile (uses {$PORTAL_DOMAIN}).

# --- No domain yet (Linode public IP, HTTP only) ---
# 1) cp Caddyfile.ip Caddyfile
# 2) set PUBLIC_BASE_URL to http://YOUR_PUBLIC_IP  (must match what browsers/Desktop use)
PORTAL_DOMAIN=unused.local
PUBLIC_BASE_URL=http://203.0.113.10

POSTGRES_PASSWORD=change-me-to-a-long-random-string

BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe!Portal1

# Place signing keys at:
#   deploy/license-portal/data/keys/private-key.pem
#   deploy/license-portal/data/keys/public-key.pem
# chmod 600 the private key on the host.
